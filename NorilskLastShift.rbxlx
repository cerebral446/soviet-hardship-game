<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="ClockTime">23.4</float><float name="Brightness">0.4</float></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000007"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000006"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[-- Small helpers for building the world out of parts.

local CollectionService = game:GetService("CollectionService")

local Build = {}

function Build.rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function toCFrame(at)
	if typeof(at) == "Vector3" then
		return CFrame.new(at)
	end
	return at
end

local function setup(p, parent, name, size, at, color, material)
	p.Name = name
	p.Size = size
	p.CFrame = toCFrame(at)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color or Color3.fromRGB(120, 120, 118)
	p.Material = material or Enum.Material.Concrete
	p.Parent = parent
	return p
end

function Build.block(parent, name, size, at, color, material)
	return setup(Instance.new("Part"), parent, name, size, at, color, material)
end

function Build.wedge(parent, name, size, at, color, material)
	return setup(Instance.new("WedgePart"), parent, name, size, at, color, material)
end

-- A cylinder whose axis runs along the CFrame's X axis.
function Build.cylinder(parent, name, length, diameter, at, color, material)
	local p = setup(Instance.new("Part"), parent, name, Vector3.new(length, diameter, diameter), at, color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A cylinder standing upright, base at `base`.
function Build.column(parent, name, height, diameter, base, color, material)
	return Build.cylinder(parent, name, height, diameter, CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, material)
end

-- CFrame at `from` looking at `to`; safe when the direction is straight up or down.
function Build.look(from, to)
	local dir = to - from
	if dir.Magnitude > 0 and math.abs(dir.Unit.Y) > 0.99 then
		-- Straight up or down: lookAt would be degenerate, so tip the Z axis explicitly.
		return CFrame.new(from) * CFrame.Angles(dir.Y > 0 and math.pi / 2 or -math.pi / 2, 0, 0)
	end
	return CFrame.lookAt(from, to)
end

-- A cylinder between two points.
function Build.pipe(parent, name, a, b, diameter, color, material)
	local length = (b - a).Magnitude
	local cf = Build.look((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
	return Build.cylinder(parent, name, length, diameter, cf, color, material)
end

-- A block stretched between two points (beams, cables, rails).
function Build.beam(parent, name, a, b, thickness, color, material)
	local length = (b - a).Magnitude
	return Build.block(parent, name, Vector3.new(thickness, thickness, length), Build.look((a + b) / 2, b), color, material)
end

function Build.ball(parent, name, diameter, at, color, material)
	local p = setup(Instance.new("Part"), parent, name, Vector3.new(diameter, diameter, diameter), at, color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Decorative: no collisions, no shadow, ignored by raycasts.
function Build.detail(p)
	p.CanCollide = false
	p.CastShadow = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

function Build.tag(instance, tag)
	CollectionService:AddTag(instance, tag)
	return instance
end

function Build.light(parent, color, range, brightness, shadows)
	local l = Instance.new("PointLight")
	l.Color = color or Color3.fromRGB(255, 190, 120)
	l.Range = range or 16
	l.Brightness = brightness or 1
	l.Shadows = shadows or false
	l.Parent = parent
	return l
end

function Build.surfaceLight(parent, face, color, range, brightness, angle)
	local l = Instance.new("SurfaceLight")
	l.Face = face
	l.Color = color
	l.Range = range or 16
	l.Brightness = brightness or 1
	l.Angle = angle or 120
	l.Parent = parent
	return l
end

-- Text on one face of a part.
function Build.sign(part, face, text, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.ppS or 40
	gui.LightInfluence = opts.lightInfluence or 1
	gui.Brightness = opts.brightness or 1
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = opts.bg or Color3.fromRGB(120, 28, 24)
	label.BackgroundTransparency = opts.bgTransparency or 0
	label.BorderSizePixel = 0
	label.TextColor3 = opts.fg or Color3.fromRGB(232, 220, 186)
	label.Font = opts.font or Enum.Font.Oswald
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = opts.align or Enum.TextXAlignment.Center
	label.Text = text
	label.Parent = gui
	if opts.padding then
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(opts.padding, 0)
		pad.PaddingRight = UDim.new(opts.padding, 0)
		pad.PaddingTop = UDim.new(opts.padding, 0)
		pad.PaddingBottom = UDim.new(opts.padding, 0)
		pad.Parent = label
	end
	return gui, label
end

-- A constructivist propaganda poster. `design` comes from Config.Posters.
-- Facing: the poster's front face is the CFrame's LookVector.
function Build.poster(parent, at, design, size)
	size = size or Vector2.new(5, 7)
	local part = Build.detail(Build.block(parent, "Poster", Vector3.new(size.X, size.Y, 0.12), at, design.bg, Enum.Material.SmoothPlastic))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 1
	gui.Parent = part
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = design.bg
	bg.BorderSizePixel = 0
	bg.ClipsDescendants = true
	bg.Parent = gui
	local band = Instance.new("Frame")
	band.AnchorPoint = Vector2.new(0.5, 0.5)
	band.Position = UDim2.fromScale(0.5, 0.42)
	band.Size = UDim2.fromScale(1.8, 0.16)
	band.Rotation = -24
	band.BackgroundColor3 = design.fg
	band.BackgroundTransparency = 0.25
	band.BorderSizePixel = 0
	band.Parent = bg
	local star = Instance.new("TextLabel")
	star.Name = "Star"
	star.BackgroundTransparency = 1
	star.Position = UDim2.fromScale(0.05, 0.03)
	star.Size = UDim2.fromScale(0.9, 0.42)
	star.Text = "★"
	star.TextScaled = true
	star.TextColor3 = design.fg
	star.Font = Enum.Font.GothamBlack
	star.Parent = bg
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.06, 0.5)
	title.Size = UDim2.fromScale(0.88, 0.3)
	title.Text = design.title
	title.TextScaled = true
	title.TextWrapped = true
	title.TextColor3 = design.fg
	title.Font = Enum.Font.Oswald
	title.Parent = bg
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0.08, 0.82)
	sub.Size = UDim2.fromScale(0.84, 0.12)
	sub.Text = design.sub
	sub.TextScaled = true
	sub.TextWrapped = true
	sub.TextColor3 = design.fg
	sub.TextTransparency = 0.15
	sub.Font = Enum.Font.Oswald
	sub.Parent = bg
	part:SetAttribute("NightTitle", design.night)
	part:SetAttribute("NightSub", design.nightSub)
	part:SetAttribute("DayTitle", design.title)
	part:SetAttribute("DaySub", design.sub)
	Build.tag(part, "Poster")
	return part
end

-- A stage interaction. Game.server wires every tagged prompt.
function Build.interact(part, action, actionText, objectText, hold, extra)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Action", action)
	if extra then
		for k, v in extra do
			prompt:SetAttribute(k, v)
		end
	end
	prompt.Parent = part
	Build.tag(prompt, "StagePrompt")
	return prompt
end

-- A scrap of paper with a lore note on it.
function Build.note(parent, id, at)
	local paper = Build.detail(Build.block(parent, "Note", Vector3.new(1.1, 0.05, 1.5), at, Color3.fromRGB(226, 216, 186), Enum.Material.SmoothPlastic))
	paper.CanQuery = true
	local prompt = Build.interact(paper, "note", "Read", "Note", 0, { NoteId = id })
	prompt.MaxActivationDistance = 7
	Build.light(paper, Color3.fromRGB(255, 230, 190), 4, 0.35)
	return paper
end

-- A wall split into solid pieces around openings.
-- a, b: ends of the wall's inner face line (on the floor). out: unit vector pointing out of the room.
-- gaps: list of { at = distance from a, width = w, bottom = y (default 0), top = y (default height) }.
function Build.wall(parent, a, b, out, height, thickness, gaps, color, material, name)
	thickness = thickness or 1
	local dir = (b - a).Unit
	local length = (b - a).Magnitude
	local pieces = {}
	local function piece(s0, s1, y0, y1)
		if s1 - s0 < 0.05 or y1 - y0 < 0.05 then
			return
		end
		local mid = a + dir * ((s0 + s1) / 2) + out * (thickness / 2) + Vector3.new(0, (y0 + y1) / 2, 0)
		local p = Build.block(parent, name or "Wall", Vector3.new(thickness, y1 - y0, s1 - s0), CFrame.lookAt(mid, mid + dir), color, material)
		table.insert(pieces, p)
	end
	table.sort(gaps or {}, function(x, y)
		return x.at < y.at
	end)
	local cursor = 0
	for _, gap in gaps or {} do
		local g0, g1 = gap.at - gap.width / 2, gap.at + gap.width / 2
		piece(cursor, g0, 0, height)
		piece(g0, g1, 0, gap.bottom or 0)
		piece(g0, g1, gap.top or height, height)
		cursor = g1
	end
	piece(cursor, length, 0, height)
	return pieces
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Norilsk: Last Shift. Shared settings, places and story text.
-- Positions are in studs. North is -Z. The avenue runs north from the housing to the mine.

local Config = {}

Config.Title = "НОРИЛЬСК: ПОСЛЕДНЯЯ СМЕНА"
Config.TitleEnglish = "NORILSK: LAST SHIFT"

Config.WalkSpeed = 10
Config.SprintSpeed = 16
Config.StaminaSeconds = 6 -- how long a full sprint lasts
Config.StaminaRegen = 7 -- seconds to refill from empty

-- Places the builders and the game logic agree on.
Config.Places = {
	Apartment = Vector3.new(0, -150, 0), -- the player's flat (interior, reached through the door)
	HomeDoor = Vector3.new(-90.5, 0, 30), -- Building 14, entrance 2 (courtyard side)
	MineGate = Vector3.new(0, 0, -200),
	CageHouse = Vector3.new(0, 0, -280),
	Underground = Vector3.new(0, -300, -280), -- floor centre of the cage landing, horizon -300
	CanteenDoor = Vector3.new(70, 0, -105),
	CanteenWindowSpot = Vector3.new(58, 0, -124),
}

-- Indoor areas (min corner, max corner). No snow, calmer air.
Config.Interiors = {
	{ Vector3.new(-14, -152, -11), Vector3.new(14, -138, 11) }, -- apartment
	{ Vector3.new(70, -2, -135), Vector3.new(110, 15, -75) }, -- canteen
	{ Vector3.new(-55, -2, -245), Vector3.new(-25, 13, -225) }, -- lamp room
	{ Vector3.new(-13, -2, -292), Vector3.new(13, 17, -268) }, -- cage house
	{ Vector3.new(15, -2, -209), Vector3.new(25, 9, -199) }, -- checkpoint booth
}
Config.UndergroundBelow = -200 -- y below this counts as the mine

-- Story stages. "spot" is where you come back after being caught or respawning.
-- "threat" picks what the entity does: none, glimpse, mineIdle, mineHunt, canteen, hunt.
Config.Stages = {
	{ ru = "Собирайся на смену", en = "Get dressed and leave for your shift.", clock = "05:50", spot = "aptStart", threat = "none" },
	{ ru = "Отметься на проходной шахты № 6", en = "Clock in at the Mine No. 6 checkpoint. Follow the avenue north.", clock = "06:10", spot = "homeDoorOut", threat = "glimpse" },
	{ ru = "Получи лампу в ламповой", en = "Collect your lamp from the lamp room, left of the yard.", clock = "06:25", spot = "gate", threat = "glimpse" },
	{ ru = "Спустись в клети", en = "Ride the cage down to horizon −300.", clock = "06:35", spot = "gate", threat = "none" },
	{ ru = "Выполни норму", en = "Meet the quota: break ore from the five marked seams.", clock = "07:00", spot = "ugLanding", threat = "mineIdle" },
	{ ru = "Вернись к клети", en = "The lamps are dying. Get back to the cage.", clock = "15:40", spot = "ugNorth", threat = "mineHunt" },
	{ ru = "Иди в столовую № 3", en = "Go to Stolovaya No. 3 and hand in your meal coupon.", clock = "18:20", spot = "cageTop", threat = "glimpse" },
	{ ru = "Поешь", en = "Sit at your table and eat.", clock = "18:45", spot = "canteenInside", threat = "canteen" },
	{ ru = "Иди домой", en = "Walk home. Building 14, entrance 2, through the courtyard.", clock = "23:10", spot = "canteenDoor", threat = "hunt" },
	{ ru = "Ты дома", en = "You are home.", clock = "23:40", spot = "aptEnd", threat = "none" },
}
Config.FinalStage = #Config.Stages
Config.SeamCount = 5
Config.NightFrom = 9 -- from this stage the town is empty and pitch dark

-- The thing that follows you.
Config.Entity = {
	-- Night walk: it walks your exact footsteps.
	Speed = 11.5, -- studs/s while nobody is looking at it (you walk at 10)
	StillSpeed = 20, -- when you stand still
	StartDelay = 45, -- how far you get from the canteen door before it comes out
	MaxLag = 80, -- it never falls further behind than this
	DoorFloor = 40, -- when you reach your door it is at least this far behind
	CatchDistance = 4.5,
	-- Looking at it freezes it, but staring is dangerous.
	StareLimit = 3, -- seconds of staring before it blinks closer
	BlinkJump = 16,
	ViewDot = 0.82, -- how close to the centre of the screen counts as looking
	-- Underground.
	MineSpeed = 8.5,
	-- Glimpses in the morning and evening.
	GlimpseEvery = { 30, 55 },
	GlimpseVanishDistance = 38,
	GlimpseVanishStare = 1.3,
}

-- Underground route graph for the entity (local to Places.Underground).
Config.MineNodes = {
	landing = Vector3.new(0, 0, -6),
	westJunction = Vector3.new(0, 0, -70),
	westMid = Vector3.new(-55, 0, -70),
	westStope = Vector3.new(-125, 0, -70),
	eastJunction = Vector3.new(0, 0, -140),
	eastMid = Vector3.new(50, 0, -140),
	eastStope = Vector3.new(115, 0, -140),
	north = Vector3.new(0, 0, -213),
	oldGallery = Vector3.new(-70, 0, -213),
}
Config.MineEdges = {
	{ "landing", "westJunction" },
	{ "westJunction", "westMid" },
	{ "westMid", "westStope" },
	{ "westJunction", "eastJunction" },
	{ "eastJunction", "eastMid" },
	{ "eastMid", "eastStope" },
	{ "eastJunction", "north" },
	{ "north", "oldGallery" },
}
Config.MineLairs = { "oldGallery", "westStope", "eastStope" }

-- People walking in the town (client side). Points are on the ground.
-- Everyone is gone from Config.NightFrom on.
Config.Walkers = {
	{
		stages = { 1, 2, 3, 4 },
		count = 9,
		routes = {
			{ Vector3.new(-96, 0, 0), Vector3.new(-100, 0, -40), Vector3.new(-40, 0, -40), Vector3.new(-20, 0, -41), Vector3.new(-7, 0, -60), Vector3.new(-6, 0, -200), Vector3.new(-2, 0, -262) },
			{ Vector3.new(-96, 0, 60), Vector3.new(-104, 0, -42), Vector3.new(-40, 0, -43), Vector3.new(-20, 0, -44), Vector3.new(-8, 0, -80), Vector3.new(-5, 0, -200), Vector3.new(2, 0, -262) },
			{ Vector3.new(58, 0, 0), Vector3.new(40, 0, -20), Vector3.new(19.5, 0, -25), Vector3.new(19.5, 0, -185), Vector3.new(6, 0, -200), Vector3.new(4, 0, -262) },
			{ Vector3.new(58, 0, 60), Vector3.new(19.5, 0, 50), Vector3.new(19.5, 0, -185), Vector3.new(5, 0, -200), Vector3.new(-1, 0, -262) },
			{ Vector3.new(0, 0, 105), Vector3.new(-18.5, 0, 90), Vector3.new(-18.5, 0, -185), Vector3.new(-6, 0, -200), Vector3.new(-3, 0, -262) },
			{ Vector3.new(-96, 0, -110), Vector3.new(-100, 0, -175), Vector3.new(-40, 0, -185), Vector3.new(-8, 0, -198), Vector3.new(-6, 0, -206), Vector3.new(-22, 0, -235) },
		},
	},
	{
		stages = { 7, 8 },
		count = 4,
		routes = {
			{ Vector3.new(0, 0, -262), Vector3.new(5, 0, -205), Vector3.new(19.5, 0, -185), Vector3.new(19.5, 0, 50), Vector3.new(58, 0, 60) },
			{ Vector3.new(2, 0, -262), Vector3.new(-5, 0, -205), Vector3.new(-7, 0, -60), Vector3.new(-12, 0, -44), Vector3.new(-40, 0, -43), Vector3.new(-100, 0, -40), Vector3.new(-96, 0, 0) },
			{ Vector3.new(-3, 0, -262), Vector3.new(-6, 0, -205), Vector3.new(-18.5, 0, -185), Vector3.new(-18.5, 0, 90), Vector3.new(0, 0, 105) },
		},
	},
}

-- Built-in Roblox sounds so the game works with no uploads. Swap any id for your own
-- "rbxassetid://..." audio to make it scarier (wind, a drone, a real scream...).
Config.Audio = {
	Wind = { id = "rbxasset://sounds/action_falling.mp3", volume = 0.35, pitch = 0.35, looped = true },
	MineHum = { id = "rbxasset://sounds/action_swim.mp3", volume = 0.25, pitch = 0.3, looped = true },
	Footsteps = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 1.4, pitch = 0.55, looped = true },
	Heartbeat = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.9, pitch = 0.45 },
	Sting = { id = "rbxasset://sounds/action_falling.mp3", volume = 1.2, pitch = 0.18 },
	Scream = { id = "rbxasset://sounds/uuhhh.mp3", volume = 3, pitch = 0.55 },
	ScreamLow = { id = "rbxasset://sounds/action_falling.mp3", volume = 3, pitch = 0.12 },
	Pick = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 1.2, pitch = 1.7 },
	Knock = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 2.5, pitch = 0.6 },
	Click = { id = "rbxasset://sounds/action_get_up.mp3", volume = 0.6, pitch = 2.2 },
	Drip = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.35, pitch = 2.5 },
	Groan = { id = "rbxasset://sounds/uuhhh.mp3", volume = 1.5, pitch = 0.3 },
}

-- Posters. At night the slogans change.
Config.Posters = {
	{ title = "СЛАВА ТРУДУ!", sub = "Glory to labour", night = "НЕ СМОТРИ НА НЕГО ДОЛГО", nightSub = "Do not look at it for long", bg = Color3.fromRGB(150, 30, 26), fg = Color3.fromRGB(236, 222, 186) },
	{ title = "ПЯТИЛЕТКУ — ДОСРОЧНО!", sub = "The Five-Year Plan ahead of schedule", night = "ОН ТОЖЕ ВЫПОЛНЯЕТ ПЛАН", nightSub = "It fulfils its quota too", bg = Color3.fromRGB(226, 208, 160), fg = Color3.fromRGB(140, 24, 22) },
	{ title = "НИКЕЛЬ — РОДИНЕ!", sub = "Nickel for the Motherland", night = "ОН ВОЗВРАЩАЕТСЯ ЗА КАЖДОЙ СМЕНОЙ", nightSub = "It comes back for every shift", bg = Color3.fromRGB(40, 44, 48), fg = Color3.fromRGB(220, 60, 45) },
	{ title = "НЕ БОЛТАЙ!", sub = "Loose talk helps the enemy", night = "МОЛЧИ. ОН СЛЫШИТ.", nightSub = "Be quiet. It hears.", bg = Color3.fromRGB(230, 220, 190), fg = Color3.fromRGB(30, 30, 30) },
	{ title = "ТЕХНИКА БЕЗОПАСНОСТИ — ЗАКОН!", sub = "Safety rules are law", night = "ЛАМПА № 117 НЕ ВОЗВРАЩЕНА", nightSub = "Lamp No. 117 was never returned", bg = Color3.fromRGB(210, 160, 30), fg = Color3.fromRGB(25, 25, 25) },
	{ title = "ХЛЕБ — БОГАТСТВО НАШЕ", sub = "Bread is our wealth. Treasure it.", night = "ТЫ ПОСЛЕДНИЙ", nightSub = "You are the last one", bg = Color3.fromRGB(196, 120, 40), fg = Color3.fromRGB(250, 240, 210) },
	{ title = "ВПЕРЁД, К ПОБЕДЕ КОММУНИЗМА!", sub = "Forward to the victory of communism", night = "ИДИ. НЕ ОСТАНАВЛИВАЙСЯ.", nightSub = "Walk. Do not stop.", bg = Color3.fromRGB(160, 28, 30), fg = Color3.fromRGB(250, 214, 90) },
}

-- Lore notes hidden around town and the mine.
Config.Notes = {
	{
		title = "Письмо от матери / A letter from Mother",
		text = "Красноярск, 2 декабря 1984\n\nMy son,\nYou write that the money is good, but you do not write that you are well. Come home in the summer. The north eats people, your father always said so.\n\nAnd what about your neighbour, Pyotr — did they ever find him? His wife wrote to his sister that the militia stopped looking after one week.\n\nWalk home with the others. Do not walk alone.\n— Mama",
	},
	{
		title = "Объявление / Missing person notice",
		text = "РАЗЫСКИВАЕТСЯ — MISSING\n\nВОЛКОВ Геннадий Петрович, b. 1949. Underground miner, Mine No. 6.\nLast seen 14 November, walking home alone from Stolovaya No. 3 after 23:00.\nWearing a grey padded coat and a rabbit-fur ushanka.\n\nAnyone with information, contact the militia, Leninsky Prospekt 9.\n\n(Someone has written underneath in pencil: \"Он не один. Их уже семь.\" — \"He is not the only one. That makes seven.\")",
	},
	{
		title = "Журнал ламповой / Lamp room ledger",
		text = "Lamp issued / returned:\n\n№ 112 — Kuzmin — returned\n№ 113 — Ostapenko — returned\n№ 117 — ??? — NOT RETURNED\n...\n12.12.1984  № 117 — NOT RETURNED\n13.03.1971  № 117 — NOT RETURNED\n04.01.1962  № 117 — NOT RETURNED\n19.11.1953  № 117 — NOT RETURNED\n\nThe pages go back thirty years. The same hand wrote every line.",
	},
	{
		title = "Надпись на досках / Scratched into the boards",
		text = "1952. Шахта Норильлага.\n\nОн ходит за последним. Ему нужен тот, кто идёт один.\nIt walks behind the last man. It wants the one who walks alone.\n\nКогда смотришь — стоит. Смотришь долго — подходит ближе.\nWhile you look, it stands. Look too long and it comes closer.\n\nНе останавливайся. Do not stop.\n\n(The rest is worn away by hands.)",
	},
	{
		title = "Секретно / Secret memorandum",
		text = "КГБ СССР — Норильский отдел\nСЕКРЕТНО\n\nRe: disappearances on Leninsky Prospekt, sector 4.\n\n1. Do not discuss outside the department.\n2. Workers of the second shift are to walk home in groups after 22:00.\n3. The streetlights in sector 4 keep failing. Electricians refuse to go out at night. Replace them.\n4. The lamp issue journal of Mine No. 6 is to be confiscated.\n\nNobody is to say the word \"бригадир\" (foreman).",
	},
	{
		title = "Табличка у вышки / Plaque by the watchtower",
		text = "НОРИЛЬЛАГ, 1935–1956.\n\nHere, prisoners built the city and the mines.\n\nBelow, someone scratched a list of names into the metal, and next to the last one a single word:\n\nБРИГАДИР. He kept the count. He always walked behind the column, so that nobody fell behind.\n\nHe is still counting.",
	},
}

-- What the radio in the canteen says (subtitles).
Config.Radio = {
	"Радио «Маяк»: Норильские горняки перевыполнили план на сто двенадцать процентов…",
	"Радио «Маяк»: …температура в Норильске минус сорок один градус. Ветер северный…",
	"Радио «Маяк»: …товарищ Черненко принял делегацию…",
	"Радио «Маяк»: …Never walk home alone. Never stop. Never look for long…",
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Figure</string><ProtectedString name="Source"><![CDATA[-- Builds a person out of parts: miners, diners, canteen staff, people on the street.
-- Limbs are grouped around joints so the client can animate them (see client/Rig.luau).
-- The model's pivot is on the ground (or floor) under the person, facing its LookVector.

local Build = require(script.Parent.Build)

local Figure = {}

local rgb = Color3.fromRGB
local SKIN = { rgb(226, 190, 160), rgb(214, 172, 138), rgb(232, 204, 180), rgb(198, 160, 128) }
local COATS = { rgb(62, 64, 60), rgb(74, 66, 56), rgb(48, 52, 58), rgb(86, 78, 64), rgb(58, 62, 70), rgb(40, 40, 40) }
local PANTS = { rgb(38, 38, 42), rgb(50, 48, 46), rgb(30, 34, 40) }
local KERCHIEFS = { rgb(150, 40, 40), rgb(60, 90, 140), rgb(200, 170, 90), rgb(110, 60, 90) }

Figure.Coats = COATS

local function pick(list, rng)
	return list[rng:NextInteger(1, #list)]
end

-- opts: pose ("stand"|"sit"), hat, held, coat, pants, skin, armR, armL (rest angles in degrees,
-- 0 = hanging, 90 = pointing forward), action (animation name for the client), seed, name.
function Figure.build(parent, pivot, opts)
	opts = opts or {}
	local rng = Random.new(opts.seed or math.random(1, 1e6))
	local model = Instance.new("Model")
	model.Name = opts.name or "Person"
	local coat = opts.coat or pick(COATS, rng)
	local pants = opts.pants or pick(PANTS, rng)
	local skin = opts.skin or pick(SKIN, rng)
	local seated = opts.pose == "sit"
	local seatH = opts.seatHeight or 1.9

	local root = Build.block(model, "Root", Vector3.new(1, 1, 1), pivot, coat)
	root.Transparency = 1
	Build.detail(root)
	model.PrimaryPart = root

	local function part(name, size, rel, color, material, group)
		local p = Build.detail(Build.block(model, name, size, pivot * rel, color, material or Enum.Material.Fabric))
		if group then
			p:SetAttribute("Group", group)
		end
		return p
	end
	local function joint(name, rel)
		model:SetAttribute("Joint_" .. name, rel)
	end

	-- Legs
	for i, side in { -1, 1 } do
		local g = i == 1 and "LegL" or "LegR"
		if seated then
			local hip = CFrame.new(side * 0.5, seatH + 0.4, 0.2)
			joint(g, hip)
			part("Thigh", Vector3.new(0.9, 0.8, 2.2), CFrame.new(side * 0.5, seatH + 0.4, -0.9), pants, nil, g)
			part("Shin", Vector3.new(0.85, seatH + 0.45, 0.9), CFrame.new(side * 0.5, (seatH + 0.45) / 2, -1.9), pants, nil, g)
			part("Boot", Vector3.new(1, 0.6, 1.3), CFrame.new(side * 0.5, 0.3, -2.1), rgb(28, 26, 24), Enum.Material.Leather, g)
		else
			joint(g, CFrame.new(side * 0.5, 2.8, 0))
			part("Leg", Vector3.new(0.9, 2.8, 0.9), CFrame.new(side * 0.5, 1.4, 0), pants, nil, g)
			part("Boot", Vector3.new(1, 0.7, 1.3), CFrame.new(side * 0.5, 0.35, -0.12), rgb(28, 26, 24), Enum.Material.Leather, g)
		end
	end

	local up = seated and Vector3.new(0, seatH + 0.1 - 2.8, 0.2) or Vector3.zero
	local function at(x, y, z)
		return CFrame.new(Vector3.new(x, y, z) + up)
	end

	part("Torso", Vector3.new(2.2, 2.7, 1.2), at(0, 4.15, 0), coat)
	part("CoatSkirt", Vector3.new(2.3, seated and 0.6 or 1, 1.3), at(0, seated and 2.9 or 2.45, 0), coat)
	part("Collar", Vector3.new(1.6, 0.35, 1.25), at(0, 5.45, 0), coat:Lerp(rgb(0, 0, 0), 0.25))

	-- Head and hat turn together around the neck.
	joint("Head", at(0, 5.5, 0))
	part("Head", Vector3.new(1.1, 1.2, 1.05), at(0, 6.1, 0), skin, Enum.Material.SmoothPlastic, "Head")
	for _, x in { -0.25, 0.25 } do
		part("Eye", Vector3.new(0.18, 0.12, 0.05), at(x, 6.22, -0.53), rgb(25, 22, 20), Enum.Material.SmoothPlastic, "Head")
	end
	part("Nose", Vector3.new(0.18, 0.3, 0.16), at(0, 6.02, -0.58), skin, Enum.Material.SmoothPlastic, "Head")
	local hat = opts.hat
	if hat == "ushanka" then
		local fur = rng:NextNumber() < 0.5 and rgb(70, 52, 38) or rgb(40, 38, 36)
		part("Hat", Vector3.new(1.35, 0.6, 1.3), at(0, 6.85, 0.02), fur, Enum.Material.Fabric, "Head")
		part("Hat", Vector3.new(1.4, 0.3, 0.3), at(0, 6.7, -0.62), fur, Enum.Material.Fabric, "Head")
		for _, x in { -0.72, 0.72 } do
			part("Hat", Vector3.new(0.2, 0.8, 0.95), at(x, 6.3, 0.05), fur, Enum.Material.Fabric, "Head")
		end
	elseif hat == "kerchief" then
		local c = pick(KERCHIEFS, rng)
		part("Hat", Vector3.new(1.25, 0.95, 1.2), at(0, 6.5, 0.08), c, Enum.Material.Fabric, "Head")
		part("Hat", Vector3.new(0.5, 0.4, 0.3), at(0, 5.75, -0.45), c, Enum.Material.Fabric, "Head")
	elseif hat == "chef" then
		part("Hat", Vector3.new(1.15, 0.9, 1.1), at(0, 7.05, 0), rgb(236, 236, 228), Enum.Material.Fabric, "Head")
	elseif hat == "helmet" then
		part("Hat", Vector3.new(1.35, 0.55, 1.45), at(0, 6.85, 0), rgb(40, 40, 38), Enum.Material.SmoothPlastic, "Head")
		local lamp = part("Hat", Vector3.new(0.45, 0.4, 0.2), at(0, 6.85, -0.78), rgb(255, 214, 140), Enum.Material.Neon, "Head")
		lamp.Name = "HelmetLamp"
	elseif hat == "cap" then
		part("Hat", Vector3.new(1.25, 0.35, 1.2), at(0, 6.85, 0.02), rgb(46, 52, 46), Enum.Material.Fabric, "Head")
		part("Hat", Vector3.new(1.2, 0.12, 0.6), at(0, 6.72, -0.7), rgb(30, 30, 30), Enum.Material.Leather, "Head")
	end

	-- Arms hang from the shoulders; rest angle rotates them forward.
	for i, side in { -1, 1 } do
		local g = i == 1 and "ArmL" or "ArmR"
		local rest = math.rad((i == 1 and opts.armL or opts.armR) or 0)
		local shoulder = at(side * 1.4, 5.2, 0)
		joint(g, shoulder)
		model:SetAttribute("Rest_" .. g, rest)
		local bent = shoulder * CFrame.Angles(rest, 0, 0)
		part("Arm", Vector3.new(0.6, 2.5, 0.65), bent * CFrame.new(0, -1.15, 0), coat, nil, g)
		part("Hand", Vector3.new(0.5, 0.5, 0.5), bent * CFrame.new(0, -2.6, 0), skin, Enum.Material.SmoothPlastic, g)
		if i == 2 and opts.held then
			local hand = bent * CFrame.new(0, -2.75, 0) * CFrame.Angles(-rest, 0, 0)
			local held = opts.held
			if held == "mug" then
				part("Held", Vector3.new(0.6, 0.55, 0.55), hand * CFrame.new(0, 0.2, -0.2) * CFrame.Angles(0, 0, math.pi / 2), rgb(222, 222, 210), Enum.Material.SmoothPlastic, g).Shape = Enum.PartType.Cylinder
			elseif held == "glass" then
				local p = part("Held", Vector3.new(0.65, 0.48, 0.48), hand * CFrame.new(0, 0.25, -0.2) * CFrame.Angles(0, 0, math.pi / 2), rgb(200, 205, 190), Enum.Material.Glass, g)
				p.Shape = Enum.PartType.Cylinder
				p.Transparency = 0.35
			elseif held == "spoon" then
				part("Held", Vector3.new(0.12, 0.08, 1), hand * CFrame.new(0, 0, -0.5), rgb(190, 190, 186), Enum.Material.Metal, g)
			elseif held == "cigarette" then
				part("Held", Vector3.new(0.08, 0.08, 0.45), hand * CFrame.new(0.1, 0.2, -0.3), rgb(236, 232, 220), Enum.Material.SmoothPlastic, g)
				part("Held", Vector3.new(0.09, 0.09, 0.08), hand * CFrame.new(0.1, 0.2, -0.55), rgb(255, 120, 40), Enum.Material.Neon, g)
			elseif held == "pick" then
				part("Held", Vector3.new(0.22, 0.22, 3.2), hand * CFrame.new(0, 0, -1.2), rgb(110, 80, 50), Enum.Material.Wood, g)
				part("Held", Vector3.new(2.4, 0.3, 0.3), hand * CFrame.new(0, 0, -2.7), rgb(70, 70, 72), Enum.Material.Metal, g)
			elseif held == "ladle" then
				part("Held", Vector3.new(0.15, 2.6, 0.15), hand * CFrame.new(0, -1.1, -0.2), rgb(180, 180, 176), Enum.Material.Metal, g)
			elseif held == "papers" then
				part("Held", Vector3.new(1, 0.08, 1.3), hand * CFrame.new(0, 0, -0.5), rgb(226, 220, 196), Enum.Material.SmoothPlastic, g)
			end
		end
	end

	if opts.action then
		model:SetAttribute("Action", opts.action)
	end
	model:SetAttribute("Seed", rng:NextInteger(1, 1e6))
	model:SetAttribute("Seated", seated)
	model.Parent = parent
	return model
end

return Figure
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Canteen</string><ProtectedString name="Source"><![CDATA[-- Stolovaya No. 3: the state canteen. Tiled floor, green-painted walls, a serving line,
-- a kitchen, and tired people eating shchi and drinking compote.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Build)
local Figure = require(Shared.Figure)
local Config = require(Shared.Config)

local rgb = Build.rgb
local block, detail = Build.block, Build.detail

local Canteen = {}

local SNOW = rgb(222, 228, 234)
local WALL = rgb(214, 208, 192)
local PAINT = rgb(128, 164, 140)
local STEEL = rgb(176, 178, 176)

local function show(model)
	model:SetAttribute("ShowFrom", 7)
	model:SetAttribute("ShowTo", 8)
	Build.tag(model, "StagedPerson")
	return model
end

local function plate(parent, at, food)
	detail(Build.cylinder(parent, "Plate", 0.12, 1.3, CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), rgb(236, 234, 226), Enum.Material.SmoothPlastic))
	if food then
		detail(Build.cylinder(parent, "Food", 0.1, 0.95, CFrame.new(at + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.pi / 2), food, Enum.Material.SmoothPlastic))
	end
end

local function glass(parent, at, drink)
	local g = detail(Build.column(parent, "Faceted glass", 0.6, 0.45, at, drink or rgb(150, 70, 50), Enum.Material.Glass))
	g.Transparency = 0.25
end

local FOODS = { rgb(170, 60, 40), rgb(200, 180, 130), rgb(120, 80, 50), rgb(220, 210, 170), rgb(150, 110, 60) }

local function steam(parent, at, rate)
	local p = detail(block(parent, "Steam", Vector3.new(1, 0.2, 1), at, rgb(255, 255, 255)))
	p.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Rate = rate or 4
	e.Lifetime = NumberRange.new(1.5, 2.5)
	e.Speed = NumberRange.new(0.8, 1.5)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1.8) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(1, 1) })
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = p
end

local function table4(parent, x, z, rng)
	block(parent, "Table", Vector3.new(4, 0.25, 3.4), Vector3.new(x, 3.3, z), rgb(170, 186, 190), Enum.Material.SmoothPlastic)
	detail(block(parent, "Table leg", Vector3.new(0.5, 2.9, 0.5), Vector3.new(x, 1.85, z), rgb(80, 80, 80), Enum.Material.Metal))
	detail(block(parent, "Table foot", Vector3.new(2.4, 0.15, 1.6), Vector3.new(x, 0.48, z), rgb(80, 80, 80), Enum.Material.Metal))
	-- Salt, napkins.
	detail(Build.column(parent, "Salt", 0.5, 0.3, Vector3.new(x + 1.5, 3.42, z), rgb(236, 236, 236), Enum.Material.Glass))
	detail(block(parent, "Napkin holder", Vector3.new(0.7, 0.6, 0.3), Vector3.new(x + 1.5, 3.72, z + 0.6), rgb(200, 200, 196), Enum.Material.Metal))
	local seats = {}
	for _, s in { { -1, -2.3, 1 }, { 1, -2.3, 1 }, { -1, 2.3, -1 }, { 1, 2.3, -1 } } do
		local cx, cz, facing = x + s[1], z + s[2], s[3]
		block(parent, "Chair seat", Vector3.new(1.8, 0.25, 1.8), Vector3.new(cx, 2.1, cz), rgb(110, 76, 50), Enum.Material.Wood)
		detail(block(parent, "Chair leg", Vector3.new(0.3, 1.7, 0.3), Vector3.new(cx, 1.25, cz), rgb(70, 70, 70), Enum.Material.Metal))
		detail(block(parent, "Chair back", Vector3.new(1.8, 2.2, 0.2), Vector3.new(cx, 3.3, cz - facing * 0.85), rgb(110, 76, 50), Enum.Material.Wood))
		table.insert(seats, { pos = Vector3.new(cx, 0.4, cz), facing = Vector3.new(0, 0, facing), plate = Vector3.new(cx, 3.47, z - facing * 0.75) })
	end
	if rng:NextNumber() < 0.6 then
		detail(block(parent, "Bread", Vector3.new(1, 0.35, 0.7), Vector3.new(x - 1.5, 3.6, z), rgb(150, 100, 60), Enum.Material.Sand))
	end
	return seats
end

function Canteen.build(world)
	local spots = {}
	local m = Instance.new("Model")
	m.Name = "Stolovaya No. 3"
	m.Parent = world
	local rng = Random.new(3)

	-- Shell.
	local x0, x1, z0, z1, h = 70, 110, -135, -75, 14
	Build.wall(m, Vector3.new(x0, 0, z0), Vector3.new(x0, 0, z1), Vector3.new(-1, 0, 0), h, 1, {
		{ at = 12, width = 16, bottom = 2.5, top = 10 },
		{ at = 30, width = 6, top = 8 },
		{ at = 48, width = 16, bottom = 2.5, top = 10 },
	}, WALL, Enum.Material.Concrete)
	Build.wall(m, Vector3.new(x1, 0, z0), Vector3.new(x1, 0, z1), Vector3.new(1, 0, 0), h, 1, {}, WALL, Enum.Material.Concrete)
	Build.wall(m, Vector3.new(x0 - 1, 0, z0), Vector3.new(x1 + 1, 0, z0), Vector3.new(0, 0, -1), h, 1, {}, WALL, Enum.Material.Concrete)
	Build.wall(m, Vector3.new(x0 - 1, 0, z1), Vector3.new(x1 + 1, 0, z1), Vector3.new(0, 0, 1), h, 1, {}, WALL, Enum.Material.Concrete)
	block(m, "Roof", Vector3.new(42.6, 1, 62.6), Vector3.new(90, h + 0.5, -105), rgb(150, 146, 140))
	detail(block(m, "Roof snow", Vector3.new(42.4, 0.7, 62.4), Vector3.new(90, h + 1.35, -105), SNOW, Enum.Material.Snow))
	block(m, "Floor", Vector3.new(40, 0.4, 60), Vector3.new(90, 0.2, -105), rgb(200, 190, 170), Enum.Material.Slate)
	for ix = 0, 9 do
		for iz = 0, 14 do
			if (ix + iz) % 2 == 0 then
				detail(block(m, "Floor tile", Vector3.new(4, 0.04, 4), Vector3.new(x0 + 2 + ix * 4, 0.42, z0 + 2 + iz * 4), rgb(120, 60, 50), Enum.Material.Slate))
			end
		end
	end
	-- Painted dado: the lower walls are green, like every canteen and hospital in the Union.
	detail(block(m, "Wall paint", Vector3.new(40, 5, 0.08), Vector3.new(90, 2.9, z0 + 0.05), PAINT, Enum.Material.SmoothPlastic))
	detail(block(m, "Wall paint", Vector3.new(40, 5, 0.08), Vector3.new(90, 2.9, z1 - 0.05), PAINT, Enum.Material.SmoothPlastic))
	detail(block(m, "Wall paint", Vector3.new(0.08, 5, 60), Vector3.new(x1 - 0.05, 2.9, -105), PAINT, Enum.Material.SmoothPlastic))
	for _, seg in { { -135, -108 }, { -102, -75 } } do
		detail(block(m, "Wall paint", Vector3.new(0.08, 2.1, seg[2] - seg[1]), Vector3.new(x0 + 0.05, 1.45, (seg[1] + seg[2]) / 2), PAINT, Enum.Material.SmoothPlastic))
	end

	-- Big windows onto the street.
	for _, z in { -123, -87 } do
		local pane = block(m, "Canteen window", Vector3.new(0.2, 7.5, 16), Vector3.new(69.5, 6.25, z), rgb(170, 190, 196), Enum.Material.Glass)
		pane.Transparency = 0.45
		for dz = -4, 4, 4 do
			detail(block(m, "Window mullion", Vector3.new(0.4, 7.5, 0.25), Vector3.new(69.5, 6.25, z + dz), rgb(90, 86, 80), Enum.Material.Metal))
		end
		detail(block(m, "Window sill snow", Vector3.new(1, 0.4, 16.4), Vector3.new(68.6, 2.6, z), SNOW, Enum.Material.Snow))
		local frost = detail(block(m, "Frost", Vector3.new(0.1, 2, 16), Vector3.new(69.35, 3.5, z), rgb(236, 244, 250), Enum.Material.Glass))
		frost.Transparency = 0.5
	end

	-- Entrance.
	for _, z in { -108.2, -101.8 } do
		detail(block(m, "Open door", Vector3.new(3, 7.6, 0.25), CFrame.new(70.5 + 1.4, 3.8 + 0.2, z) * CFrame.Angles(0, 0, 0), rgb(110, 80, 50), Enum.Material.Wood))
	end
	block(m, "Entrance step", Vector3.new(6, 0.4, 10), Vector3.new(66, 0.2, -105), rgb(150, 150, 146))
	block(m, "Entrance canopy", Vector3.new(6, 0.5, 10), Vector3.new(66, 9.2, -105), rgb(150, 146, 140))
	detail(block(m, "Canopy snow", Vector3.new(5.8, 0.4, 9.8), Vector3.new(66, 9.6, -105), SNOW, Enum.Material.Snow))
	local lamp = detail(Build.ball(m, "Entrance lamp", 0.8, Vector3.new(66, 8.5, -105), rgb(255, 200, 130), Enum.Material.Neon))
	Build.light(lamp, rgb(255, 190, 120), 20, 1.1, true)
	Build.tag(lamp, "EntranceLamp")
	local sign = detail(block(m, "Canteen sign", Vector3.new(0.4, 3, 26), Vector3.new(68.8, 11.8, -105), rgb(236, 226, 200)))
	Build.sign(sign, Enum.NormalId.Left, "СТОЛОВАЯ № 3", { bg = rgb(236, 226, 200), fg = rgb(180, 30, 26), lightInfluence = 0.25, brightness = 1.3 })
	local sub = detail(block(m, "Canteen subsign", Vector3.new(0.3, 1, 14), Vector3.new(68.8, 9.9, -105), rgb(36, 56, 104)))
	Build.sign(sub, Enum.NormalId.Left, "ОБЩЕСТВЕННОЕ ПИТАНИЕ · 7:00–23:00", { bg = rgb(36, 56, 104), fg = rgb(240, 240, 230) })
	local signGlow = detail(block(m, "Sign glow", Vector3.new(0.2, 0.2, 0.2), Vector3.new(66, 12, -105), rgb(255, 255, 255)))
	signGlow.Transparency = 1
	Build.light(signGlow, rgb(255, 120, 100), 12, 0.6)
	local board = detail(block(m, "Menu stand", Vector3.new(0.3, 3.5, 2.6), Vector3.new(63, 2.4, -113), rgb(40, 50, 44)))
	Build.sign(board, Enum.NormalId.Left, "МЕНЮ\n12.12.84\nЩи · котлета\nкомпот", { bg = rgb(36, 48, 40), fg = rgb(236, 236, 226), font = Enum.Font.PermanentMarker, padding = 0.05 })
	spots.canteenDoor = CFrame.lookAt(Vector3.new(63, 3, -105), Vector3.new(30, 3, -105))
	spots.canteenInside = CFrame.lookAt(Vector3.new(75, 3, -105), Vector3.new(100, 3, -105))

	-- Lights.
	for _, x in { 80, 92 } do
		for _, z in { -125, -105, -85 } do
			local tube = detail(block(m, "Ceiling light", Vector3.new(1, 0.3, 7), Vector3.new(x, 13.7, z), rgb(226, 240, 230), Enum.Material.Neon))
			Build.surfaceLight(tube, Enum.NormalId.Bottom, rgb(216, 236, 224), 20, 1.1, 150)
			Build.tag(tube, "CanteenLight")
		end
	end

	-- Serving line.
	block(m, "Counter", Vector3.new(3, 3.2, 45), Vector3.new(101.5, 2, -108.5), STEEL, Enum.Material.Metal)
	detail(block(m, "Counter top", Vector3.new(3.4, 0.2, 45), Vector3.new(101.5, 3.7, -108.5), rgb(210, 210, 206), Enum.Material.Metal))
	detail(block(m, "Tray rail", Vector3.new(1, 0.12, 45), Vector3.new(99.4, 3.1, -108.5), rgb(200, 200, 196), Enum.Material.Metal))
	for z = -129, -89, 8 do
		detail(block(m, "Rail bracket", Vector3.new(0.6, 0.2, 0.2), Vector3.new(99.8, 2.9, z), rgb(160, 160, 156), Enum.Material.Metal))
	end
	for i = 0, 9 do
		detail(block(m, "Tray", Vector3.new(1.6, 0.08, 2.2), Vector3.new(101.5, 3.85 + i * 0.09, -129.5), rgb(150, 120, 90), Enum.Material.SmoothPlastic))
	end
	local hot = { rgb(170, 60, 40), rgb(200, 180, 130), rgb(120, 80, 50), rgb(230, 220, 180), rgb(110, 140, 80) }
	for i, food in hot do
		local z = -125 + (i - 1) * 5
		detail(block(m, "Food tray", Vector3.new(2.4, 0.6, 3.6), Vector3.new(101.5, 4.1, z), STEEL, Enum.Material.Metal))
		detail(block(m, "Food", Vector3.new(2.1, 0.1, 3.3), Vector3.new(101.5, 4.42, z), food, Enum.Material.SmoothPlastic))
		if i <= 3 then
			steam(m, Vector3.new(101.5, 4.6, z), 3)
		end
	end
	for i = 0, 5 do
		glass(m, Vector3.new(100.6 + (i % 2) * 0.7, 3.8, -99 + math.floor(i / 2) * 0.8), rgb(160, 70, 60))
	end
	for i = 0, 3 do
		plate(m, Vector3.new(101.5, 3.86, -95 + i * 0.6), nil)
	end
	local register = block(m, "Cash register", Vector3.new(1.6, 1.4, 1.4), Vector3.new(101.5, 4.5, -89), rgb(70, 70, 66), Enum.Material.Metal)
	Build.sign(register, Enum.NormalId.Left, "КАССА", { bg = rgb(60, 60, 56), fg = rgb(120, 255, 140), font = Enum.Font.Code })
	Build.interact(register, "coupon", "Hand in your meal coupon", "Cashier", 1)
	local radio = detail(block(m, "Radio", Vector3.new(1.2, 1, 2), Vector3.new(102, 4.3, -120), rgb(80, 56, 36), Enum.Material.Wood))
	Build.sign(radio, Enum.NormalId.Left, "≋ РАДИО ≋", { bg = rgb(80, 56, 36), fg = rgb(230, 210, 160) })
	Build.tag(radio, "Radio")

	-- Kitchen.
	block(m, "Stove", Vector3.new(4, 3, 10), Vector3.new(107.5, 1.9, -114), rgb(40, 40, 40), Enum.Material.Metal)
	for i, z in { -117, -113 } do
		detail(Build.column(m, "Pot", 2.4, 2.8, Vector3.new(107.5, 3.4, z), rgb(180, 180, 176), Enum.Material.Metal))
		steam(m, Vector3.new(107.5, 5.9, z), 6 + i)
	end
	for y = 6, 9, 3 do
		detail(block(m, "Shelf", Vector3.new(1.2, 0.2, 14), Vector3.new(109.3, y, -100), rgb(120, 100, 80), Enum.Material.Wood))
		for z = -106, -94, 2.4 do
			detail(Build.column(m, "Shelf pot", 1, 1, Vector3.new(109.3, y + 0.1, z), rgb(170, 170, 166), Enum.Material.Metal))
		end
	end
	local menu = detail(block(m, "Menu board", Vector3.new(0.2, 6, 12), Vector3.new(109.4, 9.5, -122), rgb(30, 40, 34)))
	Build.sign(menu, Enum.NormalId.Left, "МЕНЮ\nЩи суточные ........ 18 к.\nКотлета с пюре .... 32 к.\nКаша гречневая ...... 9 к.\nХлеб ................ 2 к.\nКомпот .............. 7 к.\nЧай с сахаром ....... 3 к.", { bg = rgb(34, 46, 38), fg = rgb(236, 236, 226), font = Enum.Font.Code, padding = 0.04, align = Enum.TextXAlignment.Left })
	local dishes = detail(block(m, "Dish return sign", Vector3.new(8, 1.2, 0.1), Vector3.new(92, 8, -75.6), rgb(236, 230, 214)))
	Build.sign(dishes, Enum.NormalId.Front, "ПОЕЛ — УБЕРИ ЗА СОБОЙ ПОСУДУ!", { bg = rgb(236, 230, 214), fg = rgb(30, 60, 120) })
	detail(block(m, "Dish hatch", Vector3.new(6, 3, 0.1), Vector3.new(92, 4.8, -75.6), rgb(30, 30, 30)))

	-- Wall dressing.
	local clock = detail(Build.cylinder(m, "Wall clock", 0.3, 3, CFrame.new(90, 11, -134.4) * CFrame.Angles(0, math.pi / 2, 0), rgb(236, 236, 230), Enum.Material.SmoothPlastic))
	local face = detail(block(m, "Clock face", Vector3.new(2, 1, 0.05), Vector3.new(90, 11, -134.2), rgb(236, 236, 230)))
	Build.sign(face, Enum.NormalId.Back, "18:45", { bg = rgb(236, 236, 230), fg = rgb(20, 20, 20), font = Enum.Font.Code })
	Build.tag(face, "WallClock")
	clock.CastShadow = false
	Build.poster(m, CFrame.lookAt(Vector3.new(80, 7, -134.4), Vector3.new(80, 7, -120)), Config.Posters[6])
	Build.poster(m, CFrame.lookAt(Vector3.new(100, 7, -75.6), Vector3.new(100, 7, -90)), Config.Posters[4])
	local portrait = detail(block(m, "Portrait", Vector3.new(3, 4, 0.2), Vector3.new(80, 8, -75.6), rgb(120, 90, 50), Enum.Material.Wood))
	Build.sign(portrait, Enum.NormalId.Front, "★\nСЛАВА\nКПСС", { bg = rgb(150, 30, 28), fg = rgb(250, 220, 120), padding = 0.1 })
	detail(block(m, "Coat rack", Vector3.new(0.3, 7, 0.3), Vector3.new(72, 3.9, -96), rgb(80, 60, 40), Enum.Material.Wood))
	for i = 0, 2 do
		detail(block(m, "Hanging coat", Vector3.new(1.4, 3.4, 0.8), Vector3.new(72.6, 4.6, -97.5 + i * 1.5), ({ rgb(60, 62, 58), rgb(70, 60, 50), rgb(40, 40, 44) })[i + 1], Enum.Material.Fabric))
		detail(block(m, "Hanging ushanka", Vector3.new(1.2, 0.7, 1.2), Vector3.new(72.3, 7.6, -97.5 + i * 1.5), rgb(60, 46, 36), Enum.Material.Fabric))
	end

	-- Tables and the people at them.
	local tables = {}
	for _, x in { 78, 88 } do
		for _, z in { -128, -118, -92, -82 } do
			tables[x .. "," .. z] = table4(m, x, z, rng)
		end
	end
	local function diner(key, seat, opts)
		local s = tables[key][seat]
		opts.pose = "sit"
		opts.seatHeight = 1.8
		opts.name = "Diner"
		local model = show(Figure.build(m, CFrame.lookAt(s.pos, s.pos + s.facing), opts))
		plate(m, s.plate, FOODS[rng:NextInteger(1, #FOODS)])
		if opts.action == "drink" then
			glass(m, s.plate + Vector3.new(0.8, 0, 0), rgb(150, 70, 50))
		end
		return model
	end
	diner("78,-128", 1, { action = "eat", held = "spoon", armR = 55, armL = 45, hat = nil, seed = 1 })
	diner("78,-128", 4, { action = "drink", held = "glass", armR = 45, armL = 45, hat = "kerchief", seed = 2 })
	diner("78,-118", 1, { action = "eat", held = "spoon", armR = 55, armL = 45, seed = 3 })
	diner("78,-118", 2, { action = "eat", held = "spoon", armR = 55, armL = 45, seed = 4 })
	diner("78,-118", 3, { action = "drink", held = "mug", armR = 45, armL = 40, seed = 5 })
	diner("88,-118", 2, { action = "eat", held = "spoon", armR = 55, armL = 45, hat = "kerchief", seed = 6 })
	diner("88,-118", 4, { action = "read", held = "papers", armR = 70, armL = 60, seed = 7 })
	diner("78,-92", 2, { action = "eat", held = "spoon", armR = 55, armL = 45, seed = 8 })
	diner("78,-92", 3, { action = "drink", held = "glass", armR = 45, armL = 45, seed = 9 })
	diner("88,-92", 1, { action = "eat", held = "spoon", armR = 55, armL = 45, coat = rgb(80, 80, 76), seed = 10 })
	diner("88,-82", 3, { action = "drink", held = "mug", armR = 45, armL = 40, hat = "kerchief", seed = 11 })
	diner("88,-82", 4, { action = "eat", held = "spoon", armR = 55, armL = 45, seed = 12 })

	-- Your place: a tray of shchi waiting at the corner table.
	local mine = tables["88,-128"][2]
	local tray = block(m, "Your tray", Vector3.new(1.8, 0.1, 1.4), mine.plate + Vector3.new(0, -0.05, 0), rgb(150, 120, 90), Enum.Material.SmoothPlastic)
	plate(m, mine.plate + Vector3.new(-0.3, 0.05, 0), rgb(170, 60, 40))
	glass(m, mine.plate + Vector3.new(0.6, 0.05, 0.3), rgb(160, 70, 60))
	detail(block(m, "Your bread", Vector3.new(0.6, 0.15, 0.4), mine.plate + Vector3.new(0.5, 0.12, -0.35), rgb(150, 100, 60), Enum.Material.Sand))
	Build.interact(tray, "eat", "Eat your shchi", "Your table", 6).MaxActivationDistance = 7

	-- The memo, under an abandoned tray in the far corner.
	Build.note(m, 5, CFrame.new(77.4, 3.46, -82.3) * CFrame.Angles(0, 0.5, 0))

	-- Two men at a standing table by the window.
	block(m, "Standing table top", Vector3.new(3, 0.3, 3), Vector3.new(74, 4.2, -86), rgb(170, 186, 190), Enum.Material.SmoothPlastic)
	detail(block(m, "Standing table leg", Vector3.new(0.4, 3.8, 0.4), Vector3.new(74, 2.3, -86), rgb(80, 80, 80), Enum.Material.Metal))
	glass(m, Vector3.new(74.4, 4.35, -86.3), rgb(200, 190, 160))
	show(Figure.build(m, CFrame.lookAt(Vector3.new(74, 0.4, -88.4), Vector3.new(74, 0.4, -86)), { action = "drink", held = "glass", armR = 60, armL = 10, name = "Diner", seed = 13 }))
	show(Figure.build(m, CFrame.lookAt(Vector3.new(74, 0.4, -83.6), Vector3.new(74, 0.4, -86)), { action = "smoke", held = "cigarette", armR = 20, armL = 10, name = "Diner", seed = 14 }))

	-- People in the queue and the staff.
	show(Figure.build(m, CFrame.lookAt(Vector3.new(97.5, 0.4, -95), Vector3.new(97.5, 0.4, -90)), { action = "idle", held = "papers", armR = 75, armL = 75, hat = "ushanka", name = "Queue", seed = 15 }))
	show(Figure.build(m, CFrame.lookAt(Vector3.new(97.5, 0.4, -99), Vector3.new(97.5, 0.4, -94)), { action = "idle", armR = 5, armL = 5, hat = "kerchief", name = "Queue", seed = 16 }))
	show(Figure.build(m, CFrame.lookAt(Vector3.new(105, 0.4, -89), Vector3.new(100, 0.4, -89)), { action = "idle", armR = 40, armL = 30, hat = "chef", coat = rgb(230, 230, 224), name = "Cashier", seed = 17 }))
	show(Figure.build(m, CFrame.lookAt(Vector3.new(104.2, 0.4, -115), Vector3.new(110, 0.4, -115)), { action = "stir", held = "ladle", armR = 80, armL = 20, hat = "chef", coat = rgb(232, 232, 226), name = "Cook", seed = 18 }))

	return spots
end

return Canteen
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000009"><Properties><string name="Name">Game</string><ProtectedString name="Source"><![CDATA[-- Norilsk: Last Shift. Server: builds the world and walks each player through the shift.
-- The entity itself runs on each player's client (it hunts every player separately);
-- the server decides stages, checkpoints and what happens when it catches you.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Town = require(script.Parent.Town)
local Mine = require(script.Parent.Mine)
local Canteen = require(script.Parent.Canteen)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local fxRemote = Instance.new("RemoteEvent")
fxRemote.Name = "Fx"
fxRemote.Parent = remotes
local caughtRemote = Instance.new("RemoteEvent")
caughtRemote.Name = "Caught"
caughtRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

-- Build the world. Clear the default baseplate if the place has one.
for _, name in { "Baseplate", "SpawnLocation" } do
	local old = workspace:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end
local world = Instance.new("Folder")
world.Name = "Norilsk"
world.Parent = workspace
local spots = {}
for _, builder in { Town, Mine, Canteen } do
	for k, v in builder.build(world) do
		spots[k] = v
	end
end
local ready = Instance.new("BoolValue")
ready.Name = "WorldReady"
ready.Value = true
ready.Parent = ReplicatedStorage

Players.RespawnTime = 2

local states = {}

local function fx(player, kind, ...)
	fxRemote:FireClient(player, kind, ...)
end

local function root(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function teleport(player, cf)
	local character = player.Character
	local r = root(player)
	if character and r and cf then
		character:PivotTo(cf)
		r.AssemblyLinearVelocity = Vector3.zero
	end
end

local function spotFor(stage)
	return spots[Config.Stages[stage].spot] or spots.aptStart
end

local function setStage(player, stage)
	local st = states[player]
	if not st then
		return
	end
	st.stage = stage
	player:SetAttribute("Stage", stage)
end

local function clearProgress(player, st)
	st.seams = {}
	player:SetAttribute("SeamCount", 0)
	player:SetAttribute("SeamsDone", "")
	player:SetAttribute("HasLamp", false)
end

-- Fade to black with a line of text, move the player, then fade back in.
local function transition(player, text, cf, nextStage, hold)
	local st = states[player]
	if not st or st.busy then
		return
	end
	st.busy = true
	fx(player, "fade", text, hold or 2)
	task.wait(0.9)
	if states[player] ~= st then
		return
	end
	if cf then
		teleport(player, cf)
	end
	if nextStage then
		setStage(player, nextStage)
	end
	task.wait(hold or 2)
	st.busy = false
end

local function list(set)
	local out = {}
	for k in set do
		table.insert(out, tostring(k))
	end
	return table.concat(out, ",")
end

local actions = {}

actions.leaveHome = function(player, st)
	if st.stage == 1 then
		transition(player, "06:10. Минус сорок один.\nThe stairwell smells of cabbage and frost.", spots.homeDoorOut, 2, 2.5)
	elseif st.stage == Config.FinalStage then
		fx(player, "say", "Not again. Not tonight.")
	end
end

actions.clockIn = function(player, st)
	if st.stage == 2 then
		setStage(player, 3)
		fx(player, "say", "The time clock bites your card. 06:31. The watchman does not look up.")
	end
end

actions.lamp = function(player, st)
	if st.stage == 3 then
		setStage(player, 4)
		player:SetAttribute("HasLamp", true)
		fx(player, "say", "Lamp No. 116. The attendant won't let go of it for a moment. \"Bring it back,\" she says.")
	end
end

actions.cageDown = function(player, st)
	if st.stage == 4 then
		transition(player, "The cage drops for four minutes.\nHorizon −300.", spots.ugLanding, 5, 2.5)
	elseif st.stage < 4 then
		fx(player, "say", "Not without a lamp. Check in, then get your lamp.")
	end
end

actions.seam = function(player, st, prompt)
	if st.stage ~= 5 then
		return
	end
	local n = prompt:GetAttribute("Seam")
	if not n or st.seams[n] then
		return
	end
	st.seams[n] = true
	local count = 0
	for _ in st.seams do
		count += 1
	end
	player:SetAttribute("SeamsDone", list(st.seams))
	player:SetAttribute("SeamCount", count)
	if count >= Config.SeamCount then
		fx(player, "say", "The quota is met. Somewhere behind you, the lamps begin to go out.")
		task.delay(1.5, function()
			if states[player] == st and st.stage == 5 then
				setStage(player, 6)
			end
		end)
	else
		fx(player, "say", ("Seam %d done. %d of %d."):format(n, count, Config.SeamCount))
	end
end

actions.cageUp = function(player, st)
	if st.stage == 6 then
		transition(player, "The cage rises out of the dark.\n18:20. The shift is over.", spots.cageTop, 7, 2.5)
	elseif st.stage == 5 then
		fx(player, "say", "Not until the quota is met. Five seams.")
	end
end

actions.coupon = function(player, st)
	if st.stage == 7 then
		setStage(player, 8)
		fx(player, "say", "The cashier tears your coupon without a word. Your tray is at the corner table by the wall.")
	end
end

actions.eat = function(player, st)
	if st.stage == 8 then
		transition(player, "You eat slowly. Too slowly.\nWhen you look up, the clock says 23:10.\nEveryone is gone.", nil, 9, 3.5)
	end
end

actions.unlock = function(player, st)
	if st.stage ~= 9 then
		if st.stage < 9 and st.stage > 1 then
			fx(player, "say", "Home is for tonight. The shift comes first.")
		end
		return
	end
	transition(player, "", spots.aptEnd, Config.FinalStage, 0.5)
	fx(player, "ending")
	task.delay(45, function()
		if states[player] == st and st.stage == Config.FinalStage then
			clearProgress(player, st)
			st.day += 1
			player:SetAttribute("Day", st.day)
			transition(player, ("Day %d.\nThe alarm rings at 05:50."):format(st.day), spots.aptStart, 1, 2.5)
		end
	end)
end

actions.note = function(player, st, prompt)
	local id = prompt:GetAttribute("NoteId")
	if not id or not Config.Notes[id] then
		return
	end
	if not st.notes[id] then
		st.notes[id] = true
		local count = 0
		for _ in st.notes do
			count += 1
		end
		player:SetAttribute("NotesFound", list(st.notes))
		player:SetAttribute("NoteCount", count)
	end
	fx(player, "note", id)
end

local function wire(prompt)
	prompt.Triggered:Connect(function(player)
		local st = states[player]
		local r = root(player)
		local part = prompt.Parent
		if not st or st.busy or not r or not part:IsA("BasePart") then
			return
		end
		if (r.Position - part.Position).Magnitude > prompt.MaxActivationDistance + 8 then
			return
		end
		local handler = actions[prompt:GetAttribute("Action")]
		if handler then
			handler(player, st, prompt)
		end
	end)
end
for _, prompt in CollectionService:GetTagged("StagePrompt") do
	wire(prompt)
end

caughtRemote.OnServerEvent:Connect(function(player)
	local st = states[player]
	if not st or st.busy then
		return
	end
	local threat = Config.Stages[st.stage].threat
	if threat ~= "hunt" and threat ~= "mineHunt" then
		return
	end
	if os.clock() - st.lastCaught < 5 then
		return
	end
	st.lastCaught = os.clock()
	st.busy = true
	task.wait(2.6)
	if states[player] ~= st then
		return
	end
	teleport(player, spotFor(st.stage))
	fx(player, "respawn")
	st.busy = false
end)

local function onCharacter(player, character)
	local st = states[player]
	local humanoid = character:WaitForChild("Humanoid")
	character:WaitForChild("HumanoidRootPart")
	humanoid.WalkSpeed = Config.WalkSpeed
	task.wait()
	if st and states[player] == st then
		st.busy = false
		teleport(player, spotFor(st.stage))
		fx(player, "respawn")
	end
end

Players.PlayerAdded:Connect(function(player)
	local st = { stage = 1, seams = {}, notes = {}, busy = false, lastCaught = 0, day = 1 }
	states[player] = st
	clearProgress(player, st)
	player:SetAttribute("Stage", 1)
	player:SetAttribute("Day", 1)
	player:SetAttribute("NoteCount", 0)
	player:SetAttribute("NotesFound", "")
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	-- Testing shortcut in Studio: type "/stage 9" in chat.
	if RunService:IsStudio() then
		player.Chatted:Connect(function(message)
			local n = tonumber(message:match("^/stage%s+(%d+)"))
			if n and Config.Stages[n] then
				st.busy = false
				if n >= 6 then
					for i = 1, Config.SeamCount do
						st.seams[i] = true
					end
					player:SetAttribute("SeamsDone", list(st.seams))
					player:SetAttribute("SeamCount", Config.SeamCount)
				else
					clearProgress(player, st)
				end
				player:SetAttribute("HasLamp", n >= 4)
				setStage(player, n)
				teleport(player, spotFor(n))
				fx(player, "respawn")
			end
		end)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Mine</string><ProtectedString name="Source"><![CDATA[-- Mine No. 6: the fenced yard, checkpoint, lamp room, cage house, headframe and plant on
-- the surface, and horizon -300 underground: drifts, crosscuts, stopes and the sealed
-- Norillag gallery.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Build)
local Figure = require(Shared.Figure)
local Config = require(Shared.Config)

local rgb = Build.rgb
local block, wedge, detail = Build.block, Build.wedge, Build.detail

local Mine = {}

local SNOW = rgb(222, 228, 234)
local STEEL = rgb(70, 72, 74)
local rng = Random.new(6)

local function face(pos, dir)
	return CFrame.lookAt(pos, pos + dir)
end

local function show(model, from, to)
	model:SetAttribute("ShowFrom", from)
	model:SetAttribute("ShowTo", to)
	Build.tag(model, "StagedPerson")
	return model
end

local function fluorescent(parent, at, length)
	local tube = detail(block(parent, "Fluorescent tube", Vector3.new(length or 5, 0.3, 0.7), at, rgb(220, 236, 226), Enum.Material.Neon))
	Build.surfaceLight(tube, Enum.NormalId.Bottom, rgb(214, 232, 220), 18, 1.1, 150)
	return tube
end

-- A box room built from walls with gaps. gaps = { north = {...}, south = ..., east = ..., west = ... }
-- Gap positions run west→east on north/south walls and north→south on east/west walls.
local function room(parent, center, sx, sz, h, gaps, wallColor, material, opts)
	opts = opts or {}
	local x0, x1 = center.X - sx / 2, center.X + sx / 2
	local z0, z1 = center.Z - sz / 2, center.Z + sz / 2
	local y = center.Y
	local t = opts.thickness or 1
	local walls = {}
	-- East/west walls run past the corners, so shift their gaps by the wall thickness.
	local function shifted(list)
		local out = {}
		for _, g in list or {} do
			table.insert(out, { at = g.at + t, width = g.width, bottom = g.bottom, top = g.top })
		end
		return out
	end
	local function add(list)
		for _, p in list do
			table.insert(walls, p)
		end
	end
	add(Build.wall(parent, Vector3.new(x0, y, z0), Vector3.new(x1, y, z0), Vector3.new(0, 0, -1), h, t, gaps.north, wallColor, material))
	add(Build.wall(parent, Vector3.new(x0, y, z1), Vector3.new(x1, y, z1), Vector3.new(0, 0, 1), h, t, gaps.south, wallColor, material))
	add(Build.wall(parent, Vector3.new(x0, y, z0 - t), Vector3.new(x0, y, z1 + t), Vector3.new(-1, 0, 0), h, t, shifted(gaps.west), wallColor, material))
	add(Build.wall(parent, Vector3.new(x1, y, z0 - t), Vector3.new(x1, y, z1 + t), Vector3.new(1, 0, 0), h, t, shifted(gaps.east), wallColor, material))
	if not opts.noFloor then
		block(parent, "Floor", Vector3.new(sx, 0.4, sz), Vector3.new(center.X, y + 0.2, center.Z), opts.floorColor or rgb(120, 116, 108), opts.floorMaterial or Enum.Material.Concrete)
	end
	if not opts.noRoof then
		block(parent, "Roof", Vector3.new(sx + t * 2 + 0.6, 1, sz + t * 2 + 0.6), Vector3.new(center.X, y + h + 0.5, center.Z), opts.roofColor or wallColor, material)
		if opts.snowRoof ~= false then
			detail(block(parent, "Roof snow", Vector3.new(sx + t * 2 + 0.4, 0.6, sz + t * 2 + 0.4), Vector3.new(center.X, y + h + 1.3, center.Z), SNOW, Enum.Material.Snow))
		end
	end
	return walls
end

local function cage(parent, base, facing, action, actionText)
	-- The mine cage: a steel box open at the front.
	local cf = face(base, facing)
	local plate = rgb(96, 98, 100)
	block(parent, "Cage floor", Vector3.new(8, 0.4, 8), cf * CFrame.new(0, 0.6, 0), plate, Enum.Material.DiamondPlate)
	block(parent, "Cage roof", Vector3.new(8, 0.4, 8), cf * CFrame.new(0, 9.8, 0), plate, Enum.Material.DiamondPlate)
	for _, x in { -4, 4 } do
		local side = block(parent, "Cage side", Vector3.new(0.2, 9, 8), cf * CFrame.new(x, 5.2, 0), plate, Enum.Material.DiamondPlate)
		side.Transparency = 0.15
	end
	local back = block(parent, "Cage back", Vector3.new(8, 9, 0.2), cf * CFrame.new(0, 5.2, 4), plate, Enum.Material.DiamondPlate)
	detail(block(parent, "Cage gate (open)", Vector3.new(8, 2, 0.15), cf * CFrame.new(0, 9, -4), STEEL, Enum.Material.Metal))
	local bulb = detail(Build.ball(parent, "Cage bulb", 0.6, cf * CFrame.new(0, 9.2, 0), rgb(255, 214, 160), Enum.Material.Neon))
	Build.light(bulb, rgb(255, 206, 150), 14, 0.8, true)
	local sign = detail(block(parent, "Cage sign", Vector3.new(4, 1.4, 0.1), cf * CFrame.new(0, 7.4, 3.85), rgb(230, 200, 60)))
	Build.sign(sign, Enum.NormalId.Front, "КЛЕТЬ · НЕ БОЛЕЕ 20 ЧЕЛ.", { bg = rgb(220, 190, 50), fg = rgb(20, 20, 20) })
	local bell = detail(block(parent, "Signal box", Vector3.new(1.2, 1.6, 0.6), cf * CFrame.new(2.6, 4.6, 3.6), rgb(150, 40, 30), Enum.Material.Metal))
	bell.CanQuery = true
	Build.interact(bell, action, actionText, "Signal bell", 1.5).MaxActivationDistance = 11
	return back
end

local function lampRack(parent, cf)
	block(parent, "Lamp rack", Vector3.new(1, 9, 6), cf * CFrame.new(0, 4.5, 0), rgb(70, 74, 70), Enum.Material.Metal)
	for level = 0, 3 do
		local y = 1.5 + level * 2
		detail(block(parent, "Rack shelf", Vector3.new(1.6, 0.15, 6), cf * CFrame.new(-0.8, y, 0), rgb(80, 84, 80), Enum.Material.Metal))
		for k = 0, 4 do
			local slot = cf * CFrame.new(-0.9, y + 0.55, -2.4 + k * 1.2)
			local number = 100 + level * 5 + k
			if number == 117 then
				local tag = detail(block(parent, "Empty slot", Vector3.new(0.05, 0.5, 0.8), slot * CFrame.new(-0.6, 0, 0), rgb(30, 30, 30)))
				Build.sign(tag, Enum.NormalId.Left, "117", { bg = rgb(30, 30, 30), fg = rgb(200, 40, 30), font = Enum.Font.Code })
				continue
			end
			detail(block(parent, "Lamp battery", Vector3.new(0.5, 0.9, 0.4), slot, rgb(40, 40, 40), Enum.Material.SmoothPlastic))
			detail(Build.cylinder(parent, "Lamp head", 0.3, 0.5, slot * CFrame.new(-0.1, 0.6, 0), rgb(150, 150, 140), Enum.Material.Metal))
			detail(block(parent, "Charge light", Vector3.new(0.08, 0.12, 0.12), slot * CFrame.new(-0.27, 0.2, 0), rng:NextNumber() < 0.8 and rgb(60, 255, 80) or rgb(255, 60, 40), Enum.Material.Neon))
		end
	end
end

local function belaz(parent, cf)
	local yellow = rgb(180, 150, 50)
	block(parent, "BelAZ chassis", Vector3.new(10, 3, 22), cf * CFrame.new(0, 4.5, 0), rgb(40, 40, 40), Enum.Material.Metal)
	block(parent, "BelAZ dump body", Vector3.new(11, 6, 15), cf * CFrame.new(0, 9, 3), yellow, Enum.Material.CorrodedMetal)
	detail(block(parent, "Ore load", Vector3.new(10, 1, 13), cf * CFrame.new(0, 12.3, 3), rgb(60, 54, 46), Enum.Material.Slate))
	detail(block(parent, "Load snow", Vector3.new(9.6, 0.5, 12.6), cf * CFrame.new(0, 12.9, 3), SNOW, Enum.Material.Snow))
	block(parent, "BelAZ cab", Vector3.new(4.5, 4, 4.5), cf * CFrame.new(-2.5, 8, -8.5), yellow, Enum.Material.CorrodedMetal)
	detail(block(parent, "Cab window", Vector3.new(4, 1.8, 0.1), cf * CFrame.new(-2.5, 8.6, -10.8), rgb(30, 36, 40), Enum.Material.Glass))
	for _, x in { -5.5, 5.5 } do
		for _, z in { -7, 7 } do
			detail(Build.cylinder(parent, "BelAZ tyre", 3, 7, cf * CFrame.new(x, 3.5, z), rgb(24, 24, 24), Enum.Material.Rubber))
		end
	end
	local plate = detail(block(parent, "BelAZ badge", Vector3.new(3, 0.8, 0.1), cf * CFrame.new(2, 5, -11.05) * CFrame.Angles(0, math.pi, 0), rgb(40, 40, 40)))
	Build.sign(plate, Enum.NormalId.Front, "БелАЗ", { bg = rgb(40, 40, 40), fg = rgb(220, 200, 90) })
end

local function uaz(parent, cf)
	local khaki = rgb(82, 92, 66)
	block(parent, "UAZ body", Vector3.new(5, 2.4, 10), cf * CFrame.new(0, 2.2, 0), khaki, Enum.Material.SmoothPlastic)
	block(parent, "UAZ cabin", Vector3.new(4.8, 2.6, 6.5), cf * CFrame.new(0, 4.6, 1), khaki, Enum.Material.Fabric)
	detail(block(parent, "UAZ snow", Vector3.new(4.6, 0.5, 6.3), cf * CFrame.new(0, 6.1, 1), SNOW, Enum.Material.Snow))
	detail(block(parent, "UAZ windscreen", Vector3.new(4.4, 1.6, 0.1), cf * CFrame.new(0, 4.8, -2.3), rgb(30, 36, 40), Enum.Material.Glass))
	for _, x in { -2.5, 2.5 } do
		for _, z in { -3.4, 3.4 } do
			detail(Build.cylinder(parent, "UAZ wheel", 1, 2.6, cf * CFrame.new(x, 1.3, z), rgb(24, 24, 24), Enum.Material.Rubber))
		end
	end
end

local function smokestack(parent, base, height)
	local stack = Build.column(parent, "Smokestack", height, 9, base, rgb(110, 104, 98))
	for _, y in { height - 6, height - 18 } do
		detail(Build.column(parent, "Stack band", 4, 9.3, base + Vector3.new(0, y, 0), rgb(170, 40, 34)))
	end
	for _, y in { height + 0.5, height * 0.6 } do
		local beacon = detail(Build.ball(parent, "Aircraft warning light", 1.2, base + Vector3.new(4.7, y, 0), rgb(255, 40, 30), Enum.Material.Neon))
		Build.light(beacon, rgb(255, 40, 30), 22, 1.2)
		Build.tag(beacon, "Beacon")
	end
	local top = detail(block(parent, "Stack smoke", Vector3.new(6, 1, 6), base + Vector3.new(0, height + 1, 0), rgb(0, 0, 0)))
	top.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Rate = 5
	e.Lifetime = NumberRange.new(10, 16)
	e.Speed = NumberRange.new(3, 5)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 30) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(rgb(70, 66, 62))
	e.Acceleration = Vector3.new(4, 0.5, 1)
	e.EmissionDirection = Enum.NormalId.Top
	e.LightInfluence = 0.6
	e.Parent = top
	return stack
end

local function floodMast(parent, base, target)
	block(parent, "Floodlight mast", Vector3.new(0.9, 26, 0.9), base + Vector3.new(0, 13, 0), STEEL, Enum.Material.Metal)
	local head = detail(block(parent, "Floodlight", Vector3.new(2.2, 1.4, 1), CFrame.lookAt(base + Vector3.new(0, 26, 0), target), rgb(255, 236, 200), Enum.Material.Neon))
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Angle = 70
	spot.Range = 60
	spot.Brightness = 1.6
	spot.Color = rgb(255, 226, 180)
	spot.Shadows = true
	spot.Parent = head
	Build.tag(head, "Floodlight")
end

local function surface(folder, spots)
	-- Yard surface.
	block(folder, "Yard", Vector3.new(250, 0.2, 160), Vector3.new(0, 0.1, -280), rgb(170, 174, 178), Enum.Material.Snow)

	-- Concrete fence (the classic diamond-pattern panels) with barbed wire.
	local function fenceRun(x0, x1)
		for x = x0, x1 - 6, 6 do
			local p = block(folder, "Fence panel", Vector3.new(5.9, 7, 0.6), Vector3.new(x + 3, 3.5, -200), rgb(150, 148, 140))
			local gui = Instance.new("SurfaceGui")
			gui.Face = Enum.NormalId.Back
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 20
			gui.Parent = p
			for i = 0, 3 do
				local d = Instance.new("Frame")
				d.AnchorPoint = Vector2.new(0.5, 0.5)
				d.Position = UDim2.fromScale(0.125 + i * 0.25, 0.5)
				d.Size = UDim2.fromOffset(18, 18)
				d.Rotation = 45
				d.BackgroundColor3 = rgb(126, 124, 118)
				d.BorderSizePixel = 0
				d.Parent = gui
			end
		end
		detail(Build.beam(folder, "Barbed wire", Vector3.new(x0, 7.4, -200), Vector3.new(x1, 7.4, -200), 0.1, rgb(60, 56, 50), Enum.Material.CorrodedMetal))
		detail(Build.beam(folder, "Barbed wire", Vector3.new(x0, 7.9, -200), Vector3.new(x1, 7.9, -200), 0.1, rgb(60, 56, 50), Enum.Material.CorrodedMetal))
	end
	fenceRun(-130, -14)
	fenceRun(26, 132)

	-- Gate arch.
	for _, x in { -15, 15 } do
		block(folder, "Gate pillar", Vector3.new(2, 13, 2), Vector3.new(x, 6.5, -200), rgb(150, 146, 138))
	end
	local beam = block(folder, "Gate beam", Vector3.new(32, 3, 1.2), Vector3.new(0, 14.5, -200), rgb(140, 30, 28))
	Build.sign(beam, Enum.NormalId.Back, "ШАХТА № 6 · СЛАВА ШАХТЁРСКОМУ ТРУДУ!", { bg = rgb(140, 30, 28), fg = rgb(250, 220, 120) })
	Build.sign(beam, Enum.NormalId.Front, "ПОКИДАЯ ШАХТУ — СДАЙ ЛАМПУ", { bg = rgb(140, 30, 28), fg = rgb(250, 220, 120) })
	local star = detail(block(folder, "Gate star", Vector3.new(4, 4, 0.2), Vector3.new(0, 18, -200), rgb(0, 0, 0)))
	star.Transparency = 1
	Build.sign(star, Enum.NormalId.Back, "★", { bgTransparency = 1, fg = rgb(255, 50, 40), lightInfluence = 0, brightness = 2, font = Enum.Font.GothamBlack })
	for _, x in { -1, 1 } do
		local leaf = block(folder, "Gate leaf", Vector3.new(12, 7, 0.3), CFrame.new(x * 14, 3.6, -200) * CFrame.Angles(0, -x * math.rad(80), 0) * CFrame.new(-x * 6, 0, 0), rgb(60, 80, 70), Enum.Material.CorrodedMetal)
		Build.sign(leaf, Enum.NormalId.Back, "★", { bg = rgb(60, 80, 70), fg = rgb(170, 40, 34), font = Enum.Font.GothamBlack })
	end
	spots.gate = CFrame.lookAt(Vector3.new(0, 3, -212), Vector3.new(0, 3, -260))

	-- Checkpoint booth with the watchman and the time clock.
	local booth = Instance.new("Model")
	booth.Name = "Checkpoint"
	booth.Parent = folder
	room(booth, Vector3.new(20, 0, -204), 10, 10, 8, {
		west = { { at = 5, width = 6, bottom = 3, top = 6.5 } },
	}, rgb(170, 166, 150), Enum.Material.Concrete)
	local glass = block(booth, "Booth window", Vector3.new(0.2, 3.5, 6), Vector3.new(14.6, 4.75, -204), rgb(150, 170, 160), Enum.Material.Glass)
	glass.Transparency = 0.5
	fluorescent(booth, Vector3.new(20, 7.6, -204), 3)
	local sign = detail(block(booth, "Booth sign", Vector3.new(0.1, 1.2, 6), Vector3.new(14.4, 7.3, -204), rgb(36, 56, 104)))
	Build.sign(sign, Enum.NormalId.Left, "ПРОХОДНАЯ", { bg = rgb(36, 56, 104), fg = rgb(240, 240, 230) })
	block(booth, "Booth desk", Vector3.new(2, 2.8, 6), Vector3.new(16.5, 1.4, -204), rgb(90, 66, 44), Enum.Material.Wood)
	show(Figure.build(booth, CFrame.lookAt(Vector3.new(19.5, 0.4, -204), Vector3.new(10, 0.4, -204)), { pose = "sit", hat = "cap", held = "papers", armR = 70, armL = 60, action = "read", coat = rgb(50, 60, 50), name = "Watchman" }), 1, 8)
	block(booth, "Watchman chair", Vector3.new(2, 1.9, 2), Vector3.new(19.6, 0.95, -204), rgb(80, 60, 40), Enum.Material.Wood)
	local clock = block(booth, "Time clock", Vector3.new(0.8, 2.2, 1.6), Vector3.new(14.1, 4, -208), rgb(130, 120, 100), Enum.Material.Metal)
	Build.sign(clock, Enum.NormalId.Left, "ТАБЕЛЬ\n06:31", { bg = rgb(200, 190, 160), fg = rgb(20, 20, 20), font = Enum.Font.Code })
	local cards = detail(block(booth, "Card rack", Vector3.new(0.4, 2.4, 2.2), Vector3.new(14.3, 4, -201), rgb(90, 66, 44), Enum.Material.Wood))
	Build.sign(cards, Enum.NormalId.Left, "▮▮▮▮▮▮\n▮▮▮▮▮▮\n▮▮▮▮ ▮", { bg = rgb(90, 66, 44), fg = rgb(220, 210, 180), font = Enum.Font.Code })
	Build.interact(clock, "clockIn", "Punch your time card", "Time clock", 1).MaxActivationDistance = 10

	-- Lamp room.
	local lamps = Instance.new("Model")
	lamps.Name = "Lamp room"
	lamps.Parent = folder
	room(lamps, Vector3.new(-40, 0, -235), 30, 20, 12, {
		east = { { at = 10, width = 5, top = 7.5 } },
		north = { { at = 8, width = 4, bottom = 5, top = 9 }, { at = 22, width = 4, bottom = 5, top = 9 } },
	}, rgb(160, 150, 120), Enum.Material.Concrete)
	for _, x in { -48, -34 } do
		local w = detail(block(lamps, "Lamp room window", Vector3.new(4, 4, 0.2), Vector3.new(x, 7, -245.5), rgb(160, 150, 100), Enum.Material.Neon))
		w.Transparency = 0.3
	end
	local nameplate = detail(block(lamps, "Lamp room sign", Vector3.new(0.1, 1.4, 8), Vector3.new(-23.9, 9, -235), rgb(36, 56, 104)))
	Build.sign(nameplate, Enum.NormalId.Right, "ЛАМПОВАЯ", { bg = rgb(36, 56, 104), fg = rgb(240, 240, 230) })
	Build.poster(lamps, face(Vector3.new(-23.9, 5.5, -242), Vector3.xAxis), Config.Posters[5])
	block(lamps, "Counter", Vector3.new(2, 3.4, 18), Vector3.new(-37, 1.9, -235), rgb(100, 76, 50), Enum.Material.Wood)
	block(lamps, "Counter top", Vector3.new(2.4, 0.2, 18), Vector3.new(-37, 3.7, -235), rgb(130, 100, 70), Enum.Material.Wood)
	local hatch = detail(block(lamps, "Hatch sign", Vector3.new(0.1, 1.2, 6), Vector3.new(-37.5, 9, -235), rgb(220, 200, 60)))
	Build.sign(hatch, Enum.NormalId.Right, "ВЫДАЧА ЛАМП", { bg = rgb(220, 196, 60), fg = rgb(20, 20, 20) })
	detail(block(lamps, "Hatch frame", Vector3.new(0.6, 0.6, 18), Vector3.new(-37.5, 8.1, -235), rgb(100, 76, 50), Enum.Material.Wood))
	local issue = detail(block(lamps, "Issued lamp", Vector3.new(0.6, 1, 0.5), Vector3.new(-36.6, 4.3, -234), rgb(40, 40, 40), Enum.Material.SmoothPlastic))
	issue.CanQuery = true
	detail(Build.cylinder(lamps, "Issued lamp head", 0.3, 0.6, CFrame.new(-36.6, 5, -234), rgb(160, 160, 150), Enum.Material.Metal))
	Build.interact(issue, "lamp", "Take lamp No. 116", "Lamp counter", 1)
	Build.note(lamps, 3, CFrame.new(-36.8, 3.83, -239) * CFrame.Angles(0, 0.4, 0))
	for _, z in { -242, -235, -228 } do
		lampRack(lamps, CFrame.new(-53.5, 0.4, z))
	end
	fluorescent(lamps, Vector3.new(-45, 11.6, -235), 6)
	fluorescent(lamps, Vector3.new(-31, 11.6, -235), 6)
	show(Figure.build(lamps, CFrame.lookAt(Vector3.new(-40, 0.4, -234), Vector3.new(-30, 0.4, -234)), { hat = "kerchief", armR = 30, armL = 10, action = "idle", coat = rgb(70, 80, 100), name = "Lamp attendant" }), 1, 8)

	-- Cage house and headframe.
	local house = Instance.new("Model")
	house.Name = "Cage house"
	house.Parent = folder
	room(house, Vector3.new(0, 0, -280), 26, 24, 16, {
		south = { { at = 13, width = 8, top = 9 } },
		east = { { at = 10, width = 4, bottom = 9, top = 13 } },
	}, rgb(120, 112, 100), Enum.Material.Brick)
	cage(house, Vector3.new(0, 0, -286), Vector3.new(0, 0, 1), "cageDown", "Ring for the cage")
	fluorescent(house, Vector3.new(0, 15.6, -276), 6)
	local hs = detail(block(house, "Cage house sign", Vector3.new(10, 1.6, 0.1), Vector3.new(0, 11, -266.9), rgb(140, 30, 28)))
	Build.sign(hs, Enum.NormalId.Back, "КОПЁР · СТВОЛ № 1", { bg = rgb(140, 30, 28), fg = rgb(250, 220, 120) })
	Build.poster(house, face(Vector3.new(-9, 6, -266.9), Vector3.zAxis), Config.Posters[2])
	local board = detail(block(house, "Shift board", Vector3.new(6, 4, 0.2), Vector3.new(-8, 5, -291.85), rgb(30, 40, 30)))
	Build.sign(board, Enum.NormalId.Back, "СМЕНА № 1\nГоризонт −300\nНорма: 5 забоев на человека\nТ/Б: каска, лампа, самоспасатель", { bg = rgb(34, 48, 36), fg = rgb(230, 230, 220), font = Enum.Font.Code, padding = 0.05 })
	block(house, "Bench", Vector3.new(1.6, 2.2, 8), Vector3.new(11.5, 1.1, -278), rgb(90, 66, 44), Enum.Material.Wood)
	spots.cageTop = CFrame.lookAt(Vector3.new(0, 3, -262), Vector3.new(0, 3, -220))

	-- Miners waiting for the cage in the morning.
	show(Figure.build(house, CFrame.lookAt(Vector3.new(-6, 0.4, -276), Vector3.new(-2, 0.4, -284)), { hat = "helmet", armR = 10, armL = 5, action = "idle", name = "Miner" }), 1, 4)
	show(Figure.build(house, CFrame.lookAt(Vector3.new(6, 0.4, -274), Vector3.new(2, 0.4, -280)), { hat = "helmet", held = "cigarette", armR = 20, action = "smoke", name = "Miner" }), 1, 4)
	show(Figure.build(house, CFrame.lookAt(Vector3.new(11.5, 0.4, -281), Vector3.new(4, 0.4, -281)), { pose = "sit", seatHeight = 1.8, hat = "helmet", armR = 40, armL = 40, action = "idle", name = "Miner" }), 1, 4)
	show(Figure.build(folder, CFrame.lookAt(Vector3.new(-14, 0.2, -262), Vector3.new(-10, 0.2, -258)), { hat = "ushanka", held = "cigarette", armR = 20, action = "smoke", name = "Miner" }), 1, 4)
	show(Figure.build(folder, CFrame.lookAt(Vector3.new(-10, 0.2, -259), Vector3.new(-14, 0.2, -262)), { hat = "ushanka", armR = 5, action = "idle", name = "Miner" }), 1, 4)
	-- A tired pair in the evening.
	show(Figure.build(folder, CFrame.lookAt(Vector3.new(12, 0.2, -258), Vector3.new(16, 0.2, -262)), { hat = "ushanka", held = "cigarette", armR = 20, action = "smoke", name = "Miner" }), 7, 8)

	local steel = rgb(60, 64, 66)
	local legs = {
		{ Vector3.new(-12, 17, -268), Vector3.new(-4, 62, -276) },
		{ Vector3.new(12, 17, -268), Vector3.new(4, 62, -276) },
		{ Vector3.new(-12, 17, -292), Vector3.new(-4, 62, -284) },
		{ Vector3.new(12, 17, -292), Vector3.new(4, 62, -284) },
	}
	for _, l in legs do
		Build.beam(folder, "Headframe leg", l[1], l[2], 1.2, steel, Enum.Material.CorrodedMetal)
	end
	for k = 1, 4 do
		local t0, t1 = (k - 1) / 4, k / 4
		for i, l in legs do
			local other = legs[i % 4 + 1]
			local a = l[1]:Lerp(l[2], t0)
			local b = other[1]:Lerp(other[2], t1)
			detail(Build.beam(folder, "Headframe brace", a, b, 0.4, steel, Enum.Material.CorrodedMetal))
		end
	end
	block(folder, "Headframe deck", Vector3.new(12, 1, 12), Vector3.new(0, 62, -280), steel, Enum.Material.DiamondPlate)
	for _, x in { -3.5, 3.5 } do
		local wheel = Build.cylinder(folder, "Sheave wheel", 0.8, 12, CFrame.new(x, 67, -280), rgb(80, 40, 36), Enum.Material.CorrodedMetal)
		detail(wheel)
		detail(Build.cylinder(folder, "Sheave hub", 1.2, 2, CFrame.new(x, 67, -280), steel, Enum.Material.Metal))
		Build.tag(wheel, "Sheave")
		Build.beam(folder, "Hoist cable", Vector3.new(x, 67, -286), Vector3.new(x * 0.6, 16, -336), 0.25, rgb(30, 30, 30), Enum.Material.Metal)
		detail(Build.beam(folder, "Shaft cable", Vector3.new(x, 61, -274), Vector3.new(x, 16, -274), 0.25, rgb(30, 30, 30), Enum.Material.Metal))
	end
	local bigStar = detail(block(folder, "Headframe star", Vector3.new(8, 8, 0.3), Vector3.new(0, 78, -280), rgb(0, 0, 0)))
	bigStar.Transparency = 1
	for _, f in { Enum.NormalId.Front, Enum.NormalId.Back } do
		Build.sign(bigStar, f, "★", { bgTransparency = 1, fg = rgb(255, 40, 30), lightInfluence = 0, brightness = 3, font = Enum.Font.GothamBlack })
	end
	local starGlow = detail(Build.ball(folder, "Star glow", 0.5, Vector3.new(0, 78, -279), rgb(255, 40, 30), Enum.Material.Neon))
	Build.light(starGlow, rgb(255, 40, 30), 26, 1.4)
	Build.tag(starGlow, "Beacon")

	-- Hoist house.
	block(folder, "Hoist house", Vector3.new(30, 18, 20), Vector3.new(0, 9, -346), rgb(130, 120, 108), Enum.Material.Brick)
	detail(block(folder, "Hoist house snow", Vector3.new(30.4, 0.6, 20.4), Vector3.new(0, 18.3, -346), SNOW, Enum.Material.Snow))
	for _, x in { -9, 0, 9 } do
		detail(block(folder, "Hoist window", Vector3.new(5, 6, 0.2), Vector3.new(x, 10, -335.9), rgb(150, 140, 96), Enum.Material.Neon))
	end

	-- Concentrator plant and smokestacks.
	block(folder, "Concentrator", Vector3.new(60, 42, 70), Vector3.new(80, 21, -300), rgb(108, 102, 96))
	detail(block(folder, "Concentrator snow", Vector3.new(60.4, 0.6, 70.4), Vector3.new(80, 42.3, -300), SNOW, Enum.Material.Snow))
	for y = 6, 36, 10 do
		for z = -330, -270, 8 do
			local lit = rng:NextNumber() < 0.25
			detail(block(folder, "Plant window", Vector3.new(0.2, 4, 5), Vector3.new(49.9, y, z), lit and rgb(150, 130, 80) or rgb(24, 28, 30), lit and Enum.Material.Neon or Enum.Material.Glass))
		end
	end
	local banner = detail(block(folder, "Plant banner", Vector3.new(0.2, 5, 50), Vector3.new(49.8, 45, -300), rgb(140, 30, 28)))
	Build.sign(banner, Enum.NormalId.Left, "НОРИЛЬСКИЙ ГМК им. А. П. ЗАВЕНЯГИНА — РОДИНЕ!", { bg = rgb(140, 30, 28), fg = rgb(250, 220, 120) })
	for _, x in { 64, 82, 100 } do
		smokestack(folder, Vector3.new(x, 0, -360), 130)
	end
	Build.beam(folder, "Conveyor gallery", Vector3.new(13, 14, -282), Vector3.new(50, 32, -290), 4, rgb(120, 116, 104), Enum.Material.CorrodedMetal)
	for t = 0.25, 0.75, 0.25 do
		local p = Vector3.new(13, 14, -282):Lerp(Vector3.new(50, 32, -290), t)
		block(folder, "Gallery support", Vector3.new(1, p.Y, 1), Vector3.new(p.X, p.Y / 2, p.Z), steel, Enum.Material.Metal)
	end

	-- Yard dressing.
	floodMast(folder, Vector3.new(-30, 0, -258), Vector3.new(-10, 0, -240))
	floodMast(folder, Vector3.new(32, 0, -250), Vector3.new(10, 0, -260))
	floodMast(folder, Vector3.new(-20, 0, -318), Vector3.new(0, 0, -300))
	belaz(folder, CFrame.new(-75, 0, -290) * CFrame.Angles(0, 0.4, 0))
	uaz(folder, CFrame.new(38, 0, -216) * CFrame.Angles(0, -0.3, 0))
	for i = 0, 3 do
		wedge(folder, "Slag heap", Vector3.new(30, 18 + i * 3, 26), CFrame.new(-120 + i * 8, 9 + i * 1.5, -330 - i * 20) * CFrame.Angles(0, math.rad(i * 70), 0), rgb(46, 42, 40), Enum.Material.Slate)
	end
	local slogan = detail(block(folder, "Yard slogan", Vector3.new(24, 3, 0.4), Vector3.new(-60, 12, -201), rgb(140, 30, 28)))
	Build.sign(slogan, Enum.NormalId.Front, "ШАХТЁР! СОБЛЮДАЙ ТЕХНИКУ БЕЗОПАСНОСТИ!", { bg = rgb(140, 30, 28), fg = rgb(250, 220, 120) })
	for _, x in { -70, -50 } do
		block(folder, "Slogan post", Vector3.new(0.4, 12, 0.4), Vector3.new(x, 6, -201), STEEL, Enum.Material.Metal)
	end
end

-- Underground ----------------------------------------------------------------------------

local WALL = rgb(72, 66, 60)
local FLOOR = rgb(58, 52, 46)
local TIMBER = rgb(96, 70, 44)

local function lumps(parent, a, b, out, h, gaps)
	local dir = (b - a).Unit
	local length = (b - a).Magnitude
	for s = 2.5, length - 2.5, 4.5 do
		local skip = false
		for _, g in gaps or {} do
			if math.abs(s - g.at) < g.width / 2 + 1.5 then
				skip = true
			end
		end
		if not skip then
			local p = a + dir * s + out * rng:NextNumber(-0.2, 0.6) + Vector3.new(0, rng:NextNumber(0.5, h - 0.5), 0)
			local c = WALL:Lerp(rgb(40, 36, 32), rng:NextNumber(0, 0.6))
			detail(block(parent, "Rock", Vector3.new(rng:NextNumber(1.5, 3), rng:NextNumber(1.5, 4), rng:NextNumber(2, 5)), CFrame.new(p) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)), c, Enum.Material.Rock))
		end
	end
end

local function mineLamp(parent, at, order)
	detail(block(parent, "Lamp wire", Vector3.new(0.08, 0.8, 0.08), at + Vector3.new(0, 0.6, 0), rgb(20, 20, 20)))
	local bulb = detail(Build.ball(parent, "Mine lamp", 0.55, at, rgb(255, 206, 140), Enum.Material.Neon))
	Build.light(bulb, rgb(255, 196, 130), 22, 0.9, order % 2 == 0)
	bulb:SetAttribute("Order", order)
	Build.tag(bulb, "MineLamp")
	for _, r in { 0, math.pi / 2 } do
		detail(block(parent, "Lamp cage", Vector3.new(0.75, 0.75, 0.06), CFrame.new(at) * CFrame.Angles(0, r, 0), rgb(40, 40, 40), Enum.Material.Metal)).Transparency = 0.5
	end
end

-- A straight tunnel between two floor points (world). opts: gapsL/gapsR, rails, lamps, old, capEnd.
local function drift(parent, a, b, w, h, opts)
	opts = opts or {}
	local dir = (b - a).Unit
	local length = (b - a).Magnitude
	local left = Vector3.new(dir.Z, 0, -dir.X)
	local mid = (a + b) / 2
	local frame = CFrame.lookAt(mid, mid + dir)
	block(parent, "Drift floor", Vector3.new(w + 4, 1, length), frame * CFrame.new(0, -0.5, 0), FLOOR, Enum.Material.Ground)
	block(parent, "Drift roof", Vector3.new(w + 4, 2, length), frame * CFrame.new(0, h + 1, 0), WALL:Lerp(rgb(0, 0, 0), 0.2), Enum.Material.Slate)
	Build.wall(parent, a + left * (w / 2), b + left * (w / 2), left, h, 2, opts.gapsL, WALL, Enum.Material.Slate, "Rock wall")
	Build.wall(parent, a - left * (w / 2), b - left * (w / 2), -left, h, 2, opts.gapsR, WALL, Enum.Material.Slate, "Rock wall")
	lumps(parent, a + left * (w / 2), b + left * (w / 2), left, h, opts.gapsL)
	lumps(parent, a - left * (w / 2), b - left * (w / 2), -left, h, opts.gapsR)
	if opts.capEnd then
		block(parent, "Dead end", Vector3.new(w + 4, h, 2), CFrame.lookAt(b + dir + Vector3.new(0, h / 2, 0), b + dir * 2 + Vector3.new(0, h / 2, 0)), WALL, Enum.Material.Slate)
	end

	local function inGap(s)
		for _, list in { opts.gapsL or {}, opts.gapsR or {} } do
			for _, g in list do
				if math.abs(s - g.at) < g.width / 2 + 0.6 then
					return true
				end
			end
		end
		return false
	end

	-- Timber sets.
	local wood = opts.old and rgb(70, 54, 40) or TIMBER
	local count = 0
	for s = 3, length - 2, opts.old and 6 or 8 do
		if inGap(s) then
			continue
		end
		count += 1
		local p = a + dir * s
		local tilt = opts.old and rng:NextNumber(-0.12, 0.12) or 0
		for _, side in { -1, 1 } do
			block(parent, "Timber post", Vector3.new(0.8, h - 0.8, 0.8), CFrame.lookAt(p + left * side * (w / 2 - 0.5) + Vector3.new(0, (h - 0.8) / 2, 0), p + left * side * (w / 2 - 0.5) + Vector3.new(0, (h - 0.8) / 2, 0) + dir) * CFrame.Angles(0, 0, tilt * side), wood, Enum.Material.Wood)
		end
		local cap = detail(block(parent, "Timber cap", Vector3.new(w, 0.8, 0.8), CFrame.lookAt(p + Vector3.new(0, h - 0.4, 0), p + Vector3.new(0, h - 0.4, 0) + dir) * CFrame.Angles(0, 0, tilt), wood, Enum.Material.Wood))
		if opts.old and rng:NextNumber() < 0.35 then
			cap.CFrame = cap.CFrame * CFrame.Angles(0, 0, rng:NextNumber(0.2, 0.5)) * CFrame.new(0, -1, 0)
		end
		if opts.lamps and count % 2 == 0 then
			mineLamp(parent, p + Vector3.new(0, h - 1.6, 0), opts.lampOrder and opts.lampOrder(p) or 0)
		end
	end

	-- Rails and sleepers.
	if opts.rails then
		for _, side in { -1, 1 } do
			detail(block(parent, "Rail", Vector3.new(0.25, 0.3, length), frame * CFrame.new(side * 1.3, 0.15, 0), rgb(90, 80, 70), Enum.Material.CorrodedMetal))
		end
		for s = 1, length - 1, 2.6 do
			detail(block(parent, "Sleeper", Vector3.new(3.8, 0.15, 0.6), CFrame.lookAt(a + dir * s + Vector3.new(0, 0.05, 0), a + dir * (s + 1) + Vector3.new(0, 0.05, 0)), rgb(70, 54, 40), Enum.Material.Wood))
		end
	end

	-- Ventilation duct and cables.
	if not opts.old then
		local off = left * (w / 2 - 1.1) + Vector3.new(0, h - 1.9, 0)
		detail(Build.pipe(parent, "Vent duct", a + off, b + off, 1.5, rgb(190, 160, 70), Enum.Material.Fabric))
		local coff = -left * (w / 2 - 0.25) + Vector3.new(0, h - 2.5, 0)
		detail(Build.beam(parent, "Power cable", a + coff, b + coff, 0.18, rgb(20, 20, 20), Enum.Material.Rubber))
	end

	-- Puddles.
	for _ = 1, math.floor(length / 30) do
		local p = a + dir * rng:NextNumber(4, length - 4) + left * rng:NextNumber(-w / 3, w / 3)
		local puddle = detail(block(parent, "Puddle", Vector3.new(rng:NextNumber(2, 4), 0.05, rng:NextNumber(2, 5)), p + Vector3.new(0, 0.03, 0), rgb(30, 40, 46), Enum.Material.Glass))
		puddle.Reflectance = 0.3
		puddle.Transparency = 0.2
	end
end

local function chamber(parent, center, sx, sz, h, gaps)
	room(parent, center, sx, sz, h, gaps, WALL, Enum.Material.Slate, { thickness = 2, floorColor = FLOOR, floorMaterial = Enum.Material.Ground, roofColor = WALL:Lerp(rgb(0, 0, 0), 0.2), snowRoof = false })
	local x0, x1 = center.X - sx / 2, center.X + sx / 2
	local z0, z1 = center.Z - sz / 2, center.Z + sz / 2
	lumps(parent, Vector3.new(x0, center.Y, z0), Vector3.new(x1, center.Y, z0), Vector3.new(0, 0, -1), h, gaps.north)
	lumps(parent, Vector3.new(x0, center.Y, z1), Vector3.new(x1, center.Y, z1), Vector3.new(0, 0, 1), h, gaps.south)
	lumps(parent, Vector3.new(x0, center.Y, z0), Vector3.new(x0, center.Y, z1), Vector3.new(-1, 0, 0), h, gaps.west)
	lumps(parent, Vector3.new(x1, center.Y, z0), Vector3.new(x1, center.Y, z1), Vector3.new(1, 0, 0), h, gaps.east)
	-- Roof bolts and props.
	for _ = 1, 4 do
		local p = center + Vector3.new(rng:NextNumber(-sx / 2 + 3, sx / 2 - 3), 0, rng:NextNumber(-sz / 2 + 3, sz / 2 - 3))
		block(parent, "Prop", Vector3.new(0.8, h, 0.8), p + Vector3.new(0, h / 2, 0), TIMBER, Enum.Material.Wood)
	end
end

local function seam(parent, n, pos, normal)
	local cf = CFrame.lookAt(pos, pos + normal)
	local ore = block(parent, "Ore seam", Vector3.new(6, 5, 1.6), cf, rgb(110, 92, 52), Enum.Material.Rock)
	ore:SetAttribute("Seam", n)
	Build.tag(ore, "Seam")
	for _ = 1, 9 do
		detail(block(parent, "Sulphide", Vector3.new(rng:NextNumber(0.3, 0.8), rng:NextNumber(0.2, 0.6), 0.3), cf * CFrame.new(rng:NextNumber(-2.6, 2.6), rng:NextNumber(-2.2, 2.2), -0.75), rgb(210, 180, 90), Enum.Material.Foil))
	end
	local mark = detail(block(parent, "Seam mark", Vector3.new(4, 2.4, 0.05), cf * CFrame.new(0, 0.4, -0.85), rgb(0, 0, 0)))
	mark.Transparency = 1
	mark:SetAttribute("Seam", n)
	Build.tag(mark, "SeamMark")
	Build.sign(mark, Enum.NormalId.Front, "✕ " .. n, { bgTransparency = 1, fg = rgb(220, 40, 30), font = Enum.Font.PermanentMarker })
	Build.interact(ore, "seam", "Break ore", "Seam No. " .. n, 2.5, { Seam = n })
	local pick = detail(block(parent, "Leaning pick", Vector3.new(0.25, 3.4, 0.25), cf * CFrame.new(3.6, -1, -1.2) * CFrame.Angles(0, 0, 0.3), rgb(110, 80, 50), Enum.Material.Wood))
	detail(block(parent, "Pick head", Vector3.new(2.2, 0.3, 0.3), pick.CFrame * CFrame.new(0, 1.7, 0), rgb(70, 70, 72), Enum.Material.Metal))
end

local function wallSign(parent, at, normal, text, color)
	local p = detail(block(parent, "Mine sign", Vector3.new(5, 1.8, 0.1), CFrame.lookAt(at, at + normal), color or rgb(220, 190, 50)))
	Build.sign(p, Enum.NormalId.Front, text, { bg = color or rgb(220, 190, 50), fg = rgb(20, 20, 20), font = Enum.Font.Oswald, padding = 0.04 })
	return p
end

local function cart(parent, cf, loaded)
	block(parent, "Mine cart", Vector3.new(3.2, 2.4, 5), cf * CFrame.new(0, 1.9, 0), rgb(90, 70, 50), Enum.Material.CorrodedMetal)
	if loaded then
		detail(block(parent, "Ore", Vector3.new(2.8, 0.8, 4.6), cf * CFrame.new(0, 3.2, 0), rgb(70, 62, 48), Enum.Material.Slate))
	end
	for _, x in { -1.3, 1.3 } do
		for _, z in { -1.6, 1.6 } do
			detail(Build.cylinder(parent, "Cart wheel", 0.3, 1.2, cf * CFrame.new(x, 0.6, z), rgb(40, 40, 40), Enum.Material.Metal))
		end
	end
end

local function underground(folder, spots)
	local O = Config.Places.Underground
	local ug = Instance.new("Model")
	ug.Name = "Horizon -300"
	ug.Parent = folder
	local function L(x, y, z)
		return O + Vector3.new(x, y, z)
	end
	-- Lamps die from the far end towards the cage.
	local function order(p)
		return math.floor((p - O).Magnitude)
	end

	-- Cage landing.
	chamber(ug, L(0, 0, 0), 28, 28, 14, { north = { { at = 14, width = 10, top = 11 } } })
	cage(ug, L(0, 0, 9), Vector3.new(0, 0, -1), "cageUp", "Ring for the cage")
	mineLamp(ug, L(-8, 12, -4), order(L(-8, 12, -4)))
	mineLamp(ug, L(8, 12, -4), order(L(8, 12, -4)))
	wallSign(ug, L(0, 12.5, -13.9), Vector3.new(0, 0, 1), "ГОРИЗОНТ −300 · ОКОЛОСТВОЛЬНЫЙ ДВОР")
	local chalk = detail(block(ug, "Quota board", Vector3.new(0.2, 4, 7), L(-13.85, 5, 0), rgb(30, 40, 32)))
	Build.sign(chalk, Enum.NormalId.Right, "НОРМА СМЕНЫ: 5 ЗАБОЕВ\n№ 1, 2 — западный квершлаг\n№ 3, 4 — восточный квершлаг\n№ 5 — северный забой\nВ СТАРУЮ ВЫРАБОТКУ НЕ ХОДИТЬ!", { bg = rgb(34, 48, 36), fg = rgb(236, 236, 226), font = Enum.Font.Code, padding = 0.04 })
	local phone = detail(block(ug, "Dispatcher phone", Vector3.new(1.4, 2, 0.8), L(13.5, 4.5, -4), rgb(60, 70, 60), Enum.Material.Metal))
	Build.sign(phone, Enum.NormalId.Left, "☎\nДИСПЕТЧЕР", { bg = rgb(60, 70, 60), fg = rgb(230, 230, 220) })
	local aid = detail(block(ug, "First aid", Vector3.new(0.6, 1.6, 2), L(13.6, 4, 4), rgb(230, 230, 226), Enum.Material.Metal))
	Build.sign(aid, Enum.NormalId.Left, "✚ АПТЕЧКА", { bg = rgb(236, 236, 230), fg = rgb(200, 30, 30) })
	block(ug, "Bench", Vector3.new(1.6, 1.8, 8), L(-12, 0.9, 6), TIMBER, Enum.Material.Wood)
	Build.poster(ug, CFrame.lookAt(L(-13.8, 6, 9), L(0, 6, 9)), Config.Posters[5])
	detail(Build.column(ug, "Extinguisher", 2, 0.8, L(-12.5, 0.4, -10), rgb(200, 30, 30), Enum.Material.Metal))
	spots.ugLanding = CFrame.lookAt(L(0, 3, 2), L(0, 3, -20))

	-- Main haulage drift north.
	drift(ug, L(0, 0, -14), L(0, 0, -200), 10, 11, {
		gapsL = { { at = 56, width = 9 } },
		gapsR = { { at = 126, width = 9 } },
		rails = true,
		lamps = true,
		lampOrder = order,
	})
	-- A cart train parked along the landing's east wall, out of the way.
	for _, x in { -1.3, 1.3 } do
		detail(block(ug, "Siding rail", Vector3.new(0.25, 0.3, 24), L(9 + x, 0.55, -1), rgb(90, 80, 70), Enum.Material.CorrodedMetal))
	end
	cart(ug, CFrame.new(L(9, 0.4, 7)), false)
	cart(ug, CFrame.new(L(9, 0.4, 1)), true)
	cart(ug, CFrame.new(L(9, 0.4, -5)), true)
	block(ug, "Electric locomotive", Vector3.new(3.6, 4, 6), L(9, 2.4, -10.5), rgb(50, 70, 56), Enum.Material.CorrodedMetal)
	wallSign(ug, L(4.9, 5, -64), Vector3.new(-1, 0, 0), "← ЗАБОИ № 1, 2   ·   КЛЕТЬ: НА ЮГ ↓")
	wallSign(ug, L(-4.9, 5, -134), Vector3.new(1, 0, 0), "ЗАБОИ № 3, 4 →   ·   № 5: НА СЕВЕР ↑")
	wallSign(ug, L(-4.9, 5, -100), Vector3.new(1, 0, 0), "↓ К КЛЕТИ", rgb(60, 160, 70))
	wallSign(ug, L(4.9, 5, -180), Vector3.new(-1, 0, 0), "↓ К КЛЕТИ", rgb(60, 160, 70))
	local crate = block(ug, "Explosives crate", Vector3.new(2.4, 1.6, 1.6), L(3.5, 0.8, -150), rgb(110, 80, 50), Enum.Material.WoodPlanks)
	Build.sign(crate, Enum.NormalId.Left, "ВВ · ОПАСНО", { bg = rgb(110, 80, 50), fg = rgb(220, 40, 30) })
	for i = 0, 4 do
		detail(block(ug, "Timber stack", Vector3.new(0.8, 0.8, 6), L(-3.4, 0.4 + i * 0.8, -110), TIMBER, Enum.Material.Wood))
	end

	-- West crosscut and stope.
	drift(ug, L(-5, 0, -70), L(-110, 0, -70), 9, 10, { rails = true, lamps = true, lampOrder = order })
	chamber(ug, L(-125, 0, -70), 30, 36, 16, { east = { { at = 18, width = 9 } } })
	mineLamp(ug, L(-125, 13, -70), order(L(-125, 13, -70)))
	seam(ug, 1, L(-55, 3.5, -74.3), Vector3.new(0, 0, 1))
	seam(ug, 2, L(-139.8, 4, -70), Vector3.new(1, 0, 0))
	wallSign(ug, L(-100, 5, -65.6), Vector3.new(0, 0, -1), "← КЛЕТЬ", rgb(60, 160, 70))

	-- East crosscut and stope.
	drift(ug, L(5, 0, -140), L(100, 0, -140), 9, 10, { rails = true, lamps = true, lampOrder = order })
	chamber(ug, L(115, 0, -140), 30, 36, 16, { west = { { at = 18, width = 9 } } })
	mineLamp(ug, L(115, 13, -140), order(L(115, 13, -140)))
	seam(ug, 3, L(50, 3.5, -135.7), Vector3.new(0, 0, -1))
	seam(ug, 4, L(129.8, 4, -140), Vector3.new(-1, 0, 0))
	wallSign(ug, L(90, 5, -144.4), Vector3.new(0, 0, 1), "КЛЕТЬ →", rgb(60, 160, 70))

	-- North working face.
	chamber(ug, L(0, 0, -213), 32, 26, 14, {
		south = { { at = 16, width = 10 } },
		west = { { at = 13, width = 7, top = 8 } },
	})
	mineLamp(ug, L(4, 12, -213), order(L(4, 12, -213)))
	seam(ug, 5, L(6, 4, -225.8), Vector3.new(0, 0, 1))
	spots.ugNorth = CFrame.lookAt(L(0, 3, -205), L(0, 3, -150))

	-- The old Norillag gallery, boarded up in 1956.
	drift(ug, L(-16, 0, -213), L(-80, 0, -213), 7, 8, { old = true, capEnd = true })
	for i, y in { 4.4, 5.6, 6.8, 7.6 } do
		local board = block(ug, "Boarding", Vector3.new(0.3, 0.5, 8), CFrame.new(L(-17, y, -213)) * CFrame.Angles(math.rad((i % 2 == 0) and 6 or -5), 0, 0), rgb(80, 64, 46), Enum.Material.WoodPlanks)
		board.CanCollide = false
	end
	block(ug, "Broken board", Vector3.new(0.3, 0.5, 6), CFrame.new(L(-17.5, 1.2, -211)) * CFrame.Angles(0.9, 0, 0.3), rgb(80, 64, 46), Enum.Material.WoodPlanks).CanCollide = false
	local warn = wallSign(ug, L(-16.2, 5.6, -213), Vector3.new(1, 0, 0), "ВХОД ЗАПРЕЩЁН · 1956", rgb(200, 40, 30))
	warn.Size = Vector3.new(4, 1.2, 0.1)
	local tally = detail(block(ug, "Tally marks", Vector3.new(8, 3, 0.1), L(-50, 4, -209.6), WALL))
	Build.sign(tally, Enum.NormalId.Front, "IIII IIII IIII IIII IIII\nIIII IIII IIII IIII IIII\nIIII IIII IIII II", { bgTransparency = 1, fg = rgb(170, 160, 140), font = Enum.Font.PermanentMarker })
	detail(block(ug, "Wheelbarrow", Vector3.new(2, 1.2, 3.4), CFrame.new(L(-40, 0.8, -215)) * CFrame.Angles(0, 0.5, 0.4), rgb(70, 60, 50), Enum.Material.CorrodedMetal))
	for i = 0, 5 do
		detail(block(ug, "Old boot", Vector3.new(0.8, 0.9, 1.4), CFrame.new(L(-72 + (i % 3) * 1.1, 0.45, -215 + math.floor(i / 3) * 1.6)) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), rgb(36, 30, 26), Enum.Material.Leather))
	end
	local plank = detail(block(ug, "Inscription board", Vector3.new(0.2, 3, 4), L(-79.85, 3.5, -213), rgb(80, 64, 46), Enum.Material.WoodPlanks))
	Build.sign(plank, Enum.NormalId.Right, "ОН ХОДИТ ЗА ПОСЛЕДНИМ", { bgTransparency = 1, fg = rgb(60, 40, 30), font = Enum.Font.PermanentMarker })
	Build.note(ug, 4, CFrame.new(L(-77, 0.1, -213)) * CFrame.Angles(0, 0.3, 0))

	-- Coworkers on shift (gone when the lamps die).
	show(Figure.build(ug, CFrame.lookAt(L(-12, 0, 4), L(0, 0, 4)), { pose = "sit", seatHeight = 1.8, hat = "helmet", held = "mug", armR = 50, armL = 40, action = "drink", name = "Miner" }), 5, 5)
	show(Figure.build(ug, CFrame.lookAt(L(-30, 0, -73), L(-30, 0, -80)), { hat = "helmet", held = "pick", armR = 100, armL = 90, action = "dig", name = "Miner" }), 5, 5)
	show(Figure.build(ug, CFrame.lookAt(L(80, 0, -137), L(80, 0, -132)), { hat = "helmet", held = "pick", armR = 100, armL = 90, action = "dig", name = "Miner" }), 5, 5)
	show(Figure.build(ug, CFrame.lookAt(L(2.5, 0, -46), L(2.5, 0, -40)), { hat = "helmet", armR = 10, action = "idle", name = "Miner" }), 5, 5)
end

function Mine.build(world)
	local spots = {}
	local folder = Instance.new("Folder")
	folder.Name = "Mine No. 6"
	folder.Parent = world
	surface(folder, spots)
	underground(folder, spots)
	return spots
end

return Mine
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Town</string><ProtectedString name="Source"><![CDATA[-- The town: panel housing, the avenue, the courtyard, the plaza, the player's flat
-- and the ruins of the old camp. Returns named spawn spots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Build)
local Config = require(Shared.Config)

local rgb = Build.rgb
local block, wedge, detail = Build.block, Build.wedge, Build.detail

local Town = {}

local SNOW = rgb(222, 228, 234)
local CONCRETE = { rgb(146, 144, 136), rgb(156, 150, 138), rgb(132, 136, 136), rgb(150, 140, 130), rgb(124, 130, 138) }
local WARM = { rgb(150, 102, 52), rgb(160, 118, 66), rgb(130, 92, 56), rgb(150, 112, 80), rgb(120, 80, 44) }
local rng = Random.new(1984)

local function face(pos, dir)
	return CFrame.lookAt(pos, pos + dir)
end

-- A five-storey Khrushchyovka on short piles, as they are built on permafrost.
-- cf: ground centre, LookVector = the front (street side). Entrances are on the back (courtyard).
local function apartmentBlock(parent, name, cf, length, opts)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	local floors = opts.floors or 5
	local depth = 30
	local floorH = 7.5
	local plinth = 3
	local h = floors * floorH
	local color = opts.color or CONCRETE[rng:NextInteger(1, #CONCRETE)]
	local lit = opts.lit or 0.22

	block(m, "Piles", Vector3.new(length - 1.5, plinth, depth - 1.5), cf * CFrame.new(0, plinth / 2, 0), rgb(44, 44, 46))
	for x = -length / 2 + 4, length / 2 - 4, 8 do
		for _, z in { -depth / 2 + 1.2, depth / 2 - 1.2 } do
			detail(block(m, "Pile", Vector3.new(1, plinth, 1), cf * CFrame.new(x, plinth / 2, z), rgb(90, 90, 88)))
		end
	end
	block(m, "Body", Vector3.new(length, h, depth), cf * CFrame.new(0, plinth + h / 2, 0), color)
	block(m, "Roof snow", Vector3.new(length + 0.6, 0.8, depth + 0.6), cf * CFrame.new(0, plinth + h + 0.4, 0), SNOW, Enum.Material.Snow)
	for f = 1, floors - 1 do
		detail(block(m, "Panel seam", Vector3.new(length + 0.15, 0.25, depth + 0.15), cf * CFrame.new(0, plinth + f * floorH, 0), color:Lerp(rgb(30, 30, 30), 0.3)))
	end
	for x = -length / 2 + 12, length / 2 - 6, 12 do
		detail(block(m, "Panel seam", Vector3.new(0.25, h, depth + 0.15), cf * CFrame.new(x, plinth + h / 2, 0), color:Lerp(rgb(30, 30, 30), 0.25)))
	end

	-- Windows on both long faces. Some are lit: somebody is still awake.
	local entrances = opts.entrances or {}
	local function nearEntrance(x)
		for _, ex in entrances do
			if math.abs(ex - x) < 3.5 then
				return true
			end
		end
		return false
	end
	local column = 0
	for x = -length / 2 + 4, length / 2 - 4, 6 do
		column += 1
		for _, side in { -1, 1 } do
			if side == 1 and nearEntrance(x) then
				continue
			end
			for f = 1, floors do
				if opts.shopFrom and side == -1 and f == 1 and x >= opts.shopFrom and x <= opts.shopTo then
					continue
				end
				local y = plinth + (f - 1) * floorH + 3.8
				local pos = cf * CFrame.new(x, y, side * (depth / 2 + 0.1))
				local w = detail(block(m, "Window", Vector3.new(3.2, 3.8, 0.25), pos, rgb(22, 28, 34), Enum.Material.Glass))
				w.Reflectance = 0.08
				local r = rng:NextNumber()
				if r < lit then
					w.Material = Enum.Material.Neon
					w.Color = WARM[rng:NextInteger(1, #WARM)]
					w.Name = "Lit window"
					if rng:NextNumber() < 0.08 then
						w.Color = rgb(60, 78, 112)
						Build.tag(w, "TVWindow")
					end
					if rng:NextNumber() < 0.35 then
						local glow = detail(block(m, "Window glow", Vector3.new(0.2, 0.2, 0.2), pos * CFrame.new(0, 0, side * 1.2), w.Color))
						glow.Transparency = 1
						Build.light(glow, w.Color:Lerp(rgb(255, 200, 140), 0.5), 11, 0.55)
					end
					-- A curtain half drawn.
					if rng:NextNumber() < 0.5 then
						detail(block(m, "Curtain", Vector3.new(1.3, 3.8, 0.1), pos * CFrame.new(rng:NextNumber() < 0.5 and -0.95 or 0.95, 0, side * 0.12), rgb(120, 60, 40):Lerp(rgb(160, 150, 110), rng:NextNumber()), Enum.Material.Fabric))
					end
				end
				detail(block(m, "Sill", Vector3.new(3.6, 0.2, 0.5), pos * CFrame.new(0, -2, side * 0.2), SNOW, Enum.Material.Snow))
				-- Balconies on the street side.
				if side == -1 and f >= 2 and column % 2 == 0 then
					local base = pos * CFrame.new(0, -2.2, -1.2)
					detail(block(m, "Balcony", Vector3.new(4.4, 0.35, 2.4), base, color:Lerp(rgb(0, 0, 0), 0.1)))
					local rail = ({ rgb(120, 70, 50), rgb(70, 100, 100), rgb(140, 130, 110), rgb(90, 90, 96) })[rng:NextInteger(1, 4)]
					detail(block(m, "Balcony rail", Vector3.new(4.4, 1.7, 0.18), base * CFrame.new(0, 1, -1.1), rail, Enum.Material.CorrodedMetal))
					detail(block(m, "Balcony snow", Vector3.new(4.3, 0.25, 2.3), base * CFrame.new(0, 0.3, 0), SNOW, Enum.Material.Snow))
					if rng:NextNumber() < 0.3 then
						detail(block(m, "Stored junk", Vector3.new(1.4, 1.2, 1), base * CFrame.new(rng:NextNumber(-1.2, 1.2), 0.8, -0.2), rgb(90, 80, 66), Enum.Material.WoodPlanks))
					end
				end
			end
		end
	end

	-- Entrances (podyezds) on the courtyard side.
	local doors = {}
	for i, x in entrances do
		local back = depth / 2
		block(m, "Entrance steps", Vector3.new(8, 0.8, 4), cf * CFrame.new(x, 0.4, back + 2), rgb(110, 110, 106))
		local door = block(m, "Entrance door", Vector3.new(3.6, 5.4, 0.3), cf * CFrame.new(x, 3.5, back + 0.15), rgb(70, 52, 38), Enum.Material.WoodPlanks)
		table.insert(doors, door)
		block(m, "Canopy", Vector3.new(8, 0.5, 4.5), cf * CFrame.new(x, 7.3, back + 2.2), color)
		detail(block(m, "Canopy snow", Vector3.new(7.8, 0.4, 4.3), cf * CFrame.new(x, 7.7, back + 2.2), SNOW, Enum.Material.Snow))
		local bulb = detail(Build.ball(m, "Entrance lamp", 0.7, cf * CFrame.new(x, 6.7, back + 1.2), rgb(255, 196, 120), Enum.Material.Neon))
		if rng:NextNumber() < 0.85 then
			Build.light(bulb, rgb(255, 180, 110), 17, 0.9, true)
			Build.tag(bulb, "EntranceLamp")
		else
			bulb.Color = rgb(60, 56, 50)
			bulb.Material = Enum.Material.Glass
		end
		local plate = detail(block(m, "Entrance sign", Vector3.new(2.6, 1, 0.1), cf * CFrame.new(x + 3, 5, back + 0.08) * CFrame.Angles(0, math.pi, 0), rgb(40, 60, 110)))
		Build.sign(plate, Enum.NormalId.Front, ("ПОДЪЕЗД %d\nкв. %d–%d"):format(i, (i - 1) * 20 + 1, i * 20), { bg = rgb(36, 56, 104), fg = rgb(236, 236, 230), font = Enum.Font.Arimo })
		for f = 1, floors do
			local w = detail(block(m, "Stairwell window", Vector3.new(2, 2.6, 0.25), cf * CFrame.new(x, plinth + f * floorH - 0.6, back + 0.1), rgb(24, 30, 34), Enum.Material.Glass))
			if rng:NextNumber() < 0.55 then
				w.Material = Enum.Material.Neon
				w.Color = rgb(96, 110, 84)
			end
		end
		-- Bench with snow on it.
		local bench = cf * CFrame.new(x + 6, 0, back + 3.5)
		detail(block(m, "Bench", Vector3.new(4, 0.3, 1.2), bench * CFrame.new(0, 1.5, 0), rgb(90, 60, 40), Enum.Material.WoodPlanks))
		detail(block(m, "Bench snow", Vector3.new(3.9, 0.3, 1.1), bench * CFrame.new(0, 1.75, 0), SNOW, Enum.Material.Snow))
		for _, bx in { -1.6, 1.6 } do
			detail(block(m, "Bench leg", Vector3.new(0.3, 1.5, 1), bench * CFrame.new(bx, 0.75, 0), rgb(60, 60, 60), Enum.Material.Metal))
		end
		local board = detail(block(m, "Notice board", Vector3.new(2.2, 1.6, 0.1), cf * CFrame.new(x - 3.2, 4.2, back + 0.08) * CFrame.Angles(0, math.pi, 0), rgb(200, 190, 160)))
		Build.sign(board, Enum.NormalId.Front, "ОБЪЯВЛЕНИЕ\nЖильцам: отопление будет отключено 14.12 с 8:00 до 20:00.\nЖЭК № 3", { bg = rgb(214, 204, 172), fg = rgb(30, 30, 30), font = Enum.Font.Arimo, padding = 0.05 })
	end

	-- Shop on the ground floor of the street side.
	if opts.shop then
		local mid = (opts.shopFrom + opts.shopTo) / 2
		local width = opts.shopTo - opts.shopFrom + 4
		local front = -depth / 2
		local display = detail(block(m, "Shop window", Vector3.new(width - 4, 3.6, 0.3), cf * CFrame.new(mid, plinth + 3.6, front - 0.1), rgb(110, 116, 100), Enum.Material.Neon))
		display.Transparency = 0.2
		local inside = detail(block(m, "Shop glow", Vector3.new(1, 1, 1), cf * CFrame.new(mid, plinth + 3.6, front - 2), rgb(255, 255, 255)))
		inside.Transparency = 1
		Build.light(inside, rgb(200, 220, 200), 18, 0.6)
		local sign = detail(block(m, "Shop sign", Vector3.new(width, 2.2, 0.4), cf * CFrame.new(mid, plinth + 6.7, front - 0.3), rgb(30, 30, 30)))
		Build.sign(sign, Enum.NormalId.Front, opts.shop, { bg = rgb(30, 22, 22), fg = rgb(255, 70, 50), lightInfluence = 0, brightness = 1.4 })
		Build.sign(display, Enum.NormalId.Front, opts.shopWindow or "", { bg = rgb(0, 0, 0), bgTransparency = 1, fg = rgb(40, 40, 30), font = Enum.Font.Arimo })
	end

	-- House number plate.
	local plate = detail(block(m, "Address", Vector3.new(5, 1.3, 0.1), cf * CFrame.new(length / 2 - 4, plinth + 2, -depth / 2 - 0.08), rgb(36, 56, 104)))
	Build.sign(plate, Enum.NormalId.Front, opts.address or "", { bg = rgb(36, 56, 104), fg = rgb(240, 240, 232), font = Enum.Font.Arimo })

	-- Television aerials.
	for _ = 1, 3 do
		local base = cf * CFrame.new(rng:NextNumber(-length / 2 + 5, length / 2 - 5), plinth + h + 0.8, rng:NextNumber(-8, 8))
		detail(block(m, "Aerial", Vector3.new(0.15, 5, 0.15), base * CFrame.new(0, 2.5, 0), rgb(60, 60, 60), Enum.Material.Metal))
		for k = 0, 2 do
			detail(block(m, "Aerial bar", Vector3.new(2.6 - k * 0.6, 0.1, 0.1), base * CFrame.new(0, 3.4 + k * 0.7, 0) * CFrame.Angles(0, rng:NextNumber(0, 0.3), 0), rgb(60, 60, 60), Enum.Material.Metal))
		end
	end

	-- A huge slogan on one gable end.
	if opts.gablePoster then
		local design = Config.Posters[opts.gablePoster]
		local side = opts.gableSide or 1
		local pos = (cf * CFrame.new(side * (length / 2 + 0.2), plinth + h / 2 + 2, 0)).Position
		Build.poster(m, face(pos, cf.RightVector * side), design, Vector2.new(20, 28))
	end

	-- Snowdrifts against the walls.
	for _ = 1, math.floor(length / 14) do
		local side = rng:NextNumber() < 0.5 and -1 or 1
		local x = rng:NextNumber(-length / 2, length / 2)
		local d = wedge(m, "Snowdrift", Vector3.new(rng:NextNumber(5, 10), rng:NextNumber(1.5, 3), 3), cf * CFrame.new(x, 1, side * (depth / 2 + 1.5)) * CFrame.Angles(0, side == 1 and 0 or math.pi, 0), SNOW, Enum.Material.Snow)
		detail(d)
	end

	return m, doors
end

local function streetlight(parent, base, armDir, working)
	local pole = block(parent, "Streetlight pole", Vector3.new(0.6, 15, 0.6), base + Vector3.new(0, 7.5, 0), rgb(70, 74, 72), Enum.Material.Metal)
	local tip = base + Vector3.new(0, 14.6, 0) + armDir * 4
	detail(Build.beam(parent, "Streetlight arm", base + Vector3.new(0, 14.6, 0), tip, 0.35, rgb(70, 74, 72), Enum.Material.Metal))
	local head = detail(block(parent, "Streetlight head", Vector3.new(1.6, 0.5, 0.9), CFrame.lookAt(tip, tip + armDir) * CFrame.Angles(0, math.pi / 2, 0), rgb(255, 170, 90), Enum.Material.Neon))
	if working then
		local light = Build.light(head, rgb(255, 168, 92), 34, 1.5, true)
		light.Name = "Light"
		Build.tag(head, "Streetlight")
	else
		head.Color = rgb(60, 52, 44)
		head.Material = Enum.Material.Glass
	end
	return pole, head
end

local function lada(parent, cf, color)
	local m = Instance.new("Model")
	m.Name = "Zhiguli"
	m.Parent = parent
	block(m, "Body", Vector3.new(4.6, 1.6, 10), cf * CFrame.new(0, 1.6, 0), color, Enum.Material.SmoothPlastic)
	block(m, "Cabin", Vector3.new(4.2, 1.5, 5), cf * CFrame.new(0, 3.1, 0.5), color, Enum.Material.SmoothPlastic)
	for _, z in { -2.2, 3 } do
		local win = detail(block(m, "Windscreen", Vector3.new(3.8, 1.2, 0.1), cf * CFrame.new(0, 3.1, z - 0.05 + (z < 0 and 0 or 0)), rgb(30, 36, 40), Enum.Material.Glass))
		win.Transparency = 0.2
	end
	detail(block(m, "Roof snow", Vector3.new(4.1, 0.5, 4.9), cf * CFrame.new(0, 4.05, 0.5), SNOW, Enum.Material.Snow))
	detail(block(m, "Bonnet snow", Vector3.new(4.4, 0.4, 2.6), cf * CFrame.new(0, 2.6, -3.6), SNOW, Enum.Material.Snow))
	for _, x in { -2.2, 2.2 } do
		for _, z in { -3.2, 3.2 } do
			detail(Build.cylinder(m, "Wheel", 0.8, 2, cf * CFrame.new(x, 1, z), rgb(24, 24, 24), Enum.Material.Rubber))
		end
	end
	for _, x in { -1.6, 1.6 } do
		detail(Build.ball(m, "Headlight", 0.6, cf * CFrame.new(x, 1.8, -5), rgb(200, 200, 180), Enum.Material.Glass))
	end
	local plate = detail(block(m, "Plate", Vector3.new(2, 0.5, 0.05), cf * CFrame.new(0, 1.2, -5.03) * CFrame.Angles(0, math.pi, 0), rgb(230, 230, 230)))
	Build.sign(plate, Enum.NormalId.Front, "К 12-48 КЯ", { bg = rgb(232, 232, 228), fg = rgb(20, 20, 20), font = Enum.Font.Arimo })
	wedge(m, "Snow heap", Vector3.new(5.5, 1.6, 4), cf * CFrame.new(0, 0.8, 6) * CFrame.Angles(0, math.pi, 0), SNOW, Enum.Material.Snow)
	return m
end

local function apartmentInterior(parent, origin, spots)
	local m = Instance.new("Model")
	m.Name = "Flat 23"
	m.Parent = parent
	local function at(x, y, z)
		return CFrame.new(origin + Vector3.new(x, y, z))
	end
	local wallpaper = rgb(176, 160, 118)
	block(m, "Floor", Vector3.new(28, 1, 22), at(0, -0.5, 0), rgb(120, 78, 46), Enum.Material.WoodPlanks)
	block(m, "Ceiling", Vector3.new(28, 1, 22), at(0, 10.5, 0), rgb(220, 216, 204), Enum.Material.SmoothPlastic)
	local o = origin
	Build.wall(m, o + Vector3.new(-13, 0, -10), o + Vector3.new(13, 0, -10), Vector3.new(0, 0, -1), 10, 1, { { at = 9, width = 6, bottom = 3, top = 8 } }, wallpaper, Enum.Material.Fabric)
	Build.wall(m, o + Vector3.new(-13, 0, 10), o + Vector3.new(13, 0, 10), Vector3.new(0, 0, 1), 10, 1, {}, wallpaper, Enum.Material.Fabric)
	Build.wall(m, o + Vector3.new(-13, 0, -11), o + Vector3.new(-13, 0, 11), Vector3.new(-1, 0, 0), 10, 1, {}, wallpaper, Enum.Material.Fabric)
	Build.wall(m, o + Vector3.new(13, 0, -11), o + Vector3.new(13, 0, 11), Vector3.new(1, 0, 0), 10, 1, {}, wallpaper, Enum.Material.Fabric)
	detail(block(m, "Skirting", Vector3.new(26, 0.5, 0.2), at(0, 0.25, 9.9), rgb(90, 60, 40), Enum.Material.Wood))
	detail(block(m, "Skirting", Vector3.new(26, 0.5, 0.2), at(0, 0.25, -9.9), rgb(90, 60, 40), Enum.Material.Wood))

	-- Frosted window and the snow beyond it.
	local glass = detail(block(m, "Frosted window", Vector3.new(6, 5, 0.2), at(-4, 5.5, -10.4), rgb(170, 190, 205), Enum.Material.Glass))
	glass.Transparency = 0.55
	detail(block(m, "Window frame", Vector3.new(0.3, 5, 0.4), at(-4, 5.5, -10.4), rgb(230, 230, 222), Enum.Material.Wood))
	detail(block(m, "Window frame", Vector3.new(6, 0.3, 0.4), at(-4, 6.5, -10.4), rgb(230, 230, 222), Enum.Material.Wood))
	detail(block(m, "Window sill", Vector3.new(6.6, 0.3, 1), at(-4, 2.9, -9.6), rgb(230, 230, 222), Enum.Material.Wood))
	detail(block(m, "Radiator", Vector3.new(5, 2, 0.5), at(-4, 1.6, -9.6), rgb(200, 196, 186), Enum.Material.Metal))
	local outside = detail(block(m, "Outside", Vector3.new(8, 1, 8), at(-4, 12, -16), rgb(0, 0, 0)))
	outside.Transparency = 1
	local snow = Instance.new("ParticleEmitter")
	snow.Texture = "rbxasset://textures/particles/smoke_main.dds"
	snow.Rate = 60
	snow.Lifetime = NumberRange.new(4, 6)
	snow.Speed = NumberRange.new(2, 4)
	snow.Size = NumberSequence.new(0.15)
	snow.Acceleration = Vector3.new(3, -4, 0)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.LightInfluence = 0.4
	snow.Parent = outside
	local farLamp = detail(Build.ball(m, "Distant streetlight", 0.8, at(-14, 4, -60), rgb(255, 170, 90), Enum.Material.Neon))
	farLamp.Transparency = 0.2

	-- Wall carpet: every flat in the Union had one.
	local carpet = detail(block(m, "Wall carpet", Vector3.new(0.15, 6, 9), at(-12.4, 5.6, -1), rgb(120, 26, 32), Enum.Material.Fabric))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = carpet
	local function frame(px, py, sx, sy, color, rot)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(px, py)
		f.Size = UDim2.fromScale(sx, sy)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.Rotation = rot or 0
		f.Parent = gui
		return f
	end
	frame(0.5, 0.5, 1, 1, rgb(122, 24, 30))
	frame(0.5, 0.5, 0.92, 0.88, rgb(30, 30, 60))
	frame(0.5, 0.5, 0.86, 0.78, rgb(150, 36, 40))
	frame(0.5, 0.5, 0.3, 0.45, rgb(214, 170, 90), 45)
	frame(0.5, 0.5, 0.2, 0.3, rgb(30, 30, 60), 45)
	frame(0.5, 0.5, 0.1, 0.15, rgb(230, 220, 190), 45)
	for _, p in { { 0.2, 0.25 }, { 0.8, 0.25 }, { 0.2, 0.75 }, { 0.8, 0.75 } } do
		frame(p[1], p[2], 0.1, 0.15, rgb(214, 170, 90), 45)
		frame(p[1], p[2], 0.05, 0.07, rgb(30, 30, 60), 45)
	end

	-- Sofa bed under the carpet.
	block(m, "Sofa", Vector3.new(3.6, 1.6, 8.5), at(-10.8, 0.8, -1), rgb(84, 70, 60), Enum.Material.Fabric)
	block(m, "Sofa back", Vector3.new(1, 2.6, 8.5), at(-12.4, 2.1, -1), rgb(84, 70, 60), Enum.Material.Fabric)
	detail(block(m, "Blanket", Vector3.new(3.2, 0.3, 5), at(-10.6, 1.75, 0.5), rgb(70, 90, 70), Enum.Material.Fabric))
	detail(block(m, "Pillow", Vector3.new(2, 0.6, 1.4), at(-10.8, 1.9, -4.2), rgb(236, 232, 220), Enum.Material.Fabric))

	-- Sideboard with crystal and the radio.
	block(m, "Sideboard", Vector3.new(6, 3.4, 2), at(8, 1.7, -8.8), rgb(66, 40, 26), Enum.Material.Wood)
	local upper = block(m, "Sideboard glass", Vector3.new(6, 3.6, 1.6), at(8, 5.2, -9), rgb(150, 160, 160), Enum.Material.Glass)
	upper.Transparency = 0.6
	detail(block(m, "Sideboard top", Vector3.new(6.2, 0.3, 2.1), at(8, 7.1, -8.8), rgb(66, 40, 26), Enum.Material.Wood))
	for i = 0, 4 do
		local c = detail(Build.column(m, "Crystal", 0.7, 0.5, origin + Vector3.new(5.8 + i * 1.1, 3.5, -9), rgb(220, 230, 240), Enum.Material.Glass))
		c.Transparency = 0.3
	end
	local radio = detail(block(m, "Radio VEF", Vector3.new(2.4, 1.3, 0.8), at(8, 7.9, -9), rgb(40, 40, 40), Enum.Material.SmoothPlastic))
	Build.sign(radio, Enum.NormalId.Back, "ВЭФ", { bg = rgb(50, 46, 40), fg = rgb(220, 200, 150) })

	-- Rubin television.
	block(m, "TV Rubin", Vector3.new(2.4, 2.6, 3.2), at(11.4, 2.9, 1), rgb(70, 46, 30), Enum.Material.Wood)
	local screen = detail(block(m, "TV screen", Vector3.new(0.1, 1.9, 2.4), at(10.17, 3.05, 1), rgb(38, 46, 44), Enum.Material.Glass))
	Build.tag(screen, "TVScreen")
	for _, z in { -0.2, 2.2 } do
		detail(block(m, "TV leg", Vector3.new(0.25, 1.6, 0.25), at(11.4, 0.8, z), rgb(30, 30, 30), Enum.Material.Metal))
	end

	-- Table, tea, the letter.
	block(m, "Table", Vector3.new(5, 0.3, 3.6), at(0, 2.8, 1), rgb(236, 230, 214), Enum.Material.Fabric)
	for _, x in { -2.2, 2.2 } do
		for _, z in { -0.4, 2.4 } do
			detail(block(m, "Table leg", Vector3.new(0.3, 2.65, 0.3), at(x, 1.33, z), rgb(80, 50, 30), Enum.Material.Wood))
		end
	end
	for _, z in { -1.5, 3.5 } do
		block(m, "Chair", Vector3.new(1.8, 0.3, 1.8), at(0, 1.8, z), rgb(90, 60, 40), Enum.Material.Wood)
		detail(block(m, "Chair back", Vector3.new(1.8, 2.2, 0.25), at(0, 3, z + (z > 1 and 0.8 or -0.8)), rgb(90, 60, 40), Enum.Material.Wood))
	end
	local tea = detail(Build.column(m, "Glass of tea", 0.7, 0.45, origin + Vector3.new(-1.6, 2.95, 1.2), rgb(150, 70, 30), Enum.Material.Glass))
	tea.Transparency = 0.2
	detail(Build.column(m, "Tea glass holder", 0.4, 0.55, origin + Vector3.new(-1.6, 2.95, 1.2), rgb(170, 150, 100), Enum.Material.Metal))
	local paper = detail(block(m, "Pravda", Vector3.new(1.6, 0.05, 2.2), at(1.4, 2.98, 1.6) * CFrame.Angles(0, 0.3, 0), rgb(220, 214, 196), Enum.Material.SmoothPlastic))
	Build.sign(paper, Enum.NormalId.Top, "ПРАВДА\n12 декабря 1984\nТРУДОВЫЕ ПОБЕДЫ ЗАПОЛЯРЬЯ", { bg = rgb(222, 216, 198), fg = rgb(40, 30, 30), font = Enum.Font.Merriweather })
	local clock = detail(block(m, "Alarm clock", Vector3.new(0.8, 0.8, 0.4), at(-0.3, 3.35, 0) * CFrame.Angles(0, math.pi, 0), rgb(180, 40, 40), Enum.Material.SmoothPlastic))
	Build.sign(clock, Enum.NormalId.Front, "05:50", { bg = rgb(230, 226, 210), fg = rgb(20, 20, 20), font = Enum.Font.Code })
	Build.note(m, 1, at(0.3, 2.98, 0.6) * CFrame.Angles(0, -0.2, 0))

	-- Lampshade.
	local shade = detail(Build.ball(m, "Lampshade", 2.2, at(0, 8.6, 1), rgb(220, 140, 70), Enum.Material.Neon))
	shade.Transparency = 0.3
	detail(block(m, "Lamp cord", Vector3.new(0.1, 1.6, 0.1), at(0, 9.6, 1), rgb(30, 30, 30)))
	Build.light(shade, rgb(255, 196, 130), 26, 0.9, true)

	-- Calendar, portrait, rug, coats, stove.
	local cal = detail(block(m, "Calendar", Vector3.new(0.1, 2.4, 1.7), at(12.45, 6, 6), rgb(230, 225, 210)))
	Build.sign(cal, Enum.NormalId.Left, "1984\nДЕКАБРЬ\n\n12", { bg = rgb(236, 230, 214), fg = rgb(150, 30, 30), font = Enum.Font.Oswald })
	local portrait = detail(block(m, "Portrait", Vector3.new(2.6, 3.2, 0.2), at(-4, 6.2, 9.4), rgb(120, 90, 50), Enum.Material.Wood))
	Build.sign(portrait, Enum.NormalId.Back, "★\nВ. И. ЛЕНИН", { bg = rgb(140, 120, 90), fg = rgb(50, 36, 24), padding = 0.1 })
	detail(block(m, "Rug", Vector3.new(9, 0.06, 6), at(0, 0.03, 1), rgb(140, 40, 40), Enum.Material.Fabric))
	detail(block(m, "Rug border", Vector3.new(8, 0.07, 5), at(0, 0.035, 1), rgb(60, 50, 80), Enum.Material.Fabric))
	detail(block(m, "Coat rack", Vector3.new(0.3, 6, 0.3), at(11, 3, 8.6), rgb(80, 50, 30), Enum.Material.Wood))
	detail(block(m, "Hanging coat", Vector3.new(1.6, 3.6, 0.9), at(11, 4, 8.1), rgb(60, 62, 58), Enum.Material.Fabric))
	detail(block(m, "Stove", Vector3.new(2.6, 3, 2.4), at(-11, 1.5, 7.8), rgb(232, 232, 226), Enum.Material.SmoothPlastic))
	detail(Build.column(m, "Kettle", 1, 1.2, origin + Vector3.new(-11, 3, 7.6), rgb(90, 120, 150), Enum.Material.SmoothPlastic))

	-- The door: padded leatherette, a peephole.
	local door = block(m, "Flat door", Vector3.new(4, 7, 0.3), at(8, 3.5, 9.4), rgb(92, 34, 30), Enum.Material.Leather)
	for y = 1.2, 6.2, 1.25 do
		for x = -1.4, 1.4, 1.4 do
			detail(Build.ball(m, "Door stud", 0.18, at(8 + x, y, 9.24), rgb(190, 170, 110), Enum.Material.Metal))
		end
	end
	detail(Build.ball(m, "Peephole", 0.25, at(8, 5.4, 9.22), rgb(20, 20, 20), Enum.Material.Metal))
	Build.interact(door, "leaveHome", "Leave for work", "Front door", 1.2)

	spots.aptStart = CFrame.lookAt(origin + Vector3.new(-3, 3, -4), origin + Vector3.new(1, 3, 2))
	spots.aptEnd = CFrame.lookAt(origin + Vector3.new(8, 3, 6.6), origin + Vector3.new(8, 3, -4))
	return m
end

local function playground(parent, at)
	local metal = rgb(150, 60, 50)
	-- Swings.
	for _, x in { -4, 4 } do
		for _, z in { -1.5, 1.5 } do
			detail(Build.beam(parent, "Swing frame", at + Vector3.new(x, 0, z * 1.5), at + Vector3.new(x, 8, 0), 0.3, metal, Enum.Material.CorrodedMetal))
		end
	end
	detail(Build.beam(parent, "Swing bar", at + Vector3.new(-4.2, 8, 0), at + Vector3.new(4.2, 8, 0), 0.35, metal, Enum.Material.CorrodedMetal))
	for _, x in { -0.8, 0.8 } do
		detail(block(parent, "Swing chain", Vector3.new(0.08, 6, 0.08), at + Vector3.new(x, 5, 0), rgb(60, 60, 60), Enum.Material.Metal))
	end
	local seat = detail(block(parent, "Swing seat", Vector3.new(2, 0.2, 1), at + Vector3.new(0, 2, 0), rgb(90, 60, 40), Enum.Material.WoodPlanks))
	Build.tag(seat, "Swing")
	-- Carousel.
	local c = at + Vector3.new(14, 0, 6)
	detail(Build.cylinder(parent, "Carousel", 0.4, 7, CFrame.new(c + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(60, 110, 150), Enum.Material.CorrodedMetal))
	detail(Build.column(parent, "Carousel post", 3, 0.4, c, rgb(60, 60, 60), Enum.Material.Metal))
	-- Climbing rocket: the playground staple.
	local r = at + Vector3.new(-12, 0, 10)
	detail(Build.column(parent, "Rocket", 12, 3.4, r, rgb(170, 60, 50), Enum.Material.CorrodedMetal))
	detail(Build.column(parent, "Rocket nose", 2, 2, r + Vector3.new(0, 12, 0), rgb(200, 200, 190), Enum.Material.CorrodedMetal))
	for i = 0, 2 do
		local a = i * math.pi * 2 / 3
		detail(Build.wedge(parent, "Rocket fin", Vector3.new(0.3, 3, 2.4), CFrame.new(r + Vector3.new(math.cos(a) * 2.6, 1.5, math.sin(a) * 2.6)) * CFrame.Angles(0, -a + math.pi / 2, 0), rgb(200, 200, 190), Enum.Material.CorrodedMetal))
	end
	-- Sandbox under snow and an abandoned sled.
	block(parent, "Sandbox", Vector3.new(7, 1, 7), at + Vector3.new(10, 0.5, -10), rgb(110, 80, 50), Enum.Material.WoodPlanks)
	detail(block(parent, "Sandbox snow", Vector3.new(6.4, 0.3, 6.4), at + Vector3.new(10, 1.05, -10), SNOW, Enum.Material.Snow))
	detail(block(parent, "Sled", Vector3.new(1.4, 0.4, 3), CFrame.new(at + Vector3.new(3, 0.3, -6)) * CFrame.Angles(0, 0.6, 0), rgb(140, 40, 40), Enum.Material.Metal))
end

local function garages(parent, start, count)
	for i = 0, count - 1 do
		local p = start + Vector3.new(i * 8.5, 0, 0)
		local color = ({ rgb(90, 100, 90), rgb(110, 80, 60), rgb(70, 80, 100), rgb(120, 116, 100) })[rng:NextInteger(1, 4)]
		block(parent, "Garage", Vector3.new(8, 7, 14), p + Vector3.new(0, 3.5, 0), color, Enum.Material.CorrodedMetal)
		local door = detail(block(parent, "Garage door", Vector3.new(6.6, 5.6, 0.2), p + Vector3.new(0, 2.8, 7.05), color:Lerp(rgb(0, 0, 0), 0.2), Enum.Material.CorrodedMetal))
		Build.sign(door, Enum.NormalId.Back, tostring(17 + i), { bg = rgb(0, 0, 0), bgTransparency = 1, fg = rgb(230, 230, 220) })
		detail(block(parent, "Garage snow", Vector3.new(8.2, 0.6, 14.2), p + Vector3.new(0, 7.3, 0), SNOW, Enum.Material.Snow))
	end
end

local function heatingPipes(parent, points)
	-- Norilsk runs its heating mains above ground, wrapped in silver insulation.
	local insulation = rgb(178, 180, 176)
	local lastPerp = Vector3.xAxis
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dir = (b - a).Unit
		local perp = math.abs(dir.Y) > 0.9 and lastPerp or dir:Cross(Vector3.yAxis).Unit
		lastPerp = perp
		for k, off in { -1, 1 } do
			local o = perp * off * 1
			Build.pipe(parent, "Heating main", a + o, b + o, 1.5, k == 1 and insulation or insulation:Lerp(rgb(120, 100, 80), 0.2), Enum.Material.Foil)
			detail(Build.ball(parent, "Pipe joint", 1.5, a + o, insulation, Enum.Material.Foil))
		end
		if math.abs(dir.Y) < 0.1 then
			local length = (b - a).Magnitude
			for s = 4, length - 2, 10 do
				local p = a + dir * s
				-- No posts in the roadway under the arch.
				if math.abs(p.X) < 24 then
					continue
				end
				block(parent, "Pipe support", Vector3.new(0.8, p.Y, 0.8), Vector3.new(p.X, p.Y / 2 - 0.6, p.Z), rgb(120, 118, 112))
				detail(block(parent, "Pipe saddle", Vector3.new(3.4, 0.4, 0.9), CFrame.lookAt(p - Vector3.new(0, 0.95, 0), p - Vector3.new(0, 0.95, 0) + perp) * CFrame.Angles(0, math.pi / 2, 0), rgb(90, 90, 86), Enum.Material.Metal))
			end
		end
	end
end

local function steamLeak(parent, at)
	local p = detail(block(parent, "Steam leak", Vector3.new(0.5, 0.5, 0.5), at, rgb(255, 255, 255)))
	p.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Rate = 14
	e.Lifetime = NumberRange.new(2, 4)
	e.Speed = NumberRange.new(2, 4)
	e.SpreadAngle = Vector2.new(25, 25)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 6) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	e.Acceleration = Vector3.new(2, 2, 0)
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = p
end

local function lenin(parent, at)
	local bronze = rgb(58, 54, 48)
	local cf = CFrame.lookAt(at, at + Vector3.new(-1, 0, 0))
	block(parent, "Plinth", Vector3.new(7, 9, 7), cf * CFrame.new(0, 4.5, 0), rgb(90, 50, 48), Enum.Material.Granite)
	detail(block(parent, "Plinth snow", Vector3.new(7.3, 0.4, 7.3), cf * CFrame.new(0, 9.1, 0), SNOW, Enum.Material.Snow))
	local plate = detail(block(parent, "Inscription", Vector3.new(4.6, 1.2, 0.1), cf * CFrame.new(0, 6, -3.56), rgb(90, 50, 48)))
	Build.sign(plate, Enum.NormalId.Front, "В. И. ЛЕНИН", { bg = rgb(90, 50, 48), fg = rgb(214, 180, 100), font = Enum.Font.Oswald })
	-- The figure.
	block(parent, "Lenin legs", Vector3.new(2.4, 4, 1.6), cf * CFrame.new(0, 11.2, 0), bronze, Enum.Material.Metal)
	block(parent, "Lenin coat", Vector3.new(3.4, 5, 2.2), cf * CFrame.new(0, 15.2, 0.1), bronze, Enum.Material.Metal)
	detail(Build.wedge(parent, "Coat tail", Vector3.new(3.4, 3, 2), cf * CFrame.new(0, 11.8, 1.6), bronze, Enum.Material.Metal))
	detail(Build.ball(parent, "Lenin head", 2, cf * CFrame.new(0, 18.7, 0), bronze, Enum.Material.Metal))
	detail(block(parent, "Lenin cap", Vector3.new(2, 0.6, 2.3), cf * CFrame.new(0, 19.6, -0.1), bronze, Enum.Material.Metal))
	detail(block(parent, "Lenin arm", Vector3.new(0.8, 0.8, 4.6), cf * CFrame.new(1.4, 16.8, -2.2) * CFrame.Angles(0.35, 0, 0), bronze, Enum.Material.Metal))
	detail(block(parent, "Lenin arm", Vector3.new(0.8, 3.6, 0.8), cf * CFrame.new(-1.9, 15, 0), bronze, Enum.Material.Metal))
	detail(block(parent, "Snow on shoulders", Vector3.new(3.3, 0.3, 2), cf * CFrame.new(0, 17.8, 0.1), SNOW, Enum.Material.Snow))
	-- Flags and floodlight.
	for _, z in { -7, 7 } do
		local base = (cf * CFrame.new(z, 0, 3)).Position
		block(parent, "Flagpole", Vector3.new(0.3, 16, 0.3), base + Vector3.new(0, 8, 0), rgb(160, 160, 160), Enum.Material.Metal)
		detail(block(parent, "Red flag", Vector3.new(0.1, 2.6, 4), base + Vector3.new(0, 14.6, -2.1), rgb(160, 24, 24), Enum.Material.Fabric))
	end
	local floodPos = (cf * CFrame.new(0, 0.6, -8)).Position
	local flood = detail(block(parent, "Monument floodlight", Vector3.new(1.2, 0.8, 1.2), CFrame.lookAt(floodPos, (cf * CFrame.new(0, 15, 0)).Position), rgb(255, 230, 190), Enum.Material.Neon))
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Angle = 40
	spot.Range = 30
	spot.Brightness = 2
	spot.Color = rgb(255, 220, 180)
	spot.Parent = flood
end

local function boardOfHonour(parent, at, facing)
	local cf = CFrame.lookAt(at, at + facing)
	block(parent, "Board of honour", Vector3.new(18, 9, 0.6), cf * CFrame.new(0, 5.5, 0), rgb(130, 30, 28))
	for _, x in { -8.6, 8.6 } do
		block(parent, "Board post", Vector3.new(0.6, 10, 0.6), cf * CFrame.new(x, 5, 0), rgb(80, 80, 80), Enum.Material.Metal)
	end
	local head = detail(block(parent, "Board title", Vector3.new(17, 1.6, 0.1), cf * CFrame.new(0, 9, -0.36), rgb(130, 30, 28)))
	Build.sign(head, Enum.NormalId.Front, "ДОСКА ПОЧЁТА · ШАХТА № 6", { bg = rgb(130, 30, 28), fg = rgb(240, 214, 120) })
	local names = { "Кузьмин А.", "Остапенко В.", "Волков Г.", "Ибрагимов Р.", "Лебедев С.", "Петренко Н.", "Сидоров П.", "Ткач М.", "Белова Л.", "Орлов Д." }
	for i, n in names do
		local col, row = (i - 1) % 5, math.floor((i - 1) / 5)
		local photo = detail(block(parent, "Photo", Vector3.new(2.4, 3, 0.1), cf * CFrame.new(-6.4 + col * 3.2, 6.4 - row * 3.6, -0.36), rgb(150, 150, 140)))
		local missing = n == "Волков Г." or n == "Сидоров П."
		Build.sign(photo, Enum.NormalId.Front, missing and "✕\n" .. n or "☺\n" .. n, {
			bg = missing and rgb(30, 30, 30) or rgb(170, 166, 150),
			fg = missing and rgb(180, 30, 30) or rgb(60, 56, 50),
			font = Enum.Font.Arimo,
		})
	end
end

