<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[return {
	Title = "NORILSK: LAST SHIFT",
	Spawn = Vector3.new(0, 5, 20),
	Stages = {
		{ name = "Report for your shift", detail = "The mine does not wait. Follow the road to the shaft.", target = Vector3.new(0, 3, -150), action = "Work the shift", duration = 8 },
		{ name = "Collect your evening ration", detail = "The state canteen is open. Your meal ticket is all you have.", target = Vector3.new(65, 3, -60), action = "Eat your ration", duration = 5 },
		{ name = "Walk home", detail = "Return to your apartment. Keep moving.", target = Vector3.new(0, 3, 20), action = "Lock the door", duration = 2 },
	},
}
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="4">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Config = require(ReplicatedStorage.Shared.Config)

local event = Instance.new("RemoteEvent")
event.Name = "Atmosphere"
event.Parent = ReplicatedStorage
local town = Instance.new("Folder")
town.Name = "Norilsk"
town.Parent = workspace
local states = {}

local function block(name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position = name, size, position
	p.Anchored = true
	p.Color = color or Color3.fromRGB(100, 103, 103)
	p.Material = material or Enum.Material.Concrete
	p.Parent = town
	return p
end

local function sign(parent, text, face, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.CanvasSize, gui.Parent = face or Enum.NormalId.Front, Vector2.new(600, 400), parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = color or Color3.fromRGB(109, 28, 25)
	label.TextColor3 = Color3.fromRGB(224, 210, 169)
	label.Font, label.TextScaled, label.TextWrapped = Enum.Font.Oswald, true, true
	label.Text, label.Parent = text, gui
end

Lighting.ClockTime = 16
Lighting.Brightness = 1
Lighting.Ambient = Color3.fromRGB(65, 75, 87)
Lighting.FogColor = Color3.fromRGB(114, 127, 140)
Lighting.FogStart, Lighting.FogEnd = 20, 190
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density, atmosphere.Color, atmosphere.Parent = 0.48, Lighting.FogColor, Lighting
block("Frozen ground", Vector3.new(360, 2, 460), Vector3.new(0, -1, -70), Color3.fromRGB(210, 218, 223), Enum.Material.Snow)
block("Road", Vector3.new(24, 0.2, 240), Vector3.new(0, 0.1, -65), Color3.fromRGB(66, 71, 75), Enum.Material.Asphalt)

for _, x in ipairs({ -45, 45 }) do
	for _, z in ipairs({ 30, -35, -105 }) do
		block("Panel apartment block", Vector3.new(32, 36, 38), Vector3.new(x, 18, z))
		for floor = 1, 5 do
			for column = -1, 1 do
				block("Dark apartment window", Vector3.new(4, 3, 0.3), Vector3.new(x + column * 9, floor * 6, z + 19.2), Color3.fromRGB(26, 36, 43), Enum.Material.Glass)
			end
		end
		local poster = block("Soviet labor poster", Vector3.new(6, 8, 0.3), Vector3.new(x, 6, z + 19.5))
		sign(poster, "СЛАВА ТРУДУ!\nGLORY TO LABOUR")
	end
end

block("Mine building", Vector3.new(50, 16, 25), Vector3.new(0, 8, -180))
local mineSign = block("Mine sign", Vector3.new(22, 5, 0.3), Vector3.new(0, 12, -167.3))
sign(mineSign, "ШАХТА № 6\nMINE No. 6")
block("Chimney", Vector3.new(7, 60, 7), Vector3.new(-26, 30, -185))
block("Canteen", Vector3.new(30, 10, 26), Vector3.new(65, 5, -80))
local canteenSign = block("Canteen sign", Vector3.new(24, 4, 0.3), Vector3.new(65, 8, -66.8))
sign(canteenSign, "СТОЛОВАЯ\nSTATE CANTEEN")
for i = 1, 3 do
	block("Ration tray", Vector3.new(2, 0.2, 1.5), Vector3.new(58 + i * 3, 2, -62), Color3.fromRGB(131, 136, 132), Enum.Material.Metal)
	block("Enamel mug", Vector3.new(0.6, 0.8, 0.6), Vector3.new(58 + i * 3, 2.5, -62), Color3.fromRGB(210, 213, 198), Enum.Material.Metal)
end
local door = block("Apartment entrance", Vector3.new(8, 9, 1), Vector3.new(0, 4.5, 25), Color3.fromRGB(57, 62, 61))
sign(door, "ЖИЛОЙ ДОМ\nWORKERS' HOUSING", Enum.NormalId.Back, Color3.fromRGB(49, 57, 60))
for z = -140, 10, 30 do
	local pole = block("Streetlight", Vector3.new(0.6, 15, 0.6), Vector3.new(-13, 7.5, z), nil, Enum.Material.Metal)
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Parent = Color3.fromRGB(240, 192, 114), 27, 1.5, pole
end

local function update(player, stage)
	player:SetAttribute("Stage", stage)
	local data = Config.Stages[stage]
	player:SetAttribute("Objective", data and data.name or "You survived the last shift.")
	player:SetAttribute("Detail", data and data.detail or "Beyond the door, something waits for tomorrow.")
end

for index, data in ipairs(Config.Stages) do
	local marker = block(data.name, Vector3.new(4, 4, 4), data.target, Color3.fromRGB(115, 110, 94))
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = data.action, data.name
	prompt.HoldDuration, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = data.duration, 10, false
	prompt.Parent = marker
	prompt.Triggered:Connect(function(player)
		local state = states[player]
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not state or state.stage ~= index or not root or (root.Position - data.target).Magnitude > 15 then return end
		state.stage += 1
		update(player, state.stage)
		if state.stage == 3 then event:FireClient(player, "night") end
		if state.stage == 4 then event:FireClient(player, "safe") end
	end)
end

Players.PlayerAdded:Connect(function(player)
	states[player] = { stage = 1 }
	update(player, 1)
	player.CharacterAdded:Connect(function(character)
		local root = character:WaitForChild("HumanoidRootPart")
		states[player].stage = 1
		update(player, 1)
		character:PivotTo(CFrame.new(Config.Spawn))
		event:FireClient(player, "reset")
	end)
end)
Players.PlayerRemoving:Connect(function(player) states[player] = nil end)

task.spawn(function()
	while true do
		task.wait(8)
		for player, state in pairs(states) do
			if state.stage == 3 then event:FireClient(player, "stalker") end
		end
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="5">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">10</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="6">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
player.CameraMode = Enum.CameraMode.LockFirstPerson

local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "LastShift", false, true
gui.Parent = player:WaitForChild("PlayerGui")
local function label(y, height, size)
	local item = Instance.new("TextLabel")
	item.Position, item.Size = UDim2.new(0, 28, 0, y), UDim2.new(1, -56, 0, height)
	item.BackgroundTransparency = 1
	item.TextColor3, item.Font, item.TextSize = Color3.fromRGB(219, 216, 196), Enum.Font.Code, size
	item.TextXAlignment, item.TextWrapped, item.Parent = Enum.TextXAlignment.Left, true, gui
	return item
end
label(35, 28, 18).Text = "NORILSK / WINTER 1984"
local objective = label(72, 38, 23)
local detail = label(115, 55, 16)
local warning = label(195, 40, 19)
local function refresh()
	objective.Text = player:GetAttribute("Objective") or "Report for your shift"
	detail.Text = player:GetAttribute("Detail") or ""
end
player:GetAttributeChangedSignal("Objective"):Connect(refresh)
player:GetAttributeChangedSignal("Detail"):Connect(refresh)
refresh()

local generation = 0
local apparition
local function clear()
	generation += 1
	if apparition then apparition:Destroy(); apparition = nil end
	warning.Text = ""
end
local function silhouette(position)
	local model = Instance.new("Model")
	model.Name = "The Foreman"
	for _, data in ipairs({
		{ Vector3.new(1.9, 5.5, 1), Vector3.new(0, 2.5, 0) },
		{ Vector3.new(1.2, 1.6, 1.2), Vector3.new(0, 6, 0) },
		{ Vector3.new(0.45, 5, 0.5), Vector3.new(-1.3, 2.5, 0) },
		{ Vector3.new(0.45, 5, 0.5), Vector3.new(1.3, 2.5, 0) },
	}) do
		local part = Instance.new("Part")
		part.Anchored, part.CanCollide, part.CastShadow = true, false, false
		part.Size, part.Position = data[1], position + data[2]
		part.Color, part.Material, part.Parent = Color3.fromRGB(8, 10, 12), Enum.Material.SmoothPlastic, model
	end
	model.Parent = workspace
	return model
end

ReplicatedStorage:WaitForChild("Atmosphere").OnClientEvent:Connect(function(kind)
	if kind == "night" then
		Lighting.ClockTime, Lighting.FogEnd, Lighting.Brightness = 0, 95, 0.35
	elseif kind == "safe" then
		clear()
		warning.Text = "The latch catches. Footsteps stop outside."
	elseif kind == "reset" then
		clear()
		Lighting.ClockTime, Lighting.FogEnd, Lighting.Brightness = 16, 190, 1
	elseif kind == "stalker" and player:GetAttribute("Stage") == 3 then
		clear()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local camera = workspace.CurrentCamera
		local direction = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
		if direction.Magnitude < 0.1 then direction = Vector3.new(0, 0, -1) end
		local location = root.Position - direction.Unit * 22 + camera.CFrame.RightVector * 9
		apparition = silhouette(Vector3.new(location.X, 0, location.Z))
		warning.Text = "You hear boots in the snow."
		local token = generation
		task.delay(5, function()
			if token ~= generation then return end
			warning.Text = "Do not stop."
			if apparition then
				for _, part in ipairs(apparition:GetChildren()) do
					TweenService:Create(part, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
			end
			task.delay(0.6, function() if token == generation then clear() end end)
		end)
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>
