local function busStop(parent, at, facing)
	local cf = CFrame.lookAt(at, at + facing)
	block(parent, "Bus shelter back", Vector3.new(10, 7, 0.6), cf * CFrame.new(0, 3.5, 2.4), rgb(150, 150, 146))
	block(parent, "Bus shelter roof", Vector3.new(11, 0.6, 5.6), cf * CFrame.new(0, 7.3, 0.4), rgb(140, 140, 136))
	detail(block(parent, "Shelter roof snow", Vector3.new(10.8, 0.5, 5.4), cf * CFrame.new(0, 7.85, 0.4), SNOW, Enum.Material.Snow))
	for _, x in { -5, 5 } do
		block(parent, "Bus shelter side", Vector3.new(0.6, 7, 5), cf * CFrame.new(x, 3.5, 0.2), rgb(150, 150, 146))
	end
	-- Mosaic of a heroic miner on the back wall.
	local mosaic = detail(block(parent, "Mosaic", Vector3.new(8.6, 4.6, 0.1), cf * CFrame.new(0, 4, 2.05), rgb(90, 120, 150)))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = mosaic
	local tiles = { rgb(70, 110, 150), rgb(90, 130, 160), rgb(200, 170, 70), rgb(170, 60, 40), rgb(230, 220, 190), rgb(60, 90, 120) }
	local r2 = Random.new(6)
	for x = 0, 15 do
		for y = 0, 8 do
			local f = Instance.new("Frame")
			f.Position = UDim2.fromScale(x / 16, y / 9)
			f.Size = UDim2.fromScale(1 / 16 - 0.004, 1 / 9 - 0.006)
			local c = tiles[r2:NextInteger(1, 2)]
			local dx, dy = x - 8, y - 4
			if dx * dx / 9 + dy * dy / 12 < 1 then
				c = tiles[r2:NextInteger(3, 5)]
			end
			f.BackgroundColor3 = c
			f.BorderSizePixel = 0
			f.Parent = gui
		end
	end
	block(parent, "Bus shelter bench", Vector3.new(7, 0.4, 1.4), cf * CFrame.new(0, 1.6, 1.4), rgb(90, 60, 40), Enum.Material.WoodPlanks)
	local sign = detail(block(parent, "Bus stop sign", Vector3.new(2.4, 2.4, 0.15), cf * CFrame.new(-6.5, 7, -1.5), rgb(230, 230, 220)))
	Build.sign(sign, Enum.NormalId.Front, "А\nАВТОБУС № 2\nГОРОД — РУДНИК", { bg = rgb(240, 236, 220), fg = rgb(30, 50, 110), font = Enum.Font.Arimo })
	detail(block(parent, "Bus stop pole", Vector3.new(0.25, 8, 0.25), cf * CFrame.new(-6.5, 4, -1.4), rgb(80, 80, 80), Enum.Material.Metal))
	Build.note(parent, 2, cf * CFrame.new(3.5, 4.2, 1.97) * CFrame.Angles(-math.pi / 2, 0, 0))
end

local function pazBus(parent, cf)
	local body = rgb(190, 160, 70)
	block(parent, "PAZ bus", Vector3.new(7, 6.5, 20), cf * CFrame.new(0, 4.2, 0), body, Enum.Material.SmoothPlastic)
	detail(block(parent, "Bus stripe", Vector3.new(7.1, 0.8, 20.1), cf * CFrame.new(0, 3.2, 0), rgb(150, 40, 30), Enum.Material.SmoothPlastic))
	for z = -7, 7, 3.5 do
		for _, x in { -3.55, 3.55 } do
			detail(block(parent, "Bus window", Vector3.new(0.1, 2, 3), cf * CFrame.new(x, 5.6, z), rgb(30, 36, 40), Enum.Material.Glass))
		end
	end
	detail(block(parent, "Bus windscreen", Vector3.new(6.4, 2.6, 0.1), cf * CFrame.new(0, 5.4, -10.05), rgb(30, 36, 40), Enum.Material.Glass))
	detail(block(parent, "Bus roof snow", Vector3.new(6.8, 0.6, 19.6), cf * CFrame.new(0, 7.75, 0), SNOW, Enum.Material.Snow))
	for _, z in { -6, 6 } do
		for _, x in { -3.4, 3.4 } do
			detail(Build.cylinder(parent, "Bus wheel", 1, 2.6, cf * CFrame.new(x, 1.3, z), rgb(24, 24, 24), Enum.Material.Rubber))
		end
	end
	local route = detail(block(parent, "Route board", Vector3.new(4, 0.8, 0.1), cf * CFrame.new(0, 7, -10.07) * CFrame.Angles(0, math.pi, 0), rgb(240, 240, 230)))
	Build.sign(route, Enum.NormalId.Front, "2  РУДНИК", { bg = rgb(240, 236, 220), fg = rgb(20, 20, 20), font = Enum.Font.Arimo })
end

local function camp(parent, at)
	-- What is left of the Norillag camp the city was built on.
	local wood = rgb(66, 56, 46)
	local tower = at + Vector3.new(0, 0, 0)
	for _, x in { -3, 3 } do
		for _, z in { -3, 3 } do
			detail(Build.beam(parent, "Watchtower leg", tower + Vector3.new(x * 1.3, 0, z * 1.3), tower + Vector3.new(x, 20, z), 0.7, wood, Enum.Material.Wood)).CanCollide = true
		end
	end
	block(parent, "Watchtower floor", Vector3.new(8, 0.6, 8), tower + Vector3.new(0, 20, 0), wood, Enum.Material.WoodPlanks)
	block(parent, "Watchtower rail", Vector3.new(8, 2.4, 0.4), tower + Vector3.new(0, 21.5, -3.8), wood, Enum.Material.WoodPlanks)
	block(parent, "Watchtower rail", Vector3.new(0.4, 2.4, 8), tower + Vector3.new(3.8, 21.5, 0), wood, Enum.Material.WoodPlanks)
	wedge(parent, "Watchtower roof", Vector3.new(9, 3, 4.5), CFrame.new(tower + Vector3.new(0, 25.5, -2.25)), wood, Enum.Material.WoodPlanks)
	wedge(parent, "Watchtower roof", Vector3.new(9, 3, 4.5), CFrame.new(tower + Vector3.new(0, 25.5, 2.25)) * CFrame.Angles(0, math.pi, 0), wood, Enum.Material.WoodPlanks)
	detail(block(parent, "Watchtower roof snow", Vector3.new(9, 0.4, 9), tower + Vector3.new(0, 27.1, 0), SNOW, Enum.Material.Snow))
	local lamp = detail(Build.ball(parent, "Camp lamp", 0.6, tower + Vector3.new(0, 22.5, -3.6), rgb(255, 60, 40), Enum.Material.Neon))
	Build.light(lamp, rgb(255, 60, 40), 14, 0.8)
	Build.tag(lamp, "FlickerLamp")
	-- Fence posts and wire.
	local posts = {}
	for i = 0, 10 do
		local p = at + Vector3.new(10 + i * 6, 0, 12 + math.sin(i) * 1.5)
		local lean = CFrame.Angles(math.rad(rng:NextNumber(-12, 12)), 0, math.rad(rng:NextNumber(-12, 12)))
		detail(block(parent, "Fence post", Vector3.new(0.5, 8, 0.5), CFrame.new(p + Vector3.new(0, 4, 0)) * lean, wood, Enum.Material.Wood)).CanCollide = true
		table.insert(posts, p)
	end
	for i = 1, #posts - 1 do
		if i ~= 5 then
			for _, y in { 2.5, 4.5, 6.5 } do
				detail(Build.beam(parent, "Barbed wire", posts[i] + Vector3.new(0, y, 0), posts[i + 1] + Vector3.new(0, y - 0.3, 0), 0.08, rgb(60, 56, 50), Enum.Material.CorrodedMetal))
			end
		end
	end
	-- A collapsed barrack.
	local b = CFrame.new(at + Vector3.new(30, 0, -16)) * CFrame.Angles(0, 0.2, 0)
	block(parent, "Barrack wall", Vector3.new(30, 6, 0.8), b * CFrame.new(0, 3, -6), wood, Enum.Material.WoodPlanks)
	block(parent, "Barrack wall", Vector3.new(0.8, 6, 12), b * CFrame.new(-15, 3, 0), wood, Enum.Material.WoodPlanks)
	block(parent, "Barrack wall", Vector3.new(14, 4, 0.8), b * CFrame.new(-8, 2, 6) * CFrame.Angles(0.3, 0, 0), wood, Enum.Material.WoodPlanks)
	block(parent, "Collapsed roof", Vector3.new(30, 0.6, 13), b * CFrame.new(0, 3, 0) * CFrame.Angles(0.35, 0, 0.08), wood, Enum.Material.WoodPlanks)
	detail(block(parent, "Roof snow", Vector3.new(29, 0.5, 12), b * CFrame.new(0, 3.5, 0) * CFrame.Angles(0.35, 0, 0.08), SNOW, Enum.Material.Snow))
	-- The plaque and the note.
	local stone = block(parent, "Memorial stone", Vector3.new(3, 3.2, 1.4), CFrame.new(at + Vector3.new(6, 1.6, -6)) * CFrame.Angles(0, 0.4, 0.05), rgb(80, 80, 84), Enum.Material.Granite)
	Build.sign(stone, Enum.NormalId.Front, "НОРИЛЬЛАГ\n1935–1956", { bg = rgb(70, 70, 74), fg = rgb(200, 200, 190), font = Enum.Font.Merriweather })
	Build.note(parent, 6, CFrame.new(at + Vector3.new(6, 3.25, -6)) * CFrame.Angles(0, 0.4, 0.05))
	-- Graves: rows of numbered stakes.
	for i = 0, 11 do
		local p = at + Vector3.new(-20 + (i % 4) * 4, 0, -10 - math.floor(i / 4) * 5)
		local stake = detail(block(parent, "Grave stake", Vector3.new(0.4, 2.6, 0.2), CFrame.new(p + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-10, 10))), wood, Enum.Material.Wood))
		local plate = detail(block(parent, "Number plate", Vector3.new(0.8, 0.5, 0.05), CFrame.new(p + Vector3.new(0, 2.2, -0.13)), rgb(110, 100, 80), Enum.Material.Metal))
		Build.sign(plate, Enum.NormalId.Front, ("Л-%d"):format(100 + i * 7), { bg = rgb(110, 100, 80), fg = rgb(30, 30, 30), font = Enum.Font.Code })
		stake.CanCollide = true
	end
end

function Town.build(world)
	local spots = {}
	local folder = Instance.new("Folder")
	folder.Name = "Town"
	folder.Parent = world

	-- Ground, avenue, sidewalks.
	block(folder, "Snow", Vector3.new(1000, 2, 1000), Vector3.new(0, -1, -100), SNOW, Enum.Material.Snow)
	block(folder, "Road", Vector3.new(28, 0.2, 330), Vector3.new(0, 0.1, -55), rgb(150, 154, 160), Enum.Material.Snow)
	for _, x in { -9, -4, 4, 9 } do
		detail(block(folder, "Rut", Vector3.new(1.3, 0.05, 330), Vector3.new(x, 0.22, -55), rgb(96, 98, 102), Enum.Material.Asphalt))
	end
	for _, x in { -18, 18 } do
		block(folder, "Sidewalk", Vector3.new(8, 0.4, 330), Vector3.new(x, 0.2, -55), rgb(196, 202, 208), Enum.Material.Snow)
		for z = 105, -205, -12 do
			detail(wedge(folder, "Plowed snow", Vector3.new(1.6, 1.4, 10), CFrame.new(x + (x < 0 and 4.6 or -4.6), 0.7, z) * CFrame.Angles(0, x < 0 and math.pi / 2 or -math.pi / 2, 0) * CFrame.Angles(0, 0, 0), SNOW, Enum.Material.Snow))
		end
	end
	-- Courtyard and side paths (trodden snow).
	block(folder, "Path", Vector3.new(90, 0.2, 14), Vector3.new(-60, 0.1, -40), rgb(190, 196, 202), Enum.Material.Snow)
	block(folder, "Path", Vector3.new(12, 0.2, 130), Vector3.new(-100, 0.1, 15), rgb(190, 196, 202), Enum.Material.Snow)

	-- Panel housing.
	local _, w1doors = apartmentBlock(folder, "Building 14", CFrame.lookAt(Vector3.new(-75, 0, 30), Vector3.new(-74, 0, 30)), 110, {
		entrances = { -30, 0, 30 },
		address = "ЛЕНИНСКИЙ ПР., 14",
		gablePoster = 1,
		gableSide = -1,
		color = CONCRETE[1],
	})
	apartmentBlock(folder, "Building 16", CFrame.lookAt(Vector3.new(-75, 0, -110), Vector3.new(-74, 0, -110)), 110, {
		entrances = { -30, 0, 30 },
		address = "ЛЕНИНСКИЙ ПР., 16",
		gablePoster = 3,
		gableSide = -1,
		color = CONCRETE[2],
	})
	apartmentBlock(folder, "Building 15", CFrame.lookAt(Vector3.new(75, 0, 30), Vector3.new(74, 0, 30)), 110, {
		entrances = { -30, 0, 30 },
		address = "ЛЕНИНСКИЙ ПР., 15",
		shop = "ГАСТРОНОМ",
		shopWindow = "КОНСЕРВЫ · ХЛЕБ · МОЛОКО\n(полки пусты)",
		shopFrom = -20,
		shopTo = 20,
		gablePoster = 2,
		gableSide = 1,
		color = CONCRETE[3],
	})
	apartmentBlock(folder, "Building 12", CFrame.lookAt(Vector3.new(-165, 0, 30), Vector3.new(-166, 0, 30)), 110, {
		entrances = { -30, 0, 30 },
		address = "УЛ. ГОРНЯКОВ, 12",
		color = CONCRETE[4],
	})
	apartmentBlock(folder, "Building 9", CFrame.lookAt(Vector3.new(0, 0, 150), Vector3.new(0, 0, 149)), 140, {
		entrances = { -40, 0, 40 },
		address = "ЛЕНИНСКИЙ ПР., 9",
		gablePoster = 7,
		gableSide = 1,
		color = CONCRETE[5],
	})
	apartmentBlock(folder, "Building 21", CFrame.lookAt(Vector3.new(165, 0, -40), Vector3.new(164, 0, -40)), 120, {
		entrances = { -35, 0, 35 },
		address = "УЛ. ЗАВЕНЯГИНА, 21",
		lit = 0.15,
		color = CONCRETE[2],
	})
	apartmentBlock(folder, "Building 18", CFrame.lookAt(Vector3.new(-165, 0, -110), Vector3.new(-166, 0, -110)), 110, {
		entrances = { -30, 0, 30 },
		address = "ЛЕНИНСКИЙ ПР., 18",
		lit = 0.12,
		color = CONCRETE[1],
	})
	-- Make the home entrance obvious: a hand-painted number on the door.
	local homeDoor = w1doors[2]
	Build.sign(homeDoor, Enum.NormalId.Back, "2", { bg = rgb(70, 52, 38), bgTransparency = 1, fg = rgb(220, 210, 180) })
	spots.homeDoorOut = CFrame.lookAt(Config.Places.HomeDoor + Vector3.new(-7, 3, 0), Config.Places.HomeDoor + Vector3.new(-20, 3, -25))
	Build.interact(homeDoor, "unlock", "Unlock the door", "Building 14, entrance 2", 3)

	-- Posters along the street.
	local posterSpots = {
		{ Vector3.new(-59.8, 6, 10), Vector3.xAxis, 1 },
		{ Vector3.new(-59.8, 6, 55), Vector3.xAxis, 4 },
		{ Vector3.new(59.8, 6, 70), -Vector3.xAxis, 6 },
		{ Vector3.new(-59.8, 6, -90), Vector3.xAxis, 7 },
		{ Vector3.new(-59.8, 6, -140), Vector3.xAxis, 5 },
		{ Vector3.new(-90.2, 6, 45), -Vector3.xAxis, 4 },
		{ Vector3.new(-149.8, 6, 15), Vector3.xAxis, 3 },
	}
	for _, p in posterSpots do
		Build.poster(folder, face(p[1], p[2]), Config.Posters[p[3]])
	end

	-- Street lights. Some are dead.
	local i = 0
	for z = 100, -190, -30 do
		for _, x in { -16, 16 } do
			i += 1
			streetlight(folder, Vector3.new(x, 0, z), Vector3.new(x < 0 and 1 or -1, 0, 0), i % 5 ~= 3)
		end
	end
	streetlight(folder, Vector3.new(-120, 0, 0), Vector3.new(1, 0, 0), true)
	streetlight(folder, Vector3.new(-120, 0, 62), Vector3.new(1, 0, 0), false)
	streetlight(folder, Vector3.new(-60, 0, -48), Vector3.new(0, 0, 1), true)

	-- Courtyard.
	playground(folder, Vector3.new(-125, 0, 25))
	garages(folder, Vector3.new(-142, 0, 74), 5)
	lada(folder, CFrame.new(-110, 0, -8) * CFrame.Angles(0, 0.3, 0), rgb(150, 60, 50))
	lada(folder, CFrame.new(-10.5, 0, 45), rgb(220, 214, 190))
	lada(folder, CFrame.new(10.5, 0, -30) * CFrame.Angles(0, math.pi, 0), rgb(70, 110, 90))
	-- Washing line nobody took in.
	detail(Build.beam(folder, "Washing line", Vector3.new(-140, 7, 50), Vector3.new(-110, 7, 50), 0.06, rgb(200, 200, 200)))
	for k = 0, 3 do
		detail(block(folder, "Frozen shirt", Vector3.new(1.8, 2.4, 0.1), Vector3.new(-134 + k * 6, 5.7, 50), ({ rgb(200, 200, 190), rgb(90, 110, 140), rgb(160, 60, 60), rgb(200, 200, 190) })[k + 1], Enum.Material.Fabric))
	end
	for _, x in { -140, -110 } do
		block(folder, "Line post", Vector3.new(0.4, 7.5, 0.4), Vector3.new(x, 3.75, 50), rgb(90, 90, 90), Enum.Material.Metal)
	end

	-- Heating mains, with the iconic arch over the avenue.
	heatingPipes(folder, {
		Vector3.new(-28, 2.6, 100),
		Vector3.new(-28, 2.6, -22),
		Vector3.new(-28, 10, -22),
		Vector3.new(-28, 10, -58),
		Vector3.new(-28, 2.6, -58),
		Vector3.new(-28, 2.6, -140),
		Vector3.new(-28, 15, -140),
		Vector3.new(30, 15, -140),
		Vector3.new(30, 2.6, -140),
		Vector3.new(30, 2.6, -196),
	})
	steamLeak(folder, Vector3.new(-28, 3.4, 64))
	steamLeak(folder, Vector3.new(10, 15.6, -140))

	-- Plaza, monument, kiosk, booth, bus stop, board of honour.
	block(folder, "Plaza", Vector3.new(50, 0.3, 46), Vector3.new(48, 0.15, -50), rgb(176, 180, 186), Enum.Material.Snow)
	lenin(folder, Vector3.new(58, 0.3, -50))
	kiosk(folder, Vector3.new(-22.5, 0.4, -78), Vector3.xAxis)
	phoneBooth(folder, Vector3.new(-21.5, 0.4, -120), Vector3.xAxis)
	busStop(folder, Vector3.new(24, 0.4, -165), -Vector3.xAxis)
	pazBus(folder, CFrame.new(9, 0, -168))
	boardOfHonour(folder, Vector3.new(26, 0, -5), -Vector3.xAxis)

	-- Things people left in the snow.
	local r = Random.new(41)
	for _ = 1, 40 do
		local p = Vector3.new(r:NextNumber(-140, 140), 0, r:NextNumber(-190, 110))
		if math.abs(p.X) > 30 and (math.abs(p.X) < 55 or math.abs(p.X) > 95) then
			detail(Build.ball(folder, "Snow mound", r:NextNumber(3, 7), p - Vector3.new(0, 1.2, 0), SNOW, Enum.Material.Snow))
		end
	end

	apartmentInterior(folder, Config.Places.Apartment, spots)
	camp(folder, Vector3.new(-230, 0, -150))

	-- Keep people inside the map.
	for _, w in {
		{ Vector3.new(4, 80, 900), Vector3.new(-320, 40, -100) },
		{ Vector3.new(4, 80, 900), Vector3.new(320, 40, -100) },
		{ Vector3.new(700, 80, 4), Vector3.new(0, 40, 240) },
		{ Vector3.new(700, 80, 4), Vector3.new(0, 40, -440) },
	} do
		local wall = block(folder, "Boundary", w[1], w[2])
		wall.Transparency = 1
	end

	return spots
end

return Town
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX00000016"><Properties><string name="Name">StarterPlayer</string><token name="CameraMode">1</token><float name="CharacterWalkSpeed">10</float><bool name="CharacterUseJumpPower">false</bool><float name="CharacterJumpHeight">3.5</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000014"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- The world's mood: lighting and fog per place and time, falling snow, breath, wind,
-- flickering lights, posters that change at night, the canteen radio and the mine lamps.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Audio = require(script.Parent.Audio)

local Ambience = {}

local rgb = Color3.fromRGB
local stage = 1
local region = "outdoor"
local ctx
local atmosphere, colour, bloom
local snowFar, snowNear, snowPart, nearPart
local breathPart, breath
local wind, hum
local profileKey
local tvWindows, tvScreens = {}, {}

local PROFILES = {
	outdoor = {
		lighting = { ClockTime = 23.4, Brightness = 0.45, Ambient = rgb(22, 26, 34), OutdoorAmbient = rgb(48, 56, 72), EnvironmentDiffuseScale = 0.25, EnvironmentSpecularScale = 0.3, ExposureCompensation = 0.1 },
		atmosphere = { Density = 0.38, Offset = 0.15, Color = rgb(104, 116, 134), Decay = rgb(56, 64, 82), Glare = 0, Haze = 1.6 },
		colour = { Saturation = -0.3, Contrast = 0.12, Brightness = 0, TintColor = rgb(214, 224, 240) },
	},
	night = {
		lighting = { ClockTime = 0.3, Brightness = 0.18, Ambient = rgb(10, 12, 16), OutdoorAmbient = rgb(24, 28, 38), EnvironmentDiffuseScale = 0.15, EnvironmentSpecularScale = 0.2, ExposureCompensation = 0 },
		atmosphere = { Density = 0.48, Offset = 0.1, Color = rgb(58, 66, 82), Decay = rgb(28, 32, 44), Glare = 0, Haze = 2 },
		colour = { Saturation = -0.45, Contrast = 0.18, Brightness = -0.02, TintColor = rgb(200, 212, 236) },
	},
	indoor = {
		lighting = { ClockTime = 23.4, Brightness = 0.3, Ambient = rgb(34, 32, 30), OutdoorAmbient = rgb(30, 34, 44), EnvironmentDiffuseScale = 0.3, EnvironmentSpecularScale = 0.3, ExposureCompensation = 0.1 },
		atmosphere = { Density = 0.22, Offset = 0, Color = rgb(70, 76, 86), Decay = rgb(40, 44, 54), Glare = 0, Haze = 0.5 },
		colour = { Saturation = -0.2, Contrast = 0.1, Brightness = 0, TintColor = rgb(236, 232, 222) },
	},
	nightIndoor = {
		lighting = { ClockTime = 0.3, Brightness = 0.15, Ambient = rgb(20, 18, 18), OutdoorAmbient = rgb(16, 18, 24), EnvironmentDiffuseScale = 0.2, EnvironmentSpecularScale = 0.2, ExposureCompensation = 0 },
		atmosphere = { Density = 0.25, Offset = 0, Color = rgb(40, 44, 52), Decay = rgb(20, 22, 28), Glare = 0, Haze = 0.5 },
		colour = { Saturation = -0.35, Contrast = 0.15, Brightness = -0.02, TintColor = rgb(226, 222, 214) },
	},
	underground = {
		lighting = { ClockTime = 0, Brightness = 0, Ambient = rgb(7, 7, 8), OutdoorAmbient = rgb(0, 0, 0), EnvironmentDiffuseScale = 0, EnvironmentSpecularScale = 0.2, ExposureCompensation = 0.15 },
		atmosphere = { Density = 0.42, Offset = 0, Color = rgb(10, 9, 9), Decay = rgb(4, 4, 4), Glare = 0, Haze = 0 },
		colour = { Saturation = -0.25, Contrast = 0.15, Brightness = 0, TintColor = rgb(240, 228, 210) },
	},
}

local function inBox(p, box)
	local a, b = box[1], box[2]
	return p.X >= a.X and p.X <= b.X and p.Y >= a.Y and p.Y <= b.Y and p.Z >= a.Z and p.Z <= b.Z
end

function Ambience.regionAt(p)
	if p.Y < Config.UndergroundBelow then
		return "underground"
	end
	for _, box in Config.Interiors do
		if inBox(p, box) then
			return "indoor"
		end
	end
	return "outdoor"
end

function Ambience.region()
	return region
end

function Ambience.night()
	return stage >= Config.NightFrom
end

local function applyProfile(key, time)
	if key == profileKey then
		return
	end
	profileKey = key
	local p = PROFILES[key]
	local info = TweenInfo.new(time or 1.2, Enum.EasingStyle.Sine)
	-- ClockTime can't tween across midnight nicely; set it directly.
	Lighting.ClockTime = p.lighting.ClockTime
	local goal = table.clone(p.lighting)
	goal.ClockTime = nil
	TweenService:Create(Lighting, info, goal):Play()
	TweenService:Create(atmosphere, info, p.atmosphere):Play()
	TweenService:Create(colour, info, p.colour):Play()
end

local function profileFor()
	local night = stage >= Config.NightFrom
	if region == "underground" then
		return "underground"
	elseif region == "indoor" then
		return night and "nightIndoor" or "indoor"
	end
	return night and "night" or "outdoor"
end

local function setupEffects()
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
	local sky = Instance.new("Sky")
	sky.StarCount = 800
	sky.MoonAngularSize = 9
	sky.SunAngularSize = 0
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting
	atmosphere = Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	colour = Instance.new("ColorCorrectionEffect")
	colour.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.8
	bloom.Size = 30
	bloom.Threshold = 0.92
	bloom.Parent = Lighting
	local sun = Instance.new("SunRaysEffect")
	sun.Intensity = 0
	sun.Parent = Lighting
end

local function emitter(part, rate, size, speed)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Rate = rate
	e.Lifetime = NumberRange.new(5, 8)
	e.Speed = NumberRange.new(speed[1], speed[2])
	e.SpreadAngle = Vector2.new(20, 20)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.7) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.08, 0.15), NumberSequenceKeypoint.new(0.85, 0.25), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(rgb(240, 244, 250))
	e.LightInfluence = 0.75
	e.LightEmission = 0.15
	e.Brightness = 1.4
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Acceleration = Vector3.new(6, -2, 2)
	e.Parent = part
	return e
end

local function setupSnow()
	local function holder(name, size)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = size
		p.Parent = workspace
		return p
	end
	snowPart = holder("Snowfall", Vector3.new(170, 1, 170))
	nearPart = holder("Snowfall near", Vector3.new(36, 1, 36))
	snowFar = emitter(snowPart, 450, 0.16, { 7, 11 })
	snowNear = emitter(nearPart, 140, 0.22, { 9, 13 })
	snowNear.Lifetime = NumberRange.new(1.5, 2.5)

	breathPart = holder("Breath", Vector3.new(0.4, 0.4, 0.4))
	breath = Instance.new("ParticleEmitter")
	breath.Texture = "rbxasset://textures/particles/smoke_main.dds"
	breath.Rate = 0
	breath.Lifetime = NumberRange.new(1, 1.6)
	breath.Speed = NumberRange.new(1.2, 2)
	breath.SpreadAngle = Vector2.new(15, 15)
	breath.EmissionDirection = Enum.NormalId.Front
	breath.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1.4) })
	breath.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) })
	breath.LightInfluence = 0.6
	breath.Acceleration = Vector3.new(0, 0.6, 0)
	breath.Parent = breathPart
end

-- Light registry: everything that can flicker or be switched off by the entity.
local lamps = {}
local function register(part, kind)
	local light = part:FindFirstChildWhichIsA("Light")
	local entry = { part = part, light = light, kind = kind, color = part.Color, material = part.Material, brightness = light and light.Brightness or 0, off = false, phase = math.random() * 100 }
	lamps[part] = entry
	return entry
end

function Ambience.setLamp(entry, on, level)
	level = level or 1
	if entry.light then
		entry.light.Enabled = on
		entry.light.Brightness = entry.brightness * level
	end
	if on then
		entry.part.Color = entry.color
		entry.part.Material = entry.material
	else
		entry.part.Color = rgb(40, 36, 32)
		entry.part.Material = Enum.Material.Glass
	end
end

function Ambience.lampsOfKind(kind)
	local out = {}
	for _, e in lamps do
		if e.kind == kind then
			table.insert(out, e)
		end
	end
	return out
end

local function setupLamps()
	for _, kind in { "Streetlight", "EntranceLamp", "FlickerLamp", "MineLamp", "CanteenLight", "Beacon" } do
		for _, part in CollectionService:GetTagged(kind) do
			register(part, kind)
		end
	end
	-- A few streetlights in "sector 4" (near the canteen) never work properly.
	for _, e in Ambience.lampsOfKind("Streetlight") do
		local z = e.part.Position.Z
		e.bad = (z < -95 and z > -175) or math.random() < 0.1
	end
end

-- Mine lamps die one after another, from the far end towards the cage.
local mineDead = false
function Ambience.killMineLamps()
	if mineDead then
		return
	end
	mineDead = true
	local list = Ambience.lampsOfKind("MineLamp")
	table.sort(list, function(a, b)
		return (a.part:GetAttribute("Order") or 0) > (b.part:GetAttribute("Order") or 0)
	end)
	task.spawn(function()
		for i, e in list do
			if not mineDead then
				return
			end
			e.dying = true
			task.delay(0.6, function()
				e.dying = false
				if mineDead then
					e.off = true
					Ambience.setLamp(e, false)
				end
			end)
			if i % 3 == 0 then
				task.wait(0.35)
			end
		end
	end)
end

function Ambience.restoreMineLamps()
	mineDead = false
	for _, e in Ambience.lampsOfKind("MineLamp") do
		e.off = false
		e.dying = false
		Ambience.setLamp(e, true)
	end
end

local function setPosters(night)
	for _, part in CollectionService:GetTagged("Poster") do
		local gui = part:FindFirstChildWhichIsA("SurfaceGui")
		local title = gui and gui:FindFirstChild("Title", true)
		local sub = gui and gui:FindFirstChild("Sub", true)
		if title and sub then
			title.Text = night and part:GetAttribute("NightTitle") or part:GetAttribute("DayTitle")
			sub.Text = night and part:GetAttribute("NightSub") or part:GetAttribute("DaySub")
		end
	end
end

local function setClocks()
	local clock = Config.Stages[stage].clock
	for _, part in CollectionService:GetTagged("WallClock") do
		local label = part:FindFirstChild("Text", true)
		if label then
			label.Text = clock
		end
	end
end

function Ambience.updateSeams(done)
	local set = {}
	for n in string.gmatch(done or "", "%d+") do
		set[tonumber(n)] = true
	end
	for _, mark in CollectionService:GetTagged("SeamMark") do
		local gui = mark:FindFirstChildWhichIsA("SurfaceGui")
		if gui then
			gui.Enabled = not set[mark:GetAttribute("Seam")]
		end
	end
	for _, ore in CollectionService:GetTagged("Seam") do
		local n = ore:GetAttribute("Seam")
		ore.Color = set[n] and Color3.fromRGB(52, 46, 40) or Color3.fromRGB(110, 92, 52)
		local prompt = ore:FindFirstChildWhichIsA("ProximityPrompt")
		if prompt then
			prompt:SetAttribute("Done", set[n] == true)
		end
	end
end

-- The canteen scare: the lights fail, everyone turns to look at you, something is at the window.
local canteenTime = 0
local canteenScared = false
local radioTimer = 4
local radioIndex = 0

local function canteenScare()
	canteenScared = true
	local tubes = Ambience.lampsOfKind("CanteenLight")
	task.spawn(function()
		for _ = 1, 8 do
			for _, e in tubes do
				Ambience.setLamp(e, math.random() < 0.5)
			end
			task.wait(0.08)
		end
		for _, e in tubes do
			Ambience.setLamp(e, false)
		end
		ctx.People.stare(true)
		ctx.Ui.static(0.3, 0.4)
		ctx.Ui.say("Радио «Маяк»: …ш-ш-ш… не оглядывайся… он уже здесь…", 4)
		local spot = Config.Places.CanteenWindowSpot
		ctx.Entity.showAt(CFrame.lookAt(spot, spot + Vector3.new(1, 0, 0)), 7)
		Audio.play("Sting", { volume = 0.8 })
		task.wait(2.6)
		for _, e in tubes do
			Ambience.setLamp(e, true)
		end
		task.wait(2.5)
		ctx.People.stare(false)
	end)
end

function Ambience.onStage(s)
	local wasNight = stage >= Config.NightFrom
	stage = s
	local night = s >= Config.NightFrom
	if night ~= wasNight or s == 1 then
		setPosters(night)
	end
	setClocks()
	if s < 6 then
		Ambience.restoreMineLamps()
	elseif s == 6 then
		Ambience.killMineLamps()
	end
	if s ~= 8 then
		canteenTime = 0
		canteenScared = false
	end
	profileKey = nil
	applyProfile(profileFor(), 0.5)
	-- At night the snow comes down harder.
	snowFar.Rate = night and 650 or 450
	snowNear.Rate = night and 200 or 140
end

local breathTimer = 0
local gust = 0
local function update(dt)
	local camera = workspace.CurrentCamera
	local camCF = camera.CFrame
	local camPos = camCF.Position
	local t = os.clock()

	local newRegion = Ambience.regionAt(camPos)
	if newRegion ~= region then
		region = newRegion
		SoundService.AmbientReverb = region == "underground" and Enum.ReverbType.Cave or (region == "indoor" and Enum.ReverbType.Room or Enum.ReverbType.Mountains)
	end
	applyProfile(profileFor())

	-- Snow follows the camera, drifting with the wind.
	local outside = region == "outdoor"
	snowFar.Enabled = outside
	snowNear.Enabled = outside
	gust = math.sin(t * 0.21) * 0.5 + math.sin(t * 0.67) * 0.3 + 0.6
	local windVec = Vector3.new(6 + gust * 7, -2, 2 + gust)
	snowFar.Acceleration = windVec
	snowNear.Acceleration = windVec
	snowPart.CFrame = CFrame.new(camPos + Vector3.new(-windVec.X * 2.5, 38, -windVec.Z * 2.5))
	nearPart.CFrame = CFrame.new(camPos + Vector3.new(-windVec.X * 0.8, 12, 0) + camCF.LookVector * 8)

	-- Your breath in the cold.
	breathPart.CFrame = camCF * CFrame.new(0, -0.6, -1.2)
	breathTimer -= dt
	if breathTimer <= 0 then
		local running = ctx.isSprinting and ctx.isSprinting()
		breathTimer = running and 1.4 or 3.2
		if outside or region == "underground" then
			breath:Emit(running and 6 or 4)
		end
	end

	-- Wind and the hum of the mine.
	local windTarget = outside and (0.25 + gust * 0.2) * (stage >= Config.NightFrom and 1.5 or 1) or (region == "indoor" and 0.06 or 0)
	wind.Volume += (windTarget - wind.Volume) * math.min(dt * 2, 1)
	wind.PlaybackSpeed = 0.3 + gust * 0.08
	local humTarget = region == "underground" and (stage == 6 and 0.12 or 0.3) or 0
	hum.Volume += (humTarget - hum.Volume) * math.min(dt * 2, 1)

	-- Lights.
	for _, e in lamps do
		if e.off or e.killed then
			continue
		end
		if e.kind == "Beacon" then
			local on = (t + e.phase * 0.01) % 2 < 1
			Ambience.setLamp(e, on)
		elseif e.dying then
			Ambience.setLamp(e, math.random() < 0.4, math.random())
		elseif e.kind == "FlickerLamp" or (e.kind == "Streetlight" and e.bad) then
			local n = math.noise(t * 3, e.phase)
			Ambience.setLamp(e, n > -0.25, 0.6 + n * 0.5)
		elseif e.kind == "MineLamp" and math.noise(t * 2, e.phase) > 0.42 then
			Ambience.setLamp(e, math.random() < 0.7, 0.5 + math.random() * 0.5)
		elseif e.kind == "MineLamp" then
			Ambience.setLamp(e, true)
		end
	end
	for _, w in tvWindows do
		local n = math.noise(t * 4, w.Position.X)
		w.Color = rgb(50 + n * 30, 70 + n * 40, 110 + n * 50)
	end
	for _, s in tvScreens do
		local on = stage == 1 or stage == Config.FinalStage
		s.Material = on and Enum.Material.Neon or Enum.Material.Glass
		local n = math.random()
		s.Color = on and rgb(60 + n * 40, 64 + n * 40, 70 + n * 40) or rgb(38, 46, 44)
	end
	if stage >= Config.NightFrom then
		for _, seat in CollectionService:GetTagged("Swing") do
			local base = seat:GetAttribute("Base")
			if not base then
				base = seat.CFrame
				seat:SetAttribute("Base", base)
			end
			local pivot = base * CFrame.new(0, 6, 0)
			seat.CFrame = pivot * CFrame.Angles(math.sin(t * 1.1) * 0.35, 0, 0) * CFrame.new(0, -6, 0)
		end
	end

	-- The canteen: radio chatter, and once per evening, the scare.
	if region == "indoor" and stage >= 7 and stage <= 8 and inBox(camPos, Config.Interiors[2]) then
		radioTimer -= dt
		if radioTimer <= 0 then
			radioIndex = radioIndex % (#Config.Radio - 1) + 1
			local line = Config.Radio[radioIndex]
			if stage == 8 and canteenScared then
				line = Config.Radio[#Config.Radio]
			end
			ctx.Ui.say(line, 6)
			radioTimer = 14
		end
		if stage == 8 then
			canteenTime += dt
			if canteenTime > 9 and not canteenScared then
				canteenScare()
			end
		end
	end
end

function Ambience.init(context)
	ctx = context
	setupEffects()
	setupSnow()
	setupLamps()
	tvWindows = CollectionService:GetTagged("TVWindow")
	tvScreens = CollectionService:GetTagged("TVScreen")
	wind = Audio.make("Wind")
	wind.Volume = 0
	wind:Play()
	hum = Audio.make("MineHum")
	hum.Volume = 0
	hum:Play()
	applyProfile("indoor", 0)
	RunService.RenderStepped:Connect(update)
end

-- Used by the entity: switch off lights near it, restore them when it has passed.
function Ambience.killLightsNear(position, radius, restoreRadius)
	for _, e in lamps do
		if e.kind ~= "Streetlight" and e.kind ~= "EntranceLamp" and e.kind ~= "FlickerLamp" then
			continue
		end
		local offset = e.part.Position - position
		local d = Vector3.new(offset.X, 0, offset.Z).Magnitude
		if not e.killed and d < radius then
			e.killed = true
			Ambience.setLamp(e, false)
		elseif e.killed and d > restoreRadius then
			e.killed = false
			Ambience.setLamp(e, true)
		end
	end
end

function Ambience.restoreAllLights()
	for _, e in lamps do
		if e.killed then
			e.killed = false
			Ambience.setLamp(e, true)
		end
	end
end

return Ambience
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[-- Sounds from Config.Audio: 2D one-shots, 3D one-shots at a point, and loops.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Audio = {}

function Audio.make(name, parent, opts)
	local data = Config.Audio[name]
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = data.id
	s.Volume = (opts and opts.volume) or data.volume or 1
	s.PlaybackSpeed = (opts and opts.pitch) or data.pitch or 1
	s.Looped = data.looped or false
	s.RollOffMaxDistance = (opts and opts.range) or 120
	s.RollOffMinDistance = 6
	s.Parent = parent or SoundService
	return s
end

function Audio.play(name, opts)
	local s = Audio.make(name, SoundService, opts)
	s:Play()
	Debris:AddItem(s, 15)
	return s
end

function Audio.at(name, position, opts)
	local holder = Instance.new("Attachment")
	holder.WorldPosition = position
	holder.Parent = workspace.Terrain
	local s = Audio.make(name, holder, opts)
	s:Play()
	Debris:AddItem(holder, (opts and opts.life) or 10)
	return s
end

return Audio
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX0000000F"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Norilsk: Last Shift. Client entry point.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
ReplicatedStorage:WaitForChild("WorldReady")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Ui = require(script.Parent.Ui)
local Audio = require(script.Parent.Audio)
local Ambience = require(script.Parent.Ambience)
local People = require(script.Parent.People)
local Entity = require(script.Parent.Entity)

player.CameraMode = Enum.CameraMode.LockFirstPerson
workspace.CurrentCamera.FieldOfView = 72
for _, kind in { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu } do
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, kind, false)
end

Ui.init()
Ui.black("")

-- Flashlight: a pocket torch at first, the helmet lamp once you have collected it.
local lamp = Instance.new("Part")
lamp.Name = "Flashlight"
lamp.Anchored = true
lamp.CanCollide = false
lamp.CanQuery = false
lamp.CanTouch = false
lamp.Transparency = 1
lamp.Size = Vector3.new(0.2, 0.2, 0.2)
lamp.Parent = workspace
local beam = Instance.new("SpotLight")
beam.Face = Enum.NormalId.Front
beam.Shadows = true
beam.Color = Color3.fromRGB(255, 226, 180)
beam.Enabled = false
beam.Parent = lamp
local lampOn = false
local flicker = 0
local introPlaying = true

local function lampStats()
	if player:GetAttribute("HasLamp") then
		return 60, 2.4, 62
	end
	return 38, 1.5, 44
end

local function setLamp(on)
	lampOn = on
	beam.Enabled = on
	Audio.play("Click")
end

-- Sprinting.
local stamina = 1
local exhausted = false
local sprintHeld = false
local sprinting = false
local frozen = false

-- Camera shake and head bob go through Humanoid.CameraOffset.
local shakeUntil, shakeStrength = 0, 0
local bobT = 0

local ctx = {
	Ui = Ui,
	Ambience = Ambience,
	People = People,
	Entity = Entity,
}
function ctx.isSprinting()
	return sprinting
end
function ctx.shake(duration, strength)
	shakeUntil = os.clock() + duration
	shakeStrength = strength
end
function ctx.freeze(on)
	frozen = on
end
function ctx.flashlightFlicker(level)
	flicker = level
end

Ambience.init(ctx)
People.init()
Entity.init(ctx)

-- Prompts only show when they matter.
local PROMPT_STAGE = { leaveHome = 1, clockIn = 2, lamp = 3, cageDown = 4, seam = 5, cageUp = 6, coupon = 7, eat = 8, unlock = 9 }
local function refreshPrompts()
	local stage = player:GetAttribute("Stage") or 1
	for _, prompt in CollectionService:GetTagged("StagePrompt") do
		local action = prompt:GetAttribute("Action")
		local want = PROMPT_STAGE[action]
		if action == "note" then
			prompt.Enabled = true
			local found = string.find("," .. (player:GetAttribute("NotesFound") or "") .. ",", "," .. tostring(prompt:GetAttribute("NoteId")) .. ",", 1, true)
			prompt.ActionText = found and "Read again" or "Read"
		elseif action == "seam" then
			prompt.Enabled = stage == 5 and not prompt:GetAttribute("Done")
		elseif action == "cageDown" then
			prompt.Enabled = stage >= 2 and stage <= 4
		elseif action == "cageUp" then
			prompt.Enabled = stage == 5 or stage == 6
		elseif want then
			prompt.Enabled = stage == want
		end
	end
end

local lastStage = 0
local function onStage()
	local stage = player:GetAttribute("Stage") or 1
	local data = Config.Stages[stage]
	if stage == 5 then
		local count = player:GetAttribute("SeamCount") or 0
		Ui.setObjective(("%s · %d / %d"):format(data.ru, count, Config.SeamCount), data.en)
	else
		Ui.setObjective(data.ru, data.en)
	end
	Ui.setClock(("НОРИЛЬСК · 12 ДЕКАБРЯ 1984 · %s · −41 °C"):format(data.clock))
	Ambience.onStage(stage)
	People.onStage(stage)
	Entity.setMode(data.threat)
	refreshPrompts()
	-- Inner voice at key moments.
	if stage ~= lastStage then
		if stage == 6 then
			task.delay(2, function()
				Ui.say("The lamps are going out, one by one, from the far end. Something is walking in the dark. Get to the cage.", 7)
			end)
			setLamp(true)
		elseif stage == 9 then
			task.delay(4, function()
				Ui.say("No one on the street. No one at all. Don't stop walking. If you must look back — don't look for long.", 8)
			end)
		elseif stage == 2 and lastStage == 1 then
			task.delay(3, function()
				Ui.say("Others from the block are already trudging to the mine. Follow them north.", 6)
			end)
		end
	end
	lastStage = stage
end
player:GetAttributeChangedSignal("Stage"):Connect(onStage)
player:GetAttributeChangedSignal("SeamCount"):Connect(onStage)
player:GetAttributeChangedSignal("SeamsDone"):Connect(function()
	Ambience.updateSeams(player:GetAttribute("SeamsDone"))
	refreshPrompts()
end)
player:GetAttributeChangedSignal("NotesFound"):Connect(refreshPrompts)
player:GetAttributeChangedSignal("NoteCount"):Connect(function()
	Ui.setNotes(player:GetAttribute("NoteCount") or 0, #Config.Notes)
end)
player:GetAttributeChangedSignal("HasLamp"):Connect(function()
	if player:GetAttribute("HasLamp") then
		Ui.hint("F — helmet lamp · Shift — run · E — interact")
	end
end)

-- Ending: you are home. Something knocks.
local function ending()
	local door = Config.Places.Apartment + Vector3.new(8, 4, 9.6)
	task.wait(2)
	Ui.say("The latch catches. You are home.", 4)
	task.wait(6)
	for _ = 1, 3 do
		Audio.at("Knock", door, { range = 60 })
		task.wait(0.8)
	end
	Ui.say("тук.   тук.   тук.", 3)
	task.wait(5)
	for _ = 1, 3 do
		Audio.at("Knock", door, { range = 60, volume = 3.5 })
		task.wait(0.6)
	end
	Ui.say("«Товарищ. Ты не сдал лампу.»\n\"Comrade. You did not return your lamp.\"", 6)
	task.wait(7)
	Ui.static(0.4, 0.6)
	local notes = player:GetAttribute("NoteCount") or 0
	Ui.toBlack(2, ("КОНЕЦ СМЕНЫ · END OF SHIFT\n\nYou survived day %d.\nNotes found: %d / %d\n\nThe alarm will ring at 05:50."):format(player:GetAttribute("Day") or 1, notes, #Config.Notes))
	task.wait(10)
end

Remotes.Fx.OnClientEvent:Connect(function(kind, a, b)
	if kind == "fade" then
		task.spawn(Ui.fade, a, b)
	elseif kind == "say" then
		Ui.say(a)
	elseif kind == "note" then
		local note = Config.Notes[a]
		if note then
			Ui.showNote(note)
			Audio.play("Click", { pitch = 1.2 })
		end
	elseif kind == "respawn" then
		frozen = false
		if not introPlaying then
			Ui.fadeIn(1.2)
		end
		Entity.reset()
		onStage()
	elseif kind == "ending" then
		task.spawn(ending)
	end
end)

-- Input.
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprintHeld = true
	end
	if processed then
		return
	end
	if Ui.noteOpen() and (input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Q) then
		Ui.hideNote()
	elseif input.KeyCode == Enum.KeyCode.F then
		setLamp(not lampOn)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprintHeld = false
	end
end)

-- Per-frame: lamp follows the camera, stamina, bob, shake.
RunService.RenderStepped:Connect(function(dt)
	local camera = workspace.CurrentCamera
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local range, brightness, angle = lampStats()
	local hasLamp = player:GetAttribute("HasLamp")
	lamp.CFrame = camera.CFrame * (hasLamp and CFrame.new(0, 0.4, 0) or CFrame.new(0.7, -0.6, 0))
	beam.Range = range
	beam.Angle = angle
	local level = brightness
	if flicker > 0 and math.random() < flicker * 0.6 then
		level = brightness * math.random() * 0.4
	end
	beam.Brightness = level
	-- The helmet lamp comes on by itself underground.
	if hasLamp and not lampOn and Ambience.region() == "underground" and not beam:GetAttribute("AutoDone") then
		beam:SetAttribute("AutoDone", true)
		setLamp(true)
	end

	if not humanoid then
		return
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	sprinting = sprintHeld and moving and not exhausted and not frozen
	if sprinting then
		stamina -= dt / Config.StaminaSeconds
		if stamina <= 0 then
			stamina = 0
			exhausted = true
		end
	else
		stamina = math.min(1, stamina + dt / Config.StaminaRegen)
		if exhausted and stamina > 0.35 then
			exhausted = false
		end
	end
	Ui.stamina(stamina)
	if frozen then
		humanoid.WalkSpeed = 0
	else
		humanoid.WalkSpeed = sprinting and Config.SprintSpeed or (exhausted and Config.WalkSpeed * 0.75 or Config.WalkSpeed)
	end

	local offset = Vector3.zero
	if moving and not frozen then
		bobT += dt * (sprinting and 13 or 8.5)
		local amp = sprinting and 0.22 or 0.11
		offset += Vector3.new(math.cos(bobT * 0.5) * amp * 0.6, math.abs(math.sin(bobT)) * amp, 0)
	end
	if os.clock() < shakeUntil then
		local s = shakeStrength * (shakeUntil - os.clock())
		offset += Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
	end
	humanoid.CameraOffset = humanoid.CameraOffset:Lerp(offset, math.min(dt * 12, 1))
end)

-- Reset the lamp auto-on flag when you leave the mine.
task.spawn(function()
	while true do
		task.wait(1)
		if Ambience.region() ~= "underground" then
			beam:SetAttribute("AutoDone", nil)
		end
	end
end)

-- Opening.
if not player.Character then
	player.CharacterAdded:Wait()
end
onStage()
Ui.setNotes(player:GetAttribute("NoteCount") or 0, #Config.Notes)
Ui.hint("F — flashlight · Shift — run · E — interact")
Ui.intro({
	"НОРИЛЬСК, КРАСНОЯРСКИЙ КРАЙ\nNorilsk, Krasnoyarsk Krai",
	"12 ДЕКАБРЯ 1984 · ПОЛЯРНАЯ НОЧЬ\n12 December 1984 · the polar night",
	"The sun will not rise for another five weeks.",
	"You are a miner at Mine No. 6.\nThe shift begins at 06:30.",
}, Config.Title, Config.TitleEnglish)
introPlaying = false
Ui.say("Five-fifty. The radiator is barely warm. Read Mother's letter, then go.", 6)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Entity</string><ProtectedString name="Source"><![CDATA[-- БРИГАДИР — "the Foreman". A tall, faceless figure in a greatcoat and ushanka, wearing
-- miner's lamp No. 117. It never runs. It walks your footsteps.
--
-- Rules the player can learn (the notes and night posters hint at them):
--   * While you look at it, it does not move.
--   * Stare too long and it is suddenly closer.
--   * Stand still and it closes the distance fast.
--   * Lights die when it passes.
--
-- Modes (from the stage's "threat"): glimpse, mineIdle, mineHunt, canteen, hunt, none.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Build = require(Shared.Build)
local Audio = require(script.Parent.Audio)
local Rig = require(script.Parent.Rig)

local Entity = {}

local E = Config.Entity
local rgb = Color3.fromRGB
local player = Players.LocalPlayer
local ctx
local model, rig, lampLight, lampPart, footsteps, torso, head
local mode = "none"
local visibleNow = false
local caught = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

-- State shared by the modes.
local pos = Vector3.zero -- feet
local stare = 0
local stillTime = 0
local heartTimer = 0

-- Night hunt: your trail.
local trail = { pts = {}, cum = {} }
local sEntity = 0
local huntActive = false
local doorFloorUsed = false

-- Underground.
local nodes, nodeNames, distM, nextM, edges = {}, {}, {}, {}, {}
local path = {}
local repathTimer = 0
local mineSpawnDelay = 0

-- Glimpses.
local glimpseTimer = 20
local glimpseLife = 0
local glimpseStare = 0
local showUntil = 0

local function build()
	local m = Instance.new("Model")
	m.Name = "Бригадир"
	local root = Build.detail(Build.block(m, "Root", Vector3.new(1, 1, 1), CFrame.new(), rgb(0, 0, 0)))
	root.Transparency = 1
	m.PrimaryPart = root
	local coat = rgb(16, 16, 18)
	local skin = rgb(168, 170, 164)
	local function part(name, size, at, color, material, group, shape)
		local p = Build.detail(Build.block(m, name, size, at, color, material or Enum.Material.Fabric))
		p.CastShadow = true
		if shape then
			p.Shape = shape
		end
		if group then
			p:SetAttribute("Group", group)
		end
		return p
	end
	-- Legs.
	for i, x in { -0.45, 0.45 } do
		local g = i == 1 and "LegL" or "LegR"
		m:SetAttribute("Joint_" .. g, CFrame.new(x, 5.2, 0))
		part("Leg", Vector3.new(0.5, 5.2, 0.5), CFrame.new(x, 2.6, 0), coat, nil, g)
		part("Boot", Vector3.new(0.65, 0.5, 1.2), CFrame.new(x, 0.25, -0.2), rgb(10, 10, 10), Enum.Material.Leather, g)
	end
	-- Greatcoat, too long, hunched shoulders.
	part("Coat skirt", Vector3.new(2.6, 3, 1.5), CFrame.new(0, 4.6, 0.05), coat)
	torso = part("Torso", Vector3.new(2.3, 3.4, 1.25), CFrame.new(0, 7.3, 0.1) * CFrame.Angles(-0.12, 0, 0), coat)
	part("Shoulders", Vector3.new(3.1, 0.8, 1.4), CFrame.new(0, 8.9, 0.25) * CFrame.Angles(-0.2, 0, 0), coat)
	part("Belt", Vector3.new(2.4, 0.3, 1.35), CFrame.new(0, 5.9, 0.05), rgb(30, 24, 20), Enum.Material.Leather)
	-- Neck and head lean forward, tilted.
	m:SetAttribute("Joint_Head", CFrame.new(0, 9.3, -0.1))
	part("Neck", Vector3.new(0.4, 1.4, 0.4), CFrame.new(0, 9.9, -0.35) * CFrame.Angles(-0.35, 0, 0), skin, Enum.Material.SmoothPlastic, "Head")
	head = part("Head", Vector3.new(1.15, 1.5, 1.1), CFrame.new(0, 10.9, -0.6) * CFrame.Angles(-0.1, 0, 0.18), skin, Enum.Material.SmoothPlastic, "Head")
	local face = head.CFrame
	for _, x in { -0.27, 0.27 } do
		part("Eye socket", Vector3.new(0.34, 0.26, 0.08), face * CFrame.new(x, 0.12, -0.54), rgb(0, 0, 0), Enum.Material.SmoothPlastic, "Head")
	end
	part("Mouth", Vector3.new(0.75, 0.16, 0.08), face * CFrame.new(0, -0.42, -0.54), rgb(0, 0, 0), Enum.Material.SmoothPlastic, "Head")
	part("Ushanka", Vector3.new(1.5, 0.7, 1.4), face * CFrame.new(0, 0.95, 0.05), rgb(28, 24, 20), Enum.Material.Fabric, "Head")
	part("Ushanka brim", Vector3.new(1.5, 0.35, 0.35), face * CFrame.new(0, 0.75, -0.65), rgb(28, 24, 20), Enum.Material.Fabric, "Head")
	for _, x in { -0.78, 0.78 } do
		part("Ear flap", Vector3.new(0.22, 0.9, 1), face * CFrame.new(x, 0.25, 0.05), rgb(28, 24, 20), Enum.Material.Fabric, "Head")
	end
	-- Lamp No. 117.
	lampPart = part("Lamp 117", Vector3.new(0.5, 0.42, 0.22), face * CFrame.new(0, 0.9, -0.78), rgb(255, 190, 110), Enum.Material.Neon, "Head")
	lampLight = Instance.new("PointLight")
	lampLight.Color = rgb(255, 170, 90)
	lampLight.Range = 11
	lampLight.Brightness = 0.7
	lampLight.Parent = lampPart
	-- Arms that hang past the knees, long fingers.
	for i, x in { -1.55, 1.55 } do
		local g = i == 1 and "ArmL" or "ArmR"
		local shoulder = CFrame.new(x, 8.8, 0.1)
		m:SetAttribute("Joint_" .. g, shoulder)
		part("Arm", Vector3.new(0.42, 6.4, 0.45), shoulder * CFrame.new(0, -3.1, 0), coat, nil, g)
		part("Hand", Vector3.new(0.45, 0.7, 0.28), shoulder * CFrame.new(0, -6.6, 0), skin, Enum.Material.SmoothPlastic, g)
		for f = -1, 1 do
			part("Finger", Vector3.new(0.08, 1.3, 0.08), shoulder * CFrame.new(f * 0.14, -7.6, -0.05) * CFrame.Angles(0.15, 0, f * 0.08), skin, Enum.Material.SmoothPlastic, g)
		end
	end
	footsteps = Audio.make("Footsteps", torso, { range = 90 })
	return m
end

local function ground()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return nil, nil
	end
	local offset = humanoid.RigType == Enum.HumanoidRigType.R6 and 3 or humanoid.HipHeight + root.Size.Y / 2
	return root.Position - Vector3.new(0, offset, 0), humanoid
end

local function show(on)
	visibleNow = on
	model.Parent = on and workspace or nil
	if not on then
		footsteps:Stop()
	end
end

local function place(feet, faceTo, t, walking)
	local flat = Vector3.new(faceTo.X, feet.Y, faceTo.Z)
	if (flat - feet).Magnitude < 0.05 then
		flat = feet + Vector3.new(0, 0, -1)
	end
	local sway = walking and math.sin(t * 4) * 0.05 or 0
	local pivot = CFrame.lookAt(feet, flat) * CFrame.Angles(0, 0, sway)
	local stride = walking and math.sin(t * 4) or 0
	local twitch = (math.noise(t * 1.3, 7) > 0.45) and (math.random() - 0.5) * 0.5 or 0
	rig:pose(pivot, {
		LegL = CFrame.Angles(stride * 0.35, 0, 0),
		LegR = CFrame.Angles(-stride * 0.35, 0, 0),
		ArmL = CFrame.Angles(-stride * 0.12 + 0.05, 0, 0.04),
		ArmR = CFrame.Angles(stride * 0.12 + 0.05, 0, -0.04),
		Head = CFrame.Angles(0, twitch, math.sin(t * 0.7) * 0.08),
	})
end

-- Is the player looking at it, with a clear line of sight?
local function seen(maxDistance)
	local camera = workspace.CurrentCamera
	local camPos = camera.CFrame.Position
	local filter = { model }
	if player.Character then
		table.insert(filter, player.Character)
	end
	rayParams.FilterDescendantsInstances = filter
	for _, p in { head, torso } do
		local to = p.Position - camPos
		local d = to.Magnitude
		if d < maxDistance and d > 0.1 and camera.CFrame.LookVector:Dot(to / d) > E.ViewDot then
			if not workspace:Raycast(camPos, to, rayParams) then
				return true
			end
		end
	end
	return false
end

-- Trail ------------------------------------------------------------------------------------

local function trailReset(start)
	trail.pts = { start }
	trail.cum = { 0 }
end

local function trailAdd(p)
	local pts = trail.pts
	local last = pts[#pts]
	local d = (p - last).Magnitude
	if d >= 1.5 then
		table.insert(pts, p)
		table.insert(trail.cum, trail.cum[#trail.cum] + d)
	end
end

local function trailLength(current)
	local pts = trail.pts
	return trail.cum[#trail.cum] + (current - pts[#pts]).Magnitude
end

local function trailAt(s, current)
	local pts, cum = trail.pts, trail.cum
	if s <= 0 then
		return pts[1], pts[2] or current
	end
	if s >= cum[#cum] then
		local last = pts[#pts]
		local remain = (current - last).Magnitude
		local t = remain > 0 and math.clamp((s - cum[#cum]) / remain, 0, 1) or 1
		return last:Lerp(current, t), current
	end
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local t = (s - cum[lo]) / math.max(cum[hi] - cum[lo], 0.001)
	return pts[lo]:Lerp(pts[hi], t), pts[hi]
end

-- Mine graph -------------------------------------------------------------------------------

local function setupGraph()
	local O = Config.Places.Underground
	for name, p in Config.MineNodes do
		nodes[name] = O + p
		table.insert(nodeNames, name)
	end
	for _, a in nodeNames do
		distM[a], nextM[a] = {}, {}
		for _, b in nodeNames do
			distM[a][b] = a == b and 0 or math.huge
		end
	end
	for _, e in Config.MineEdges do
		local a, b = e[1], e[2]
		local d = (nodes[a] - nodes[b]).Magnitude
		distM[a][b], distM[b][a] = d, d
		nextM[a][b], nextM[b][a] = b, a
		table.insert(edges, { a, b })
	end
	for _, k in nodeNames do
		for _, i in nodeNames do
			for _, j in nodeNames do
				if distM[i][k] + distM[k][j] < distM[i][j] then
					distM[i][j] = distM[i][k] + distM[k][j]
					nextM[i][j] = nextM[i][k]
				end
			end
		end
	end
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function closestEdge(p)
	local best, bestD = nil, math.huge
	for _, e in edges do
		local a, b = flat(nodes[e[1]]), flat(nodes[e[2]])
		local ab = b - a
		local t = math.clamp((flat(p) - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local d = (flat(p) - (a + ab * t)).Magnitude
		if d < bestD then
			best, bestD = e, d
		end
	end
	return best
end

local function repath(target)
	local ee, pe = closestEdge(pos), closestEdge(target)
	if ee == pe then
		path = { target }
		return
	end
	local bestCost, bestA, bestB = math.huge, nil, nil
	for _, a in ee do
		for _, b in pe do
			local cost = (pos - nodes[a]).Magnitude + distM[a][b] + (nodes[b] - target).Magnitude
			if cost < bestCost then
				bestCost, bestA, bestB = cost, a, b
			end
		end
	end
	path = {}
	local cur = bestA
	table.insert(path, nodes[cur])
	while cur ~= bestB do
		cur = nextM[cur][bestB]
		table.insert(path, nodes[cur])
	end
	table.insert(path, target)
end

local function walkPath(distance)
	while distance > 0 and #path > 0 do
		local target = Vector3.new(path[1].X, pos.Y, path[1].Z)
		local to = target - pos
		local d = to.Magnitude
		if d <= distance then
			pos = target
			distance -= d
			table.remove(path, 1)
		else
			pos += to.Unit * distance
			distance = 0
		end
	end
end

local function spawnInLair(playerPos)
	local best, bestD = nil, -1
	for _, name in Config.MineLairs do
		local d = (nodes[name] - playerPos).Magnitude
		if d > bestD then
			best, bestD = name, d
		end
	end
	pos = nodes[best]
	path = {}
	repathTimer = 0
end

-- Jumpscare ------------------------------------------------------------------------------------

local function catch()
	if caught then
		return
	end
	caught = true
	show(true)
	local camera = workspace.CurrentCamera
	local camCF = camera.CFrame
	local look = flat(camCF.LookVector)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local feet = camCF.Position + look * 2.3 - Vector3.new(0, 10.6, 0)
	rig:pose(CFrame.lookAt(feet, feet - look), { Head = CFrame.Angles(0.25, 0, 0.3), ArmL = CFrame.Angles(1.3, 0, 0.3), ArmR = CFrame.Angles(1.3, 0, -0.3) })
	lampLight.Brightness = 4
	lampLight.Range = 16
	Audio.play("Scream")
	Audio.play("ScreamLow")
	ctx.Ui.redFlash()
	ctx.Ui.static(0.8, 0.8)
	ctx.shake(1, 0.7)
	ctx.freeze(true)
	task.delay(0.85, function()
		show(false)
		lampLight.Brightness = 0.7
		lampLight.Range = 11
		ctx.Ui.missing()
		ctx.flashlightFlicker(0)
		ReplicatedStorage.Remotes.Caught:FireServer()
	end)
end

-- Modes ------------------------------------------------------------------------------------

local function heartbeatFor(distance, dt)
	if distance > 45 then
		return
	end
	heartTimer -= dt
	if heartTimer <= 0 then
		heartTimer = math.clamp(distance / 30, 0.35, 1.4)
		Audio.play("Heartbeat", { volume = math.clamp(1.4 - distance / 40, 0.2, 1.2) })
	end
end

local function stepHunt(dt, feet, humanoid, t)
	local walking = humanoid.MoveDirection.Magnitude > 0.1
	stillTime = walking and 0 or stillTime + dt
	trailAdd(feet)
	local sPlayer = trailLength(feet)
	if not huntActive then
		if (feet - Config.Places.CanteenDoor).Magnitude > E.StartDelay then
			huntActive = true
			sEntity = 0
			Audio.at("Groan", Config.Places.CanteenDoor + Vector3.new(0, 5, 0), { range = 160 })
			ctx.Ui.say("Behind you, the canteen door bangs open. Then nothing. Then footsteps.", 6)
		else
			return
		end
	end
	local observed = visibleNow and seen(130)
	if observed then
		stare += dt
	else
		stare = math.max(0, stare - dt * 0.5)
	end
	local speed = observed and 0 or (stillTime > 1.5 and E.StillSpeed or E.Speed)
	sEntity += speed * dt
	if stare > E.StareLimit then
		stare = 0
		sEntity += E.BlinkJump
		ctx.Ui.static(0.25, 0.7)
		Audio.play("Sting")
	end
	if sPlayer - sEntity > E.MaxLag then
		sEntity = sPlayer - E.MaxLag
	end
	if not doorFloorUsed and (feet - Config.Places.HomeDoor).Magnitude < 16 then
		doorFloorUsed = true
		if sPlayer - sEntity < E.DoorFloor then
			sEntity = sPlayer - E.DoorFloor
		end
	end
	local behind = sPlayer - sEntity
	local p = trailAt(sEntity, feet)
	pos = p
	show(true)
	place(pos, feet, t, speed > 0)
	if speed > 0 and not footsteps.IsPlaying then
		footsteps:Play()
	elseif speed == 0 and footsteps.IsPlaying then
		footsteps:Stop()
	end
	ctx.Ambience.killLightsNear(pos, 15, 30)
	local real = (pos - feet).Magnitude
	heartbeatFor(math.min(behind, real), dt)
	ctx.flashlightFlicker(real < 32 and (1 - real / 32) or 0)
	if real < E.CatchDistance or behind < E.CatchDistance then
		catch()
	end
end

local function stepMine(dt, feet, humanoid, t)
	if mineSpawnDelay > 0 then
		mineSpawnDelay -= dt
		if mineSpawnDelay <= 0 then
			spawnInLair(feet)
			show(true)
			Audio.at("Groan", pos + Vector3.new(0, 6, 0), { range = 200 })
		end
		return
	end
	local walking = humanoid.MoveDirection.Magnitude > 0.1
	stillTime = walking and 0 or stillTime + dt
	local observed = seen(95)
	if observed then
		stare += dt
	else
		stare = math.max(0, stare - dt * 0.5)
	end
	repathTimer -= dt
	if repathTimer <= 0 then
		repathTimer = 0.3
		repath(feet)
	end
	local speed = observed and 0 or (stillTime > 1.5 and E.MineSpeed * 1.8 or E.MineSpeed)
	walkPath(speed * dt)
	if stare > E.StareLimit then
		stare = 0
		walkPath(E.BlinkJump * 0.8)
		ctx.Ui.static(0.25, 0.7)
		Audio.play("Sting")
	end
	pos = Vector3.new(pos.X, Config.Places.Underground.Y, pos.Z)
	place(pos, feet, t, speed > 0)
	if speed > 0 and not footsteps.IsPlaying then
		footsteps:Play()
	elseif speed == 0 and footsteps.IsPlaying then
		footsteps:Stop()
	end
	local real = (flat(pos) - flat(feet)).Magnitude
	heartbeatFor(real, dt)
	ctx.flashlightFlicker(real < 30 and (1 - real / 30) or 0)
	if real < E.CatchDistance then
		catch()
	end
end

local GROUND = { Snow = true, Road = true, Sidewalk = true, Rut = true, Path = true, Yard = true, Plaza = true }

local function tryGlimpse(feet)
	local camera = workspace.CurrentCamera
	local look = flat(camera.CFrame.LookVector)
	if look.Magnitude < 0.1 then
		return false
	end
	look = look.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, model }
	for _ = 1, 10 do
		local yaw = math.rad(math.random(-40, 40))
		local dir = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(look)
		local p = feet + dir * math.random(65, 100)
		local hit = workspace:Raycast(Vector3.new(p.X, 200, p.Z), Vector3.new(0, -260, 0), params)
		if hit and GROUND[hit.Instance.Name] then
			pos = hit.Position
			glimpseLife = 14
			glimpseStare = 0
			show(true)
			return true
		end
	end
	return false
end

local function stepGlimpse(dt, feet, t)
	if visibleNow then
		place(pos, feet, t, false)
		if seen(140) then
			glimpseStare += dt
		end
		glimpseLife -= dt
		local d = (flat(pos) - flat(feet)).Magnitude
		if d < E.GlimpseVanishDistance or glimpseStare > E.GlimpseVanishStare or glimpseLife <= 0 then
			if glimpseStare > 0.2 or d < E.GlimpseVanishDistance then
				ctx.Ui.static(0.12, 0.4)
				Audio.play("Sting", { volume = 0.5 })
			end
			show(false)
			glimpseTimer = math.random(E.GlimpseEvery[1], E.GlimpseEvery[2])
		end
		return
	end
	if ctx.Ambience.region() ~= "outdoor" then
		return
	end
	glimpseTimer -= dt
	if glimpseTimer <= 0 then
		if not tryGlimpse(feet) then
			glimpseTimer = 5
		end
	end
end

local idleTimer = 25
local function stepMineIdle(dt, feet)
	idleTimer -= dt
	if idleTimer <= 0 then
		idleTimer = math.random(25, 45)
		-- Distant footsteps somewhere in the dark, then silence.
		local far, farD = nil, 0
		for _, name in nodeNames do
			local d = (nodes[name] - feet).Magnitude
			if d > farD and d < 140 then
				far, farD = nodes[name], d
			end
		end
		if far then
			local s = Audio.at("Footsteps", far + Vector3.new(0, 4, 0), { range = 160, life = 4 })
			task.delay(2.5, function()
				s:Stop()
			end)
		end
	end
	if math.random() < dt * 0.2 then
		Audio.play("Drip", { pitch = 2 + math.random() })
	end
end

local function update(dt)
	if caught then
		return
	end
	local feet, humanoid = ground()
	if not feet then
		return
	end
	local t = os.clock()
	if os.clock() < showUntil then
		place(pos, feet, t, false)
		if seen(80) then
			glimpseStare += dt
			if glimpseStare > 1.5 then
				showUntil = 0
				show(false)
				Audio.play("Sting", { volume = 0.6 })
			end
		end
		return
	elseif showUntil > 0 then
		showUntil = 0
		show(false)
	end
	if mode == "hunt" then
		stepHunt(dt, feet, humanoid, t)
	elseif mode == "mineHunt" then
		stepMine(dt, feet, humanoid, t)
	elseif mode == "glimpse" then
		stepGlimpse(dt, feet, t)
	elseif mode == "mineIdle" then
		stepMineIdle(dt, feet)
	end
end

function Entity.init(context)
	ctx = context
	model = build()
	rig = Rig.new(model)
	setupGraph()
	RunService.Heartbeat:Connect(update)
end

-- Called on every stage change and after respawning.
function Entity.reset(newMode)
	mode = newMode or mode
	caught = false
	show(false)
	stare = 0
	stillTime = 0
	path = {}
	huntActive = false
	doorFloorUsed = false
	showUntil = 0
	ctx.flashlightFlicker(0)
	ctx.Ambience.restoreAllLights()
	local feet = ground()
	if mode == "hunt" then
		trailReset(feet or Config.Places.CanteenDoor)
	elseif mode == "mineHunt" then
		mineSpawnDelay = 5
	elseif mode == "glimpse" then
		glimpseTimer = math.random(12, 25)
	end
end

function Entity.setMode(newMode)
	if newMode ~= mode then
		Entity.reset(newMode)
	end
end

-- Stand somewhere for a while (the canteen window). Vanishes if stared at.
function Entity.showAt(cf, duration)
	pos = cf.Position
	glimpseStare = 0
	showUntil = os.clock() + duration
	show(true)
end

function Entity.isCaught()
	return caught
end

return Entity
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">People</string><ProtectedString name="Source"><![CDATA[-- Everyone who isn't you: diners, staff and miners (built by the server, animated here),
-- and coworkers walking to and from the mine (spawned locally). Nobody is out at night.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Figure = require(Shared.Figure)
local Rig = require(script.Parent.Rig)

local People = {}

local staged = {}
local walkers = {}
local stage = 1
local staring = false
local folder

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- 0..1 envelope: rise, hold, fall, then rest for the remainder of the cycle.
local function lift(u, up, hold, down)
	if u < up then
		return smooth(u / up)
	elseif u < up + hold then
		return 1
	elseif u < up + hold + down then
		return 1 - smooth((u - up - hold) / down)
	end
	return 0
end

local function actionAngles(entry, t)
	local model = entry.model
	local action = entry.action
	local restR = model:GetAttribute("Rest_ArmR") or 0
	local a = {}
	t += entry.phase
	if action == "eat" then
		local k = lift((t % 4.6) / 4.6, 0.13, 0.1, 0.13)
		a.ArmR = CFrame.Angles(math.rad(128) - restR, 0, 0):Lerp(CFrame.identity, 1 - k)
		a.Head = CFrame.Angles(-0.25 + 0.15 * k, 0, 0)
	elseif action == "drink" then
		local k = lift((t % 7.5) / 7.5, 0.12, 0.2, 0.12)
		a.ArmR = CFrame.Angles(math.rad(150) - restR, 0, 0):Lerp(CFrame.identity, 1 - k)
		a.Head = CFrame.Angles(-0.1 + 0.35 * k, 0, 0)
	elseif action == "smoke" then
		local k = lift((t % 6.5) / 6.5, 0.15, 0.15, 0.15)
		a.ArmR = CFrame.Angles(math.rad(140) - restR, 0, 0):Lerp(CFrame.identity, 1 - k)
		a.Head = CFrame.Angles(0.1 * k, math.sin(t * 0.3) * 0.3, 0)
	elseif action == "read" then
		a.Head = CFrame.Angles(-0.35 + math.sin(t * 0.7) * 0.03, math.sin(t * 0.2) * 0.1, 0)
		a.ArmL = CFrame.Angles(0.15 * lift((t % 9) / 9, 0.05, 0.05, 0.05), 0, 0)
	elseif action == "stir" then
		a.ArmR = CFrame.Angles(math.sin(t * 3) * 0.3, 0, math.cos(t * 3) * 0.25)
		a.Head = CFrame.Angles(-0.35, 0, 0)
	elseif action == "dig" then
		local u = (t % 1.7) / 1.7
		local swing = u < 0.6 and smooth(u / 0.6) or 1 - smooth((u - 0.6) / 0.4)
		local delta = math.rad(70) * swing - math.rad(40)
		a.ArmR = CFrame.Angles(delta, 0, 0)
		a.ArmL = CFrame.Angles(delta, 0, 0)
		a.Head = CFrame.Angles(-0.2, 0, 0)
	elseif action == "walk" then
		local s = math.sin(t * entry.stride)
		a.LegL = CFrame.Angles(s * 0.45, 0, 0)
		a.LegR = CFrame.Angles(-s * 0.45, 0, 0)
		a.ArmL = CFrame.Angles(-s * 0.3, 0, 0)
		a.ArmR = CFrame.Angles(s * 0.3, 0, 0)
		a.Head = CFrame.Angles(-0.12, 0, 0)
	else
		a.Head = CFrame.Angles(math.sin(t * 0.17) * 0.06, math.sin(t * 0.23) * 0.5, 0)
	end
	return a
end

local function addStaged(model)
	if not model:IsA("Model") then
		return
	end
	local entry = {
		model = model,
		rig = Rig.new(model),
		action = model:GetAttribute("Action") or "idle",
		from = model:GetAttribute("ShowFrom") or 1,
		to = model:GetAttribute("ShowTo") or 99,
		phase = (model:GetAttribute("Seed") or 0) % 100 / 7,
	}
	entry.base = entry.rig.pivot
	table.insert(staged, entry)
	entry.rig:setVisible(stage >= entry.from and stage <= entry.to)
end

local function routeLength(route)
	local total, cum = 0, { 0 }
	for i = 2, #route do
		total += (route[i] - route[i - 1]).Magnitude
		cum[i] = total
	end
	return total, cum
end

local function placeWalker(w, initial)
	local group = w.group
	w.route = group.routes[math.random(1, #group.routes)]
	w.total, w.cum = routeLength(w.route)
	w.s = initial and math.random() * w.total * 0.85 or 0
	w.offset = (math.random() - 0.5) * 3
	w.speed = 5 + math.random() * 2
end

local HATS = { "ushanka", "ushanka", "ushanka", "kerchief", "cap", "helmet" }

local function spawnWalker(group, initial)
	local model = Figure.build(folder, CFrame.new(0, -500, 0), {
		hat = HATS[math.random(1, #HATS)],
		armR = 5,
		armL = 5,
		seed = math.random(1, 1e6),
		name = "Coworker",
	})
	local w = {
		group = group,
		model = model,
		rig = Rig.new(model),
		action = "walk",
		phase = math.random() * 10,
		speed = 6,
		stride = 6,
		route = {},
		total = 0,
		cum = {},
		s = 0,
		offset = 0,
	}
	placeWalker(w, initial)
	w.stride = w.speed * 0.95
	table.insert(walkers, w)
end

local function syncWalkers()
	for _, group in Config.Walkers do
		local active = table.find(group.stages, stage) ~= nil
		local count = 0
		for i = #walkers, 1, -1 do
			local w = walkers[i]
			if w.group == group then
				if active then
					count += 1
				else
					w.model:Destroy()
					table.remove(walkers, i)
				end
			end
		end
		if active then
			for _ = count + 1, group.count do
				spawnWalker(group, true)
			end
		end
	end
end

local function positionOn(w)
	local route, cum = w.route, w.cum
	for i = 2, #route do
		if w.s <= cum[i] then
			local a, b = route[i - 1], route[i]
			local t = (w.s - cum[i - 1]) / math.max(cum[i] - cum[i - 1], 0.01)
			local dir = (b - a).Unit
			local side = Vector3.new(-dir.Z, 0, dir.X)
			return a:Lerp(b, t) + side * w.offset, dir
		end
	end
	local last = route[#route]
	return last, (last - route[#route - 1]).Unit
end

local accumulator = 0
local function update(dt)
	accumulator += dt
	if accumulator < 1 / 30 then
		return
	end
	local step = accumulator
	accumulator = 0
	local camera = workspace.CurrentCamera
	local camPos = camera.CFrame.Position
	local t = os.clock()

	for _, e in staged do
		local visible = stage >= e.from and stage <= e.to
		e.rig:setVisible(visible)
		if visible and (e.base.Position - camPos).Magnitude < 110 then
			local angles = actionAngles(e, t)
			if staring and (e.base.Position - camPos).Magnitude < 60 then
				angles = { Head = e.rig:lookAngles(camPos) }
			end
			e.rig:pose(e.base, angles)
		end
	end

	for _, w in walkers do
		w.s += w.speed * step
		if w.s >= w.total then
			placeWalker(w, false)
		end
		local pos, dir = positionOn(w)
		local pivot = CFrame.lookAt(pos + Vector3.new(0, 0.25, 0), pos + Vector3.new(0, 0.25, 0) + dir)
		if (pos - camPos).Magnitude < 160 then
			w.rig:pose(pivot, actionAngles(w, t))
		else
			w.rig:pose(pivot, {})
		end
	end
end

function People.init()
	folder = Instance.new("Folder")
	folder.Name = "Townsfolk (local)"
	folder.Parent = workspace
	for _, m in CollectionService:GetTagged("StagedPerson") do
		addStaged(m)
	end
	CollectionService:GetInstanceAddedSignal("StagedPerson"):Connect(addStaged)
	RunService.Heartbeat:Connect(update)
end

function People.onStage(s)
	stage = s
	syncWalkers()
end

-- Everyone in the room turns to look at you.
function People.stare(on)
	staring = on
end

function People.folder()
	return folder
end

return People
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[-- Poses part-built people (shared/Figure.luau) by rotating limb groups around their joints.

local Rig = {}
Rig.__index = Rig

function Rig.new(model)
	local self = setmetatable({}, Rig)
	self.model = model
	self.pivot = model:GetPivot()
	self.free = {}
	self.groups = {}
	self.parts = {}
	for _, p in model:GetDescendants() do
		if not p:IsA("BasePart") then
			continue
		end
		table.insert(self.parts, { part = p, transparency = p.Transparency })
		local rel = self.pivot:ToObjectSpace(p.CFrame)
		local g = p:GetAttribute("Group")
		local joint = g and model:GetAttribute("Joint_" .. g)
		if joint then
			local group = self.groups[g]
			if not group then
				group = { joint = joint, parts = {} }
				self.groups[g] = group
			end
			table.insert(group.parts, { part = p, rel = joint:ToObjectSpace(rel) })
		else
			table.insert(self.free, { part = p, rel = rel })
		end
	end
	return self
end

-- angles: { GroupName = CFrame rotation applied at the joint }.
function Rig:pose(pivot, angles)
	self.pivot = pivot
	for _, e in self.free do
		e.part.CFrame = pivot * e.rel
	end
	for name, g in self.groups do
		local j = pivot * g.joint * (angles[name] or CFrame.identity)
		for _, e in g.parts do
			e.part.CFrame = j * e.rel
		end
	end
end

function Rig:setVisible(visible)
	if self.visible == visible then
		return
	end
	self.visible = visible
	for _, e in self.parts do
		e.part.Transparency = visible and e.transparency or 1
	end
end

-- Head rotation that makes the person look at a world point.
function Rig:lookAngles(worldPoint)
	local head = self.groups.Head
	if not head then
		return CFrame.identity
	end
	local local_ = (self.pivot * head.joint):PointToObjectSpace(worldPoint)
	local yaw = math.clamp(math.atan2(-local_.X, -local_.Z), -1.7, 1.7)
	local flat = math.sqrt(local_.X * local_.X + local_.Z * local_.Z)
	local pitch = math.clamp(math.atan2(local_.Y, flat), -0.6, 0.6)
	return CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

return Rig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Ui</string><ProtectedString name="Source"><![CDATA[-- On-screen interface: objective, clock, subtitles, fades, notes, stamina and effects.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Ui = {}

local rgb = Color3.fromRGB
local PAPER = rgb(226, 218, 194)
local INK = rgb(214, 208, 190)

local gui
local objectiveRu, objectiveEn, clockLabel, notesLabel, sayLabel, hintLabel
local fadeFrame, fadeText, flashFrame, staticFrame
local noteFrame, noteTitle, noteBody
local staminaBack, staminaFill
local sayToken = 0

local function make(class, props, parent)
	local inst = Instance.new(class)
	for k, v in props do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function text(parent, props)
	local base = {
		BackgroundTransparency = 1,
		TextColor3 = INK,
		Font = Enum.Font.Code,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
	}
	for k, v in props do
		base[k] = v
	end
	local label = make("TextLabel", base, parent)
	make("UIStroke", { Thickness = 1, Transparency = 0.55, Color = rgb(0, 0, 0) }, label)
	return label
end

local function tween(inst, time, goal, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Sine), goal)
	t:Play()
	return t
end

function Ui.init()
	local player = Players.LocalPlayer
	gui = make("ScreenGui", { Name = "LastShift", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5 }, player:WaitForChild("PlayerGui"))

	-- Vignette: dark edges.
	for _, side in { { 0, 0.5, 0.5, 1, 0 }, { 1, 0.5, 0.5, 1, 180 }, { 0.5, 0, 1, 0.5, 90 }, { 0.5, 1, 1, 0.5, 270 } } do
		local f = make("Frame", {
			AnchorPoint = Vector2.new(side[1], side[2]),
			Position = UDim2.fromScale(side[1], side[2]),
			Size = UDim2.fromScale(side[3], side[4]),
			BackgroundColor3 = rgb(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 1,
		}, gui)
		make("UIGradient", {
			Rotation = side[5],
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(0.45, 0.85),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, f)
	end

	clockLabel = text(gui, { Position = UDim2.new(0, 28, 0, 28), Size = UDim2.new(0, 520, 0, 22), TextSize = 16, TextTransparency = 0.15, ZIndex = 3 })
	objectiveRu = text(gui, { Position = UDim2.new(0, 28, 0, 54), Size = UDim2.new(0.6, 0, 0, 30), TextSize = 24, Font = Enum.Font.Oswald, ZIndex = 3 })
	objectiveEn = text(gui, { Position = UDim2.new(0, 28, 0, 86), Size = UDim2.new(0.5, 0, 0, 44), TextSize = 16, TextTransparency = 0.2, ZIndex = 3 })
	notesLabel = text(gui, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -28, 0, 28), Size = UDim2.new(0, 260, 0, 22), TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, TextTransparency = 0.3, ZIndex = 3 })
	sayLabel = text(gui, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.new(0.62, 0, 0, 64),
		TextSize = 19,
		Font = Enum.Font.Merriweather,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextTransparency = 1,
		ZIndex = 4,
	})
	hintLabel = text(gui, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 28, 1, -24), Size = UDim2.new(0, 520, 0, 20), TextSize = 14, TextTransparency = 0.45, ZIndex = 3 })

	staminaBack = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40), Size = UDim2.new(0, 220, 0, 4), BackgroundColor3 = rgb(0, 0, 0), BackgroundTransparency = 0.6, BorderSizePixel = 0, Visible = false, ZIndex = 3 }, gui)
	staminaFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = INK, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 3 }, staminaBack)

	flashFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(140, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 8 }, gui)
	staticFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 9, Visible = false }, gui)
	for _ = 1, 40 do
		make("Frame", { BackgroundColor3 = rgb(230, 230, 230), BorderSizePixel = 0, BackgroundTransparency = 0.5, ZIndex = 9 }, staticFrame)
	end

	fadeFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(0, 0, 0), BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = 10 }, gui)
	fadeText = text(fadeFrame, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.7, 0, 0.6, 0),
		TextSize = 24,
		Font = Enum.Font.Merriweather,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTransparency = 1,
		ZIndex = 11,
	})

	noteFrame = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 520, 0, 560), BackgroundColor3 = PAPER, BorderSizePixel = 0, Visible = false, ZIndex = 12, Rotation = -1.5 }, gui)
	make("UIPadding", { PaddingLeft = UDim.new(0, 30), PaddingRight = UDim.new(0, 30), PaddingTop = UDim.new(0, 26), PaddingBottom = UDim.new(0, 26) }, noteFrame)
	make("UISizeConstraint", { MaxSize = Vector2.new(520, 560) }, noteFrame)
	noteTitle = make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Font = Enum.Font.Oswald, TextSize = 22, TextColor3 = rgb(120, 24, 20), TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = 13 }, noteFrame)
	noteBody = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 1, -80), Font = Enum.Font.SpecialElite, TextSize = 17, TextColor3 = rgb(40, 34, 28), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, ZIndex = 13 }, noteFrame)
	make("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.Code, TextSize = 14, TextColor3 = rgb(110, 100, 86), Text = "[E] / [Esc] / click — put it away", TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 13 }, noteFrame)
	local closer = make("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 14 }, noteFrame)
	closer.Activated:Connect(function()
		Ui.hideNote()
	end)
end

function Ui.setObjective(ru, en)
	objectiveRu.Text = ru or ""
	objectiveEn.Text = en or ""
	objectiveRu.TextTransparency = 1
	objectiveEn.TextTransparency = 1
	tween(objectiveRu, 1.2, { TextTransparency = 0 })
	tween(objectiveEn, 1.6, { TextTransparency = 0.2 })
end

function Ui.setClock(s)
	clockLabel.Text = s
end

function Ui.setNotes(n, total)
	notesLabel.Text = n > 0 and ("ЗАПИСКИ · NOTES  %d / %d"):format(n, total) or ""
end

function Ui.hint(s)
	hintLabel.Text = s or ""
end

-- A line of subtitle / thought at the bottom of the screen.
function Ui.say(s, duration)
	sayToken += 1
	local token = sayToken
	sayLabel.Text = s
	tween(sayLabel, 0.4, { TextTransparency = 0 })
	task.delay(duration or math.clamp(#s / 14, 3, 9), function()
		if token == sayToken then
			tween(sayLabel, 1, { TextTransparency = 1 })
		end
	end)
end

function Ui.stamina(frac)
	staminaBack.Visible = frac < 0.995
	staminaFill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
	staminaFill.BackgroundColor3 = frac < 0.25 and rgb(170, 60, 50) or INK
end

-- Fade to black, show text, hold, fade back. Yields until fully back.
function Ui.fade(s, hold)
	fadeText.Text = s or ""
	tween(fadeFrame, 0.8, { BackgroundTransparency = 0 }).Completed:Wait()
	if s and s ~= "" then
		tween(fadeText, 0.6, { TextTransparency = 0 })
	end
	task.wait(hold or 2)
	tween(fadeText, 0.6, { TextTransparency = 1 })
	task.wait(0.3)
	tween(fadeFrame, 1.2, { BackgroundTransparency = 1 }).Completed:Wait()
end

function Ui.black(s)
	fadeText.Text = s or ""
	fadeFrame.BackgroundTransparency = 0
	fadeText.TextTransparency = (s and s ~= "") and 0 or 1
end

function Ui.toBlack(time, s)
	fadeText.Text = s or ""
	fadeText.TextTransparency = 1
	tween(fadeFrame, time or 1, { BackgroundTransparency = 0 }).Completed:Wait()
	if s and s ~= "" then
		tween(fadeText, 0.8, { TextTransparency = 0 })
	end
end

function Ui.fadeIn(time)
	tween(fadeText, 0.5, { TextTransparency = 1 })
	tween(fadeFrame, time or 1.2, { BackgroundTransparency = 1 })
end

function Ui.redFlash()
	flashFrame.BackgroundTransparency = 0.2
	tween(flashFrame, 0.9, { BackgroundTransparency = 1 })
end

-- TV static bursts.
function Ui.static(duration, strength)
	strength = strength or 0.5
	staticFrame.Visible = true
	local stop = os.clock() + (duration or 0.2)
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if os.clock() > stop then
			staticFrame.Visible = false
			conn:Disconnect()
			return
		end
		for _, line in staticFrame:GetChildren() do
			line.Position = UDim2.fromScale(math.random(), math.random())
			line.Size = UDim2.new(math.random() * 0.6, 0, 0, math.random(1, 6))
			line.BackgroundTransparency = 1 - strength * math.random()
		end
	end)
end

function Ui.showNote(note)
	noteTitle.Text = note.title
	noteBody.Text = note.text
	noteFrame.Visible = true
end

function Ui.hideNote()
	noteFrame.Visible = false
end

function Ui.noteOpen()
	return noteFrame.Visible
end

function Ui.missing()
	Ui.black("")
	fadeText.Font = Enum.Font.Oswald
	fadeText.TextColor3 = rgb(180, 30, 26)
	fadeText.Text = "ПРОПАЛ БЕЗ ВЕСТИ\nMISSING"
	fadeText.TextTransparency = 1
	tween(fadeText, 1, { TextTransparency = 0 })
	task.delay(2.5, function()
		fadeText.Font = Enum.Font.Merriweather
		fadeText.TextColor3 = INK
	end)
end

-- Opening titles. Yields.
function Ui.intro(lines, title, subtitle)
	Ui.black("")
	task.wait(1)
	for _, line in lines do
		fadeText.Text = line
		tween(fadeText, 1, { TextTransparency = 0 }).Completed:Wait()
		task.wait(1.8)
		tween(fadeText, 0.8, { TextTransparency = 1 }).Completed:Wait()
	end
	fadeText.Font = Enum.Font.Oswald
	fadeText.TextSize = 40
	fadeText.TextColor3 = rgb(200, 40, 32)
	fadeText.Text = title .. "\n" .. subtitle
	tween(fadeText, 1.5, { TextTransparency = 0 }).Completed:Wait()
	task.wait(2.5)
	tween(fadeText, 1, { TextTransparency = 1 }).Completed:Wait()
	fadeText.Font = Enum.Font.Merriweather
	fadeText.TextSize = 24
	fadeText.TextColor3 = INK
	Ui.fadeIn(2)
end

return Ui
]]></ProtectedString></Properties></Item></Item><Item class="StarterCharacterScripts" referent="RBX00000015"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item></Item></roblox>
